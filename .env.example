# Konfiguration der Notenverwaltung. In Plesk werden diese Variablen NICHT
# über eine .env-Datei gesetzt, sondern über die Plesk-Node.js-UI
# ("Umgebungsvariablen hinzufügen"). Diese Datei dient nur als Referenz für
# lokale Entwicklung (Datei nach `.env` kopieren, niemals committen).

# Session-Secret (>= 32 Zeichen), z. B. `openssl rand -hex 32`
SECRET=bitte-einen-langen-zufallswert-eintragen
NODE_ENV=development
PUBLIC_URL=http://localhost:3001
DB_PFAD=data/noten.sqlite3

# --- LDAP / Active Directory (optional) -----------------------------------
# Fehlt LDAP_URL, ist die LDAP-Anmeldung deaktiviert — bestehende
# Lokal-/Extern-Konten (Einladungslink) funktionieren unverändert weiter.
# Alternative zu diesen ENV-Variablen: Admin → LDAP-Einstellungen in der App
# selbst konfigurieren (inkl. verschlüsseltem Service-Account-Passwort) —
# das hat dann Vorrang vor diesen ENV-Variablen.

LDAP_URL=ldaps://dc01.schule.local:636
LDAP_BASE_DN=DC=schule,DC=local
# {{username}} wird durch die eingegebene Anmeldekennung ersetzt.
LDAP_USER_FILTER=(sAMAccountName={{username}})

# --- Variante A: Direkt-Bind (empfohlen, kein Service-Account fürs Login nötig) ---
# Der Nutzer bindet direkt mit eigener Kennung + Passwort. {{username}} wird
# ersetzt. NetBIOS-Form (z. B. SCHULE\{{username}}) oder UPN ({{username}}@schule.local).
LDAP_BIND_USER_TEMPLATE=SCHULE\{{username}}

# --- Service-Account (Pflicht für die Admin-Funktion "Lehrkräfte aus LDAP
# importieren"/Verzeichnis-Suche — unabhängig davon, ob oben Direkt-Bind
# genutzt wird. Ohne Direkt-Bind ist er zusätzlich für den Login selbst nötig) ---
LDAP_BIND_DN=CN=svc-notenverwaltung,OU=ServiceAccounts,DC=schule,DC=local
LDAP_BIND_PW=
LDAP_LOGIN_ATTR=sAMAccountName
LDAP_NAME_ATTR=displayName
# Suchfilter für die Lehrkräfte-Suche im Admin-Bereich, {{query}} wird ersetzt:
LDAP_TEACHER_SEARCH_FILTER=(&(objectClass=person)(|(cn=*{{query}}*)(sAMAccountName=*{{query}}*)(displayName=*{{query}}*)))

# TLS für ldaps:// — bei interner CA den Pfad zur CA-PEM angeben (empfohlen):
# LDAP_TLS_CA_PFAD=/pfad/zur/interne-ca.pem
# Notlösung (nur in vertrauenswürdigen Netzen): Zertifikatsprüfung abschalten:
# LDAP_TLS_REJECT_UNAUTHORIZED=false

<h1>Lehrkräfte</h1>

<table class="data">
  <thead>
    <tr><th>Benutzername</th><th>Anzeigename</th><th>Rolle</th><th>Quelle</th><th>Status</th><th>Aktion</th></tr>
  </thead>
  <tbody>
    <% users.forEach(function(u) { %>
      <tr>
        <td><%= u.username %></td>
        <td><%= u.display_name || '—' %></td>
        <td><%= u.role %></td>
        <td>
          <% if (u.auth_source === 'ldap') { %>
            <span class="badge" style="background:#0d6efd">LDAP</span>
          <% } else { %>
            <span class="badge" style="background:#6c757d">Lokal / Extern</span>
          <% } %>
        </td>
        <td><%= u.active ? '✅ aktiv' : '🚫 inaktiv' %></td>
        <td>
          <details>
            <summary>Aktionen</summary>
            <form method="post" action="/admin/users/<%= u.id %>/toggle" class="inline">
              <button type="submit"><%= u.active ? 'Deaktivieren' : 'Aktivieren' %></button>
            </form>
            <% if (u.auth_source !== 'ldap') { %>
              <form method="post" action="/admin/users/<%= u.id %>/reset" class="inline">
                <input type="password" name="password" placeholder="neues Passwort" minlength="8" required>
                <button type="submit">Passwort zurücksetzen</button>
              </form>
            <% } else { %>
              <p><small>Passwort wird über LDAP verwaltet.</small></p>
            <% } %>
          </details>
        </td>
      </tr>
    <% }); %>
  </tbody>
</table>

<p><a href="/admin/einladungen">→ Neue externe Lehrkraft (ohne LDAP) per Einladungslink anlegen</a></p>
<p><a href="/admin/ldap">→ Lehrkräfte aus LDAP importieren</a></p>

<h1>Schuljahr: <%= schuljahr.bezeichnung %></h1>
<p><a href="/admin">← Zurück</a></p>

<h2>Klassen</h2>
<form method="post" action="/admin/schuljahre/<%= schuljahr.id %>/klassen/neu" class="inline">
  <input type="text" name="name" placeholder="z. B. 12BFI1" required>
  <button type="submit">+ Klasse anlegen</button>
</form>
<p class="hint">
  Notenschlüssel: IHK (Standard) — bei Bedarf danach in der Klasse selbst auf BG änderbar.
</p>
<ul class="klasse-liste">
  <% klassen.forEach(function(k) { %>
    <li>
      <a href="/admin/klassen/<%= k.id %>">
        <div class="kachel-zeile">
          <span class="kachel-icon-klein">🏫</span>
          <span class="kachel-titel-klein"><%= k.name %></span>
        </div>
      </a>
      <div class="kachel-sub">Notenschlüssel: <%= k.notenschluessel %></div>
      <div class="kachel-aktionen">
        <a class="btn" href="/export/klasse/<%= k.id %>.csv">📥 CSV</a>
        <form method="post" action="/admin/klassen/<%= k.id %>/loeschen" class="inline" onsubmit="return confirm('Klasse löschen? Schüler/innen und Fächer gehen verloren.')">
          <button type="submit" class="danger">🗑</button>
        </form>
      </div>
    </li>
  <% }); %>
</ul>

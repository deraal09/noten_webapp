<h1>Klassenleitung</h1>

<% if (!klassen.length) { %>
  <p>Du bist noch keiner Klasse als Klassenleitung zugewiesen.</p>
<% } else { %>
  <ul class="klasse-liste">
    <% klassen.forEach(function(k) { %>
      <li>
        <a href="/klassenlehrer/klasse/<%= k.id %>">
          <div class="kachel-zeile">
            <span class="kachel-icon-klein">🧑‍🏫</span>
            <span class="kachel-titel-klein"><%= k.name %></span>
          </div>
        </a>
        <div class="kachel-sub"><%= k.schuljahr_bezeichnung %> · <%= k.notenschluessel %></div>
      </li>
    <% }); %>
  </ul>
<% } %>

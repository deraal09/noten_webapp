<h1>Klassenleitung</h1>

<% if (!klassen.length) { %>
  <p>Du bist noch keiner Klasse als Klassenleitung zugewiesen.</p>
<% } else { %>
  <ul class="klasse-liste">
    <% klassen.forEach(function(k) { %>
      <li>
        <a href="/klassenlehrer/klasse/<%= k.id %>"><strong><%= k.name %></strong></a>
        <small>(<%= k.schuljahr_bezeichnung %>, <%= k.notenschluessel %>)</small>
      </li>
    <% }); %>
  </ul>
<% } %>

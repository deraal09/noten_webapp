<h1>Historische Halbjahre: <%= fach.name %> <small><%= fach.klasse_name %>, <%= fach.schuljahr_bezeichnung %></small></h1>
<p class="kopf-aktionen">
  <a class="btn" href="/klassenlehrer/klasse/<%= fach.klasse_id %>?tab=halbjahr">← Zur Klassenleitungsübersicht</a>
</p>

<div class="card">
  <h2>Historische Halbjahre <small>(Noten von vor Einführung der App)</small></h2>
  <% if (!historischeHalbjahre.length) { %>
    <p class="hint">Noch keine historischen Halbjahre hinterlegt.</p>
  <% } %>
  <% historischeHalbjahre.forEach(function(hh) { %>
    <details class="card" open>
      <summary><%= hh.bezeichnung %>
      <% if (!hh.darfBearbeiten) { %> <small class="hint" title="Von der Fachlehrkraft angelegt -- nur sie kann die Noten eintragen">🔒 nur Ansicht</small><% } %>
      </summary>
      <form method="post" action="/teacher/historie/<%= hh.id %>/loeschen" class="inline right" onsubmit="return confirm('Historisches Halbjahr entfernen?')">
        <button type="submit" class="danger">🗑</button>
      </form>
      <% if (hh.darfBearbeiten) { %>
        <form method="post" action="/teacher/historie/<%= hh.id %>/speichern">
          <p class="hint">Note eintragen oder <code>ntg</code> für „nicht teilgenommen".</p>
          <table class="data">
            <thead><tr><th>Schüler/in</th><th>Note</th></tr></thead>
            <tbody>
              <% schueler.forEach(function(s) { %>
                <tr>
                  <td class="name"><%= s.nachname %>, <%= s.vorname %></td>
                  <td>
                    <input type="text" name="note_<%= s.id %>" class="note-historisch" size="4"
                           title="Note (<%= fach.notenschluessel === 'BG' ? '0-15' : '1-6' %>) oder ntg"
                           value="<%= hh.noten.get(s.id) === undefined ? '' : hh.noten.get(s.id) %>">
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          <button type="submit">💾 Speichern</button>
        </form>
      <% } else { %>
        <table class="data">
          <thead><tr><th>Schüler/in</th><th>Note</th></tr></thead>
          <tbody>
            <% schueler.forEach(function(s) { %>
              <tr>
                <td class="name"><%= s.nachname %>, <%= s.vorname %></td>
                <td><%= hh.noten.get(s.id) === undefined ? '–' : hh.noten.get(s.id) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </details>
  <% }); %>
  <form method="post" action="/teacher/fach/<%= fach.id %>/historie/neu" class="inline">
    <input type="text" name="bezeichnung" placeholder="z. B. 1. Halbjahr 2022/23" required>
    <button type="submit">+ Vergangenes Halbjahr hinzufügen</button>
  </form>
</div>

<div class="card">
  <h2>Fach abschließen</h2>
  <% if (fach.abgeschlossen) { %>
    <p>
      ✅ Fach abgeschlossen am <strong><%= formatZeitLokal(fach.abgeschlossen_am) %></strong> —
      die Fachabschlussnote (Mittelwert aus allen historischen Halbjahren) ist eingefroren.
    </p>
    <form method="post" action="/teacher/fach/<%= fach.id %>/oeffnen" class="inline"
          onsubmit="return confirm('Fach wieder öffnen? Die Fachabschlussnote bleibt bis zum nächsten Abschließen unverändert sichtbar.')">
      <button type="submit">🔓 Fach wieder öffnen</button>
    </form>
  <% } else { %>
    <p class="hint">
      Optional: markiert das Fach als abgeschlossen und berechnet je Schüler/in eine
      Fachabschlussnote als Mittelwert aus allen vorhandenen historischen Halbjahren.
    </p>
    <form method="post" action="/teacher/fach/<%= fach.id %>/abschliessen" class="inline"
          onsubmit="return confirm('Fach abschließen? Für jede Schülerin/jeden Schüler wird eine Fachabschlussnote aus allen historischen Halbjahren berechnet.')">
      <button type="submit">✅ Fach abschließen</button>
    </form>
  <% } %>
</div>

<div class="card">
  <h2>Lehrkräfte zuordnen <small>(bekommen dadurch Zugriff auf die Notentafel/Historie dieses Fachs und können die Noten ändern)</small></h2>
  <% if (!zuweisungen.length) { %>
    <p class="hint">Diesem Fach ist noch keine Lehrkraft zugeordnet.</p>
  <% } else { %>
    <table class="data">
      <thead><tr><th>Lehrkraft</th><th>Aktion</th></tr></thead>
      <tbody>
        <% zuweisungen.forEach(function(z) { %>
          <tr>
            <td><%= z.display_name || z.username %></td>
            <td>
              <form method="post" action="/klassenlehrer/zuweisung/<%= z.id %>/loeschen" class="inline" onsubmit="return confirm('Zuweisung entfernen?')">
                <button type="submit" class="danger">🗑</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
  <form method="post" action="/klassenlehrer/fach/<%= fach.id %>/lehrkraft/neu" class="inline">
    <label>Lehrkraft
      <select name="user_id" required>
        <option value="">— wählen —</option>
        <% zuweisbareLehrkraefte.forEach(function(u) { %>
          <option value="<%= u.id %>"><%= u.display_name || u.username %></option>
        <% }); %>
      </select>
    </label>
    <button type="submit">+ Zuweisen</button>
  </form>
</div>

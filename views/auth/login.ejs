<h1>Anmelden</h1>
<% if (typeof error !== 'undefined' && error) { %><p class="err"><%= error %></p><% } %>
<% if (typeof query !== 'undefined' && query.msg === 'invite_expired') { %>
  <p class="err">Dieser Einladungslink ist abgelaufen.</p>
<% } %>
<form method="post" action="/login" class="card">
  <input type="hidden" name="next" value="<%= next %>">
  <label>Benutzername
    <input type="text" name="username" autofocus required>
  </label>
  <label>Passwort
    <input type="password" name="password" required>
  </label>
  <label>
    <input type="checkbox" name="angemeldet_bleiben" value="1" checked>
    Angemeldet bleiben (bis zu 30 Tage auf diesem Gerät)
  </label>
  <button type="submit">Anmelden</button>
</form>
<p><small>
  Auf einem fremden/geteilten Gerät den Haken „Angemeldet bleiben" entfernen —
  dann endet die Anmeldung wie bisher nach 12 Stunden Inaktivität.
</small></p>

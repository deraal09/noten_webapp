<div class="start-mitte">
  <h1>Willkommen<% if (user.displayName) { %>, <%= user.displayName %><% } %></h1>

  <p class="hilfe-banner" id="hilfe-banner" hidden>
    👋 Neu hier? <a href="/hilfe/rundgang">Geführter Rundgang</a> · <a href="/hilfe">Hilfe mit Suche</a>
    <button type="button" id="hilfe-banner-zu" class="hilfe-banner-zu" aria-label="Hinweis ausblenden">✕</button>
  </p>
  <script>
    (function () {
      var b = document.getElementById('hilfe-banner');
      try { if (localStorage.getItem('hilfe-banner-zu') === '1' || localStorage.getItem('rundgang-fertig') === '1') return; } catch (e) { /* ohne Speicher: anzeigen */ }
      b.hidden = false;
      document.getElementById('hilfe-banner-zu').addEventListener('click', function () {
        b.hidden = true;
        try { localStorage.setItem('hilfe-banner-zu', '1'); } catch (e) { /* egal */ }
      });
    })();
  </script>

  <% if (!user.isAdmin && funktionen && !funktionen.gewaehlt) { %>
    <section class="card profil-wahl" aria-label="Startprofil wählen">
      <h2>Wie möchtest du die Notenverwaltung nutzen?</h2>
      <p class="hint">Wähle, was du sehen willst. Du kannst das jederzeit unter ⚙ <a href="/konto/funktionen">Meine Funktionen</a> ändern – nichts geht verloren oder ist gesperrt.</p>
      <div class="profil-liste">
        <% Object.keys(PROFILE).forEach(function(id) { var pr = PROFILE[id]; %>
          <form method="post" action="/konto/funktionen/profil" class="profil-karte">
            <input type="hidden" name="profil" value="<%= id %>">
            <input type="hidden" name="weiter" value="/start">
            <strong><%= pr.titel %></strong>
            <span class="hint"><%= pr.text %></span>
            <button type="submit">Auswählen</button>
          </form>
        <% }); %>
      </div>
    </section>
  <% } %>

  <% if (ersteSchritte) { %>
    <section class="card erste-schritte" id="erste-schritte" aria-label="Erste Schritte">
      <h2>Erste Schritte <small class="hint">(<%= ersteSchritte.erledigt %> von <%= ersteSchritte.schritte.length %> erledigt)</small></h2>
      <ol class="schritte-liste">
        <% ersteSchritte.schritte.forEach(function(st) { %>
          <li class="<%= st.erledigt ? 'erledigt' : '' %>">
            <span class="schritt-haken" aria-hidden="true"><%= st.erledigt ? '✓' : '○' %></span>
            <span>
              <% if (!st.erledigt && st.href) { %><a href="<%= st.href %>"><strong><%= st.titel %></strong></a><% } else { %><strong><%= st.titel %></strong><% } %>
              <% if (st.erledigt) { %><span class="visually-hidden"> (erledigt)</span><% } else { %><br><small class="hint"><%= st.text %></small><% } %>
            </span>
          </li>
        <% }); %>
      </ol>
      <p><button type="button" id="erste-schritte-zu" class="link-knopf">Ausblenden</button></p>
    </section>
    <script>
      (function () {
        var k = document.getElementById('erste-schritte');
        try { if (localStorage.getItem('erste-schritte-zu') === '1') { k.hidden = true; return; } } catch (e) { /* ohne Speicher: anzeigen */ }
        document.getElementById('erste-schritte-zu').addEventListener('click', function () {
          k.hidden = true;
          try { localStorage.setItem('erste-schritte-zu', '1'); } catch (e) { /* egal */ }
        });
      })();
    </script>
  <% } %>

  <% if (typeof zuletzt !== 'undefined' && zuletzt.length) { %>
    <section class="weitermachen" aria-label="Weitermachen">
      <h2>Weitermachen</h2>
      <ul>
        <% zuletzt.forEach(function(z) { %><li><a class="weitermachen-link" href="<%= z.href %>">📝 <%= z.titel %></a></li><% }); %>
      </ul>
    </section>
  <% } %>

  <% var nochNichtsErledigt = ersteSchritte && ersteSchritte.erledigt === 0; %>
  <% if (nochNichtsErledigt) { %>
    <%# Ganz neu: Statt der Kachelauswahl führt die Checkliste durch die ersten Schritte. %>
    <p class="hint start-links"><a href="/teacher">Noteneingabe</a> · <a href="/teacher/klassen">Meine Klassen</a><% if (!funktionen || funktionen.klassenleitung) { %> · <a href="/klassenlehrer">Klassenleitung</a><% } %></p>
  <% } else { %>
  <div class="kacheln">
    <a class="kachel" href="/teacher">
      <span class="kachel-icon">📝</span>
      <span class="kachel-titel">Noteneingabe</span>
    </a>
    <a class="kachel" href="/teacher/klassen">
      <span class="kachel-icon">🏫</span>
      <span class="kachel-titel">Meine Klassen</span>
    </a>
    <% if (!funktionen || funktionen.sitzplan) { %>
    <a class="kachel" href="/teacher/sitzplaene">
      <span class="kachel-icon">🪑</span>
      <span class="kachel-titel">Sitzpläne</span>
    </a>
    <% } %>
    <% if (!funktionen || funktionen.klassenleitung) { %>
    <a class="kachel" href="/klassenlehrer">
      <span class="kachel-icon">🧑‍🏫</span>
      <span class="kachel-titel">Klassenleitung</span>
    </a>
    <% } %>
  </div>
  <% } %>
</div>

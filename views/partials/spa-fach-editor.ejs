<%# Fach-Karten des SPA-Editors (Vorlage bzw. einzelnes Fach). Erwartet: modell, alleFaecher, einzeln (true = ein Fach der Klasse). %>
<% modell.forEach(function(f, i) { var istNeu = !f.name && !f.schluessel; %>
  <details class="spa-fach card" <%= (einzeln || istNeu || modell.length === 1) ? 'open' : '' %> <%= istNeu ? 'id=neues-fach' : '' %>>
    <summary><strong><%= f.name || 'Neues Fach' %></strong>
      <small class="hint">(<%= f.typ === 'LF' ? 'Lernfeld' : 'Fach' %><%= f.schluessel ? ', ' + f.schluessel : '' %>)</small></summary>
    <input type="hidden" name="fach_idx" value="<%= i %>">
    <input type="hidden" name="f<%= i %>_key" value="<%= f.schluessel %>">
    <div class="spa-fach-kopf">
      <label>Name
        <input type="text" name="f<%= i %>_name" value="<%= f.name %>" maxlength="100" <%= istNeu ? '' : 'required' %>>
      </label>
      <% if (!einzeln) { %>
        <label>Art
          <select name="f<%= i %>_typ">
            <option value="FACH" <%= f.typ === 'FACH' ? 'selected' : '' %>>Fach</option>
            <option value="LF" <%= f.typ === 'LF' ? 'selected' : '' %>>Lernfeld</option>
          </select>
        </label>
        <label class="spa-entfernen"><input type="checkbox" name="f<%= i %>_entfernen" value="1"> Fach aus der Vorlage entfernen</label>
      <% } %>
    </div>
    <% var ag = f.allgemein || {}; var q = 'f' + i + '_allg_'; %>
    <div class="spa-tabs" role="tablist" aria-label="Einstellungen von <%= f.name || 'Neues Fach' %>">
      <button type="button" class="active" role="tab" data-tab="allg">Allgemein</button>
      <% f.halbjahre.forEach(function(h) { %><button type="button" role="tab" data-tab="hj<%= h.hj %>"><%= h.hj %>. Halbjahr</button><% }); %>
    </div>
    <fieldset class="spa-allgemein" data-panel="allg">
      <legend>Allgemeine Einstellungen <small class="hint">(gelten für das ganze Fach, alle Halbjahre)</small></legend>
      <div class="spa-haken">
        <div class="spa-option">
          <label class="inline"><input type="checkbox" name="<%= q %>abschluss" value="1" <%= ag.abschluss ? 'checked' : '' %>> im Abschlusszeugnis zeigen</label>
          <label class="inline spa-option-hj">aus Halbjahr(en) <input type="text" name="<%= q %>abschluss_hj" value="<%= ag.abschlussHj || '' %>" size="6" placeholder="letztes" inputmode="numeric" autocomplete="off"></label>
        </div>
        <div class="spa-option">
          <label class="inline"><input type="checkbox" name="<%= q %>pruefung" value="1" <%= ag.pruefung ? 'checked' : '' %>> mit Prüfung</label>
          <label class="inline spa-option-hj">im Halbjahr <input type="text" name="<%= q %>pruefung_hj" value="<%= ag.pruefungHj || '' %>" size="6" placeholder="letztes" inputmode="numeric" autocomplete="off"></label>
        </div>
        <div class="spa-option"><label class="inline"><input type="checkbox" name="<%= q %>deakt" value="1" <%= ag.deakt ? 'checked' : '' %>> „n/a“ je Person möglich</label></div>
        <div class="spa-option"><label class="inline"><input type="checkbox" name="<%= q %>komma" value="1" <%= ag.komma ? 'checked' : '' %>> als Komma-Note (z. B. 3,0)</label></div>
      </div>
      <p class="hint">
        Zeugnisposition und Prüfung gelten im genannten Halbjahr (leer = letztes aktives Halbjahr des Fachs); mehrere Halbjahre bei
        der Zeugnisposition mit Komma, z. B. <code>2, 4</code> (Praxis mit zwei Zeilen im Abschlusszeugnis).
        Bewertung, Komponenten und Verrechnung stellst du je Halbjahr in den Reitern daneben ein.
      </p>
    </fieldset>
    <div class="spa-halbjahre">
      <% f.halbjahre.forEach(function(h) { var p = 'f' + i + '_h' + h.hj + '_'; %>
        <fieldset class="spa-hj" data-hj data-panel="hj<%= h.hj %>">
          <legend><%= h.hj %>. Halbjahr</legend>
          <label>Das Fach ist in diesem Halbjahr
            <select name="<%= p %>status">
              <option value="aktiv" <%= h.status === 'aktiv' ? 'selected' : '' %>>aktiv (zählt, steht im Zeugnis)</option>
              <option value="inaktiv" <%= h.status === 'inaktiv' ? 'selected' : '' %>>vorhanden, aber inaktiv</option>
              <option value="fehlt" <%= h.status === 'fehlt' ? 'selected' : '' %>>nicht vorhanden</option>
            </select>
          </label>
          <label>Bewertung
            <select name="<%= p %>modus" data-steuert="modus">
              <option value="direkt" <%= h.modus === 'direkt' ? 'selected' : '' %>>ein Punktwert (direkt)</option>
              <option value="komponenten_gewichtet" <%= h.modus === 'komponenten_gewichtet' ? 'selected' : '' %>>aus Komponenten gewichtet</option>
            </select>
          </label>
          <label data-wenn-modus="komponenten_gewichtet">Komponenten (eine pro Zeile: <em>Name; Prozent</em> oder <em>Name; Rest</em>)
            <textarea name="<%= p %>komp" rows="4" placeholder="Pädagogik; 40&#10;Kunst; Rest"><%= h.komp %></textarea>
            <small class="hint">„Rest“ teilt sich den Rest bis 100 % gleichmäßig; feste Prozente zusammen höchstens 100 %.</small>
          </label>
          <label>Verrechnung mit Vorwerten
            <select name="<%= p %>kum" data-steuert="kum">
              <option value="keine" <%= h.kum === 'keine' ? 'selected' : '' %>>keine</option>
              <option value="fortlaufend_50_50" <%= h.kum === 'fortlaufend_50_50' ? 'selected' : '' %>>fortlaufend 50 % Vorwert / 50 % neu</option>
              <option value="gewichtet_vorgaenger" <%= h.kum === 'gewichtet_vorgaenger' ? 'selected' : '' %>>gewichtet mit einer Quelle</option>
              <option value="mittelwert_halbjahre" <%= h.kum === 'mittelwert_halbjahre' ? 'selected' : '' %>>Mittelwert aus Halbjahren</option>
            </select>
          </label>
          <div data-wenn-kum="mittelwert_halbjahre" class="spa-mw">
            Mittelwert aus:
            <% [1, 2, 3, 4].forEach(function(n) { %>
              <label class="inline"><input type="checkbox" name="<%= p %>mw" value="<%= n %>" <%= h.mw.indexOf(n) >= 0 ? 'checked' : '' %>> <%= n %>. Hj.</label>
            <% }); %>
          </div>
          <div data-wenn-kum="gewichtet_vorgaenger" class="spa-quelle">
            <label>Quelle
              <select name="<%= p %>quelle" data-steuert="quelle">
                <option value="vorgaenger" <%= h.quelle === 'vorgaenger' ? 'selected' : '' %>>vorheriges Halbjahr (30 % / 70 %)</option>
                <option value="fach" <%= h.quelle === 'fach' ? 'selected' : '' %>>Halbjahr eines anderen Fachs</option>
                <option value="pruefung" <%= h.quelle === 'pruefung' ? 'selected' : '' %>>Prüfungsnote dieses Fachs</option>
              </select>
            </label>
            <span data-wenn-quelle="fach">
              <label>Fach
                <select name="<%= p %>extfach">
                  <% alleFaecher.forEach(function(a) { if (a.schluessel === f.schluessel || !a.name) return; %>
                    <option value="<%= a.schluessel %>" <%= h.extFach === a.schluessel ? 'selected' : '' %>><%= a.name %></option>
                  <% }); %>
                </select>
              </label>
              <label>Halbjahr
                <select name="<%= p %>exthj">
                  <% [1, 2, 3, 4].forEach(function(n) { %><option value="<%= n %>" <%= Number(h.extHj) === n ? 'selected' : '' %>><%= n %>. Hj.</option><% }); %>
                </select>
              </label>
            </span>
            <span data-wenn-quelle="fach pruefung">
              <label>Anteil der Quelle
                <span class="feld-mit-einheit"><input type="text" inputmode="decimal" name="<%= p %>extpct" value="<%= h.extPct %>" size="4">%</span>
              </label>
            </span>
          </div>
        </fieldset>
      <% }); %>
    </div>
  </details>
<% }); %>
<script>
  // Blendet Felder aus, die zur gewählten Bewertung/Verrechnung/Quelle nicht passen.
  (function() {
    function aktualisieren(fs) {
      var wert = function(n) { var s = fs.querySelector('[data-steuert="' + n + '"]'); return s ? s.value : ''; };
      fs.querySelectorAll('[data-wenn-modus]').forEach(function(e) { e.hidden = e.getAttribute('data-wenn-modus') !== wert('modus'); });
      fs.querySelectorAll('[data-wenn-kum]').forEach(function(e) { e.hidden = e.getAttribute('data-wenn-kum') !== wert('kum'); });
      fs.querySelectorAll('[data-wenn-quelle]').forEach(function(e) { e.hidden = e.getAttribute('data-wenn-quelle').split(' ').indexOf(wert('quelle')) < 0; });
    }
    // Reiter je Fach: "Allgemein" und die vier Halbjahre (ohne JavaScript sind alle Bereiche sichtbar).
    document.querySelectorAll('.spa-fach').forEach(function(karte) {
      var tabs = karte.querySelectorAll('.spa-tabs button[data-tab]');
      var zeige = function(name) {
        tabs.forEach(function(b) { b.classList.toggle('active', b.getAttribute('data-tab') === name); });
        karte.querySelectorAll('[data-panel]').forEach(function(p) { p.hidden = p.getAttribute('data-panel') !== name; });
      };
      tabs.forEach(function(b) { b.addEventListener('click', function() { zeige(b.getAttribute('data-tab')); }); });
      if (tabs.length) zeige('allg');
    });
    document.querySelectorAll('fieldset[data-hj]').forEach(function(fs) {
      fs.addEventListener('change', function() { aktualisieren(fs); });
      aktualisieren(fs);
    });
  })();
</script>

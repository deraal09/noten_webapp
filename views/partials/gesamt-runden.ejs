<%# Haken "Gesamtnote auf ganze Note runden" über der Notenübersicht. Erwartet: schluessel (z. B. 'fach-12').
    Nur die Anzeige ändert sich: Zellen mit data-roh (genauer Wert) in #uebersicht zeigen gerundet an; gespeichert, exportiert und
    im Zeugnis gelten weiter die genauen Werte. Die Wahl merkt sich der Browser je Fach (localStorage). %>
<label class="runden-schalter" title="Nur die Anzeige in dieser Übersicht: gespeicherte Noten, Zeugnis und Export bleiben unverändert">
  <input type="checkbox" id="gesamt-runden" data-key="<%= schluessel %>"> Gesamtnote auf ganze Note runden
</label>
<script>
  (function () {
    var cb = document.getElementById('gesamt-runden');
    if (!cb) return;
    var KEY = 'gesamt-gerundet-' + cb.dataset.key;
    try { cb.checked = localStorage.getItem(KEY) === '1'; } catch (e) { /* ohne Speicher: nicht gerundet */ }
    function anwenden() {
      document.querySelectorAll('#uebersicht [data-roh]').forEach(function (z) {
        if (z.dataset.orig === undefined) { z.dataset.orig = z.textContent; z.dataset.t0 = z.getAttribute('title') || ''; }
        var n = z.dataset.roh === '' ? NaN : Number(z.dataset.roh);
        if (cb.checked && isFinite(n)) {
          z.textContent = String(Math.round(n));
          z.title = (z.dataset.t0 ? z.dataset.t0 + ' · ' : '') + 'Genau: ' + String(z.dataset.roh).replace('.', ',');
        } else {
          z.textContent = z.dataset.orig;
          if (z.dataset.t0) z.title = z.dataset.t0; else z.removeAttribute('title');
        }
      });
    }
    cb.addEventListener('change', function () {
      try { localStorage.setItem(KEY, cb.checked ? '1' : '0'); } catch (e) { /* egal */ }
      anwenden();
    });
    // Nach dem Live-Update der Tabelle (neuer Wert in data-roh / data-orig) erneut anwenden.
    window.gesamtRundenAnwenden = anwenden;
    // Die Tabelle steht erst nach diesem Skript im Dokument: nach dem Laden anwenden.
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', anwenden); else anwenden();
  })();
</script>

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' – ' : '' %><%= appName %></title>
  <script>
    // Vor dem ersten Rendern ausführen (kein defer/async, kein type=module),
    // damit kein falsches Farbschema kurz aufblitzt, bevor die manuelle Wahl
    // greift. "System" (kein gespeicherter Wert) lässt @media
    // prefers-color-scheme in app.css entscheiden.
    (function () {
      try {
        var pref = localStorage.getItem('theme-pref');
        if (pref === 'light' || pref === 'dark') document.documentElement.setAttribute('data-theme', pref);
      } catch (e) { /* z. B. privater Modus ohne localStorage */ }
    })();
  </script>
  <link rel="stylesheet" href="/static/css/app.css?v=<%= typeof cssVersion !== 'undefined' ? cssVersion : '' %>">
  <%# Als App installierbar (Android, Windows, Linux per Browser-Dialog; iOS über die Anleitung): siehe app.js (/manifest.webmanifest, /sw.js) %>
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" sizes="192x192" href="/static/icons/icon-192.png">
  <link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png">
  <meta name="theme-color" content="#1d3557">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Noten">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
</head>
<body>
<% /* Eingebettet im Lehrerkalender (siehe app.js, Erkennung ueber
      Sec-Fetch-Dest): eigene Kopf-/Fusszeile ausblenden, damit die
      Notenverwaltung wie ein Bereich der einbettenden App wirkt statt wie
      eine zweite App darin. */ %>
<% if (!(typeof embed !== 'undefined' && embed)) { %>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/">📚 <%= appName %></a>
    <% if (typeof user !== 'undefined' && user) { %>
      <button type="button" class="nav-toggle" aria-label="Menü öffnen" aria-expanded="false">☰</button>
      <nav class="nav">
        <a href="/start">Start</a>
        <% if (user.isAdmin) { %>
          <a href="/admin">Dashboard</a>
          <a href="/admin/users">Lehrkräfte</a>
          <a href="/admin/ldap/einstellungen">LDAP-Einstellungen</a>
          <a href="/admin/ldap">LDAP-Import</a>
          <a href="/admin/einladungen">Einladungen</a>
          <a href="/admin/zuweisungen">Zuweisungen</a>
        <% } else { %>
          <a href="/teacher/klassen">Meine Klassen</a>
          <% if (typeof kannEinladen !== 'undefined' && kannEinladen) { %>
            <a href="/teacher/einladungen">Einladungen</a>
          <% } %>
        <% } %>
        <a href="/teacher/sitzplaene">Sitzpläne</a>
        <a href="/teacher">Noteneingabe</a>
        <a href="/klassenlehrer">Klassenleitung</a>
        <% if (typeof kalenderUrl !== 'undefined' && kalenderUrl) { %>
          <%# Schwester-App: dank Single Sign-on ohne zweite Anmeldung (src/sso.js) %>
          <a href="<%= kalenderUrl %>" target="_blank" rel="noopener">Lehrerkalender ↗</a>
        <% } %>
      </nav>
      <div class="userbox">
        <span class="user"><%= user.displayName || user.username %></span>
        <% if (user.isAdmin) { %><span class="role">Admin</span><% } %>
        <a class="logout" href="/logout">Abmelden</a>
      </div>
    <% } %>
    <button type="button" class="app-install" id="app-install-knopf" hidden title="Notenverwaltung als App installieren">
      <span aria-hidden="true">📲</span><span class="app-install-text"> App installieren</span>
    </button>
    <div class="theme-switch" role="group" aria-label="Farbschema">
      <button type="button" data-theme-choice="system" title="System">🖥️</button>
      <button type="button" data-theme-choice="light" title="Hell">☀️</button>
      <button type="button" data-theme-choice="dark" title="Dunkel">🌙</button>
    </div>
  </div>
</header>
<% } %>
<% if (typeof flash !== 'undefined' && flash && flash.length) { %>
  <% flash.forEach(function (f) { %>
    <div class="flash flash-<%= f.type %>"><%= f.message %></div>
  <% }) %>
<% } %>
<main class="container">
<%- body %>
</main>
<% if (!(typeof embed !== 'undefined' && embed)) { %>
<dialog id="app-install-dialog" class="notiz-dialog app-install-dialog" aria-labelledby="app-install-titel">
  <h2 id="app-install-titel">Notenverwaltung als App installieren</h2>
  <div data-plattform="ios">
    <p>Auf iPhone und iPad geht das über Safari:</p>
    <ol>
      <li>Diese Seite in <strong>Safari</strong> öffnen (in anderen Browsern: Teilen-Menü → „In Safari öffnen“, falls „Zum Home-Bildschirm“ fehlt).</li>
      <li>Unten (iPad: oben rechts) auf das <strong>Teilen-Symbol</strong> tippen – das Quadrat mit dem Pfeil nach oben.</li>
      <li>Nach unten scrollen und <strong>„Zum Home-Bildschirm“</strong> wählen.</li>
      <li>Oben rechts auf <strong>„Hinzufügen“</strong> tippen.</li>
    </ol>
    <p class="hint">Danach startet die Notenverwaltung wie eine App über das Symbol auf dem Home-Bildschirm, ohne Adressleiste. Wichtig: Es muss die Webadresse der Schule (https) geöffnet sein.</p>
  </div>
  <div data-plattform="chromium">
    <p>Der Browser bietet die Installation gerade nicht selbst an. Bitte so vorgehen:</p>
    <ul>
      <li><strong>Android (Chrome):</strong> Menü ⋮ → „App installieren“ bzw. „Zum Startbildschirm hinzufügen“.</li>
      <li><strong>Windows/Linux (Chrome, Edge, Chromium):</strong> in der Adressleiste rechts auf das <strong>Installieren-Symbol</strong> (Monitor mit Pfeil) klicken, oder Menü ⋮ → „Speichern und teilen“ → „Seite als App installieren“ (Edge: Menü … → „Apps“ → „Diese Website als App installieren“).</li>
    </ul>
    <p class="hint">Ist die App schon installiert, steht sie im Startmenü bzw. in der App-Liste.</p>
  </div>
  <div data-plattform="safari-mac">
    <p><strong>Safari am Mac</strong> (ab Version 17): Menü <em>Ablage</em> → <strong>„Zum Dock hinzufügen“</strong>.</p>
  </div>
  <div data-plattform="firefox">
    <p><strong>Firefox</strong> kann Webseiten nicht als App installieren. Bitte <strong>Chrome</strong> oder <strong>Edge</strong> verwenden – oder die Seite als Lesezeichen speichern.</p>
  </div>
  <div class="form-actions"><button type="button" id="app-install-zu">Schließen</button></div>
</dialog>
<% } %>
<% if (!(typeof embed !== 'undefined' && embed)) { %>
<footer class="footer">
  <small>Notenverwaltung · <%= now.getFullYear() %><% if (typeof appVersion !== 'undefined' && appVersion) { %> · v<%= appVersion %><%
    if (typeof appReleaseDate !== 'undefined' && appReleaseDate) { %> (<%= appReleaseDate.split('-').reverse().join('.') %>)<% } %><% } %></small>
</footer>
<% } %>
<script>
  (function () {
    var toggle = document.querySelector('.nav-toggle');
    var inner = document.querySelector('.topbar-inner');
    if (toggle && inner) {
      toggle.addEventListener('click', function () {
        var offen = inner.classList.toggle('nav-open');
        toggle.setAttribute('aria-expanded', offen ? 'true' : 'false');
      });
    }
  })();
  // App installieren: Chrome/Edge (Android, Windows, Linux) bieten per "beforeinstallprompt" die Installation direkt
  // an; auf iOS (und überall, wo der Browser das nicht anbietet) öffnet der Knopf eine Anleitung.
  (function () {
    var knopf = document.getElementById('app-install-knopf');
    var dialog = document.getElementById('app-install-dialog');
    if (!knopf || !dialog) return;
    var ua = navigator.userAgent || '';
    var istIos = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    var istFirefox = /Firefox|FxiOS/.test(ua) && !istIos;
    var istSafariMac = !istIos && /Macintosh/.test(ua) && /Safari/.test(ua) && !/Chrome|Chromium|Edg|OPR/.test(ua);
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(function () { /* z. B. ohne https */ }); });
    }
    var laeuftAlsApp = (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) || window.navigator.standalone === true;
    if (laeuftAlsApp) return; // schon als App geöffnet: nichts anzubieten
    var angebot = null;

    window.addEventListener('beforeinstallprompt', function (e) { e.preventDefault(); angebot = e; });
    window.addEventListener('appinstalled', function () { angebot = null; knopf.hidden = true; if (dialog.open) dialog.close(); });
    knopf.hidden = false;

    function zeigeAnleitung() {
      var art = istIos ? 'ios' : istFirefox ? 'firefox' : istSafariMac ? 'safari-mac' : 'chromium';
      dialog.querySelectorAll('[data-plattform]').forEach(function (b) { b.hidden = b.getAttribute('data-plattform') !== art; });
      if (dialog.showModal) dialog.showModal();
    }
    knopf.addEventListener('click', function () {
      if (angebot && !istIos) {
        var e = angebot;
        angebot = null;
        e.prompt();
        e.userChoice.then(function (wahl) { if (wahl.outcome === 'accepted') knopf.hidden = true; });
      } else zeigeAnleitung();
    });
    document.getElementById('app-install-zu').addEventListener('click', function () { dialog.close(); });
  })();
  (function () {
    var buttons = document.querySelectorAll('.theme-switch button');
    var pref = 'system';
    try { pref = localStorage.getItem('theme-pref') || 'system'; } catch (e) { /* z. B. privater Modus */ }
    function markiereAktiv() {
      buttons.forEach(function (b) { b.classList.toggle('active', b.dataset.themeChoice === pref); });
    }
    markiereAktiv();
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        pref = btn.dataset.themeChoice;
        try { localStorage.setItem('theme-pref', pref); } catch (e) { /* z. B. privater Modus */ }
        if (pref === 'system') document.documentElement.removeAttribute('data-theme');
        else document.documentElement.setAttribute('data-theme', pref);
        markiereAktiv();
      });
    });
  })();
</script>
</body>
</html>

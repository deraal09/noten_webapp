<% var zeugnisArt = schueler.status === 'abgang' ? 'Abgangszeugnis' : 'Abschlusszeugnis'; %>
<h1><%= zeugnisArt %>: <%= schueler.nachname %>, <%= schueler.vorname %> <small>(<%= schueler.klasse_name %>)</small></h1>
<p class="kopf-aktionen">
  <a class="btn" href="/teacher/klassen/<%= schueler.klasse_id %>">← Zur Klasse</a>
  <button type="button" class="btn" onclick="window.print()">🖨 Drucken</button>
</p>

<% if (schueler.status === 'abgang') { %>
  <p class="hint">Abgang aus der Klasse<% if (schueler.abgang_am) { %> am <%= formatZeitLokal(schueler.abgang_am) %><% } %>.</p>
<% } %>

<p class="hint">
  Alle Fächer/Lernfelder über alle besuchten Schuljahre. Bei einem noch laufenden Fach werden alle Einzelnoten (alle Halbjahre des Fachs) und der aktuelle Stand
  (Mittelwert) gezeigt, bei einem abgeschlossenen Fach (letztes Halbjahr vorbei) zählt nur die Gesamtnote (Abschlussnote).
</p>

<% if (!zeilen.length) { %>
  <p>Keine Fächer eingetragen.</p>
<% } else { %>
  <table class="data">
    <thead>
      <tr>
        <th>Fach</th>
        <th>Einzelnoten</th>
        <th>Gesamtnote</th>
      </tr>
    </thead>
    <tbody>
      <% zeilen.forEach(function(z) { %>
        <tr>
          <td class="name"><%= z.fach.name %></td>
          <td>
            <% if (z.fach.abgeschlossen) { %>
              <span class="hint">abgeschlossen -- es zählt nur die Gesamtnote</span>
            <% } else if (!z.eintraege.length) { %>–<% } else { %>
              <% z.eintraege.forEach(function(e) { %>
                <div><%= e.label %>: <%= e.anzeige !== null ? e.anzeige : formatNote(e.note) %></div>
              <% }); %>
            <% } %>
          </td>
          <td class="note-cell">
            <% if (z.fach.abgeschlossen) { %>
              <strong><%= z.abschlussnote === null ? '–' : formatNote(z.abschlussnote) %></strong>
            <% } else if (z.stand !== null) { %>
              <%= formatNote(z.stand) %> <small class="hint">(aktueller Stand)</small>
            <% } else { %>–<% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<script>
  // Reiter (Notenübersicht/Unterrichtsleistung/Klausuren, sowie die
  // Unter-Reiter je Klausur und je Zusatzleistung) umschalten. Jede
  // .reiter-Gruppe verwaltet nur ihre eigenen Buttons/Panels (sonst würde
  // ein Klick auf einen Unter-Reiter versehentlich auch die oberste
  // Reiter-Ebene umschalten). Der gewählte Reiter wird je Gruppe in
  // localStorage gemerkt, damit er nach einem Seiten-Reload (z. B. nach dem
  // Anlegen/Löschen einer Klausur oder UL, oder dem Speichern von
  // Gewichtung/Max-Punkten — alles normale Form-POSTs mit vollem Reload)
  // erhalten bleibt, statt immer wieder auf den ersten Reiter zurückzuspringen.
  function initReiterGruppe(gruppe) {
    // Buttons mit data-target zählen als Reiter, egal ob sie direkt in der
    // Gruppe stehen oder (bei der obersten Reiter-Ebene) im aufklappbaren
    // "⋮ Mehr"-Dropdown (.reiter-mehr-menu) versteckt sind -- der
    // Umschalter-Button selbst (.reiter-mehr-toggle) hat kein Ziel-Panel und
    // wird über das fehlende data-target automatisch ausgeschlossen.
    const buttons = Array.from(gruppe.querySelectorAll('button[data-target]'));
    const storageKey = gruppe.dataset.storageKey;
    const mehrWrapper = gruppe.querySelector('.reiter-mehr-wrapper');
    const mehrToggle = gruppe.querySelector('.reiter-mehr-toggle');
    function schliesseMehrMenue() {
      if (!mehrWrapper) return;
      mehrWrapper.classList.remove('offen');
      if (mehrToggle) mehrToggle.setAttribute('aria-expanded', 'false');
    }
    function setzeReiter(targetId) {
      buttons.forEach(function(b) { b.classList.toggle('active', b.dataset.target === targetId); });
      buttons.forEach(function(b) {
        const panel = document.getElementById(b.dataset.target);
        if (panel) panel.classList.toggle('active', b.dataset.target === targetId);
      });
      // "⋮ Mehr" selbst hervorheben, wenn der aktive Reiter im Dropdown
      // versteckt ist -- sonst wüsste man nach dem Schließen des Menüs
      // nicht mehr, welcher (versteckte) Reiter gerade aktiv ist.
      if (mehrToggle) {
        const aktiverBtn = buttons.find(function(b) { return b.dataset.target === targetId; });
        const imMenue = Boolean(aktiverBtn && aktiverBtn.closest('.reiter-mehr-menu'));
        mehrToggle.classList.toggle('active', imMenue);
      }
    }
    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        setzeReiter(btn.dataset.target);
        if (storageKey) {
          try { localStorage.setItem(storageKey, btn.dataset.target); } catch (e) { /* z. B. privater Modus */ }
        }
        if (btn.closest('.reiter-mehr-menu')) schliesseMehrMenue();
      });
    });
    if (mehrWrapper && mehrToggle) {
      mehrToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        const offen = mehrWrapper.classList.toggle('offen');
        mehrToggle.setAttribute('aria-expanded', offen ? 'true' : 'false');
      });
      // Klick außerhalb des Dropdowns schließt es wieder (übliches
      // Dropdown-Verhalten).
      document.addEventListener('click', function(e) {
        if (mehrWrapper.classList.contains('offen') && !mehrWrapper.contains(e.target)) schliesseMehrMenue();
      });
    }
    if (storageKey) {
      try {
        const gemerkterReiter = localStorage.getItem(storageKey);
        if (gemerkterReiter && document.getElementById(gemerkterReiter)) {
          setzeReiter(gemerkterReiter);
        }
      } catch (e) { /* z. B. privater Modus */ }
    }
  }
  document.querySelectorAll('.reiter').forEach(initReiterGruppe);

  // Direkt auf einen bestimmten Reiter springen (?tab=teilnehmer), z. B. nach
  // dem Anlegen eines klassenübergreifenden Kurses -- überschreibt für diesen
  // einen Seitenaufruf den sonst aus localStorage gemerkten Reiter. Zusätzlich
  // ?open=klausur-panel-<id>/ul-panel-<id>, um nach dem Anlegen einer Klausur
  // oder Zusatzleistung direkt deren Unter-Reiter zu öffnen (Fokus liegt dann
  // sofort auf der Punkteeingabe, statt erst wieder dorthin klicken zu müssen).
  (function() {
    const params = new URLSearchParams(location.search);
    const gewuenschterTab = params.get('tab');
    if (gewuenschterTab) {
      const btn = document.querySelector('.reiter button[data-target="panel-' + gewuenschterTab + '"]');
      if (btn) btn.click();
    }
    const zuOeffnen = params.get('open');
    if (zuOeffnen) {
      const unterBtn = document.querySelector('.unter-reiter button[data-target="' + CSS.escape(zuOeffnen) + '"]');
      if (unterBtn) unterBtn.click();
    }
  })();

  // Live-Update via JSON-API: aktualisiert Punkt-Noten UND die Notenübersicht oben
  const API_URL = '/teacher/fach/<%= fach.id %>/noten?hj=' + encodeURIComponent('<%= halbjahr %>');
  const FACH_ID_END = '<%= fach.id %>';
  const HJ_END = '<%= halbjahr %>';
  async function refresh() {
    try {
      const r = await fetch(API_URL);
      if (!r.ok) return;
      const data = await r.json();
      data.schueler.forEach(function(s) {
        document.querySelectorAll('.k-note[data-sid="' + s.schueler_id + '"]').forEach(function(cell) {
          const k = s.klausuren.find(function(x) { return x.id === Number(cell.dataset.kid); });
          cell.textContent = (k && k.note !== null) ? k.note.toString().replace('.', ',') : '–';
        });
        document.querySelectorAll('.k-teilnote[data-sid="' + s.schueler_id + '"]').forEach(function(cell) {
          const k = s.klausuren.find(function(x) { return x.id === Number(cell.dataset.kid); });
          const tn = (k && k.teilNoten) ? k.teilNoten[Number(cell.dataset.teil)] : null;
          cell.textContent = (tn !== null && tn !== undefined) ? tn.toString().replace('.', ',') : '–';
        });
        document.querySelectorAll('.u-note[data-sid="' + s.schueler_id + '"]').forEach(function(cell) {
          const u = s.uls.find(function(x) { return x.id === Number(cell.dataset.kid); });
          cell.textContent = (u && u.note !== null) ? u.note.toString().replace('.', ',') : '–';
        });
        document.querySelectorAll('.k-summe[data-sid="' + s.schueler_id + '"]').forEach(function(cell) {
          const k = s.klausuren.find(function(x) { return x.id === Number(cell.dataset.kid); });
          const summe = (k && k.punkte) ? k.punkte.reduce(function(a, b) { return a + (b || 0); }, 0) : 0;
          cell.textContent = summe + ' / ' + cell.dataset.max;
        });
        document.querySelectorAll('.u-summe[data-sid="' + s.schueler_id + '"]').forEach(function(cell) {
          const u = s.uls.find(function(x) { return x.id === Number(cell.dataset.kid); });
          const summe = (u && u.punkte) ? u.punkte.reduce(function(a, b) { return a + (b || 0); }, 0) : 0;
          cell.textContent = summe + ' / ' + cell.dataset.max;
        });
        const tr = document.querySelector('#uebersicht tr[data-schueler="' + s.schueler_id + '"]');
        if (tr) {
          // .muendliche-note/.schriftliche-note können fehlen, wenn diese
          // Spalte serverseitig ausgeblendet ist (siehe zeigeMuendlicheNoteSpalte/
          // zeigeSchriftlicheNoteSpalte oben) -- die Spalte selbst erscheint
          // erst nach einem Neuladen der Seite, siehe Kommentar dort.
          const mn = tr.querySelector('.muendliche-note');
          if (mn) mn.textContent = s.muendlicheNote !== null ? s.muendlicheNote.toString().replace('.', ',') : '–';
          const sn = tr.querySelector('.schriftliche-note');
          if (sn) sn.textContent = s.schriftlicheNote !== null ? s.schriftlicheNote.toString().replace('.', ',') : '–';
          const gc = tr.querySelector('.gesamt-cell');
          gc.textContent = s.gesamt !== null ? s.gesamt.toString().replace('.', ',') : (s.endnote && s.endnote.ntg ? 'ntg' : '–');
          gc.classList.toggle('direkt', Boolean(s.endnote));
          gc.title = s.endnote ? 'Direkt eingetragene Endnote' : '';
          const spaTendenzZelle = tr.querySelector('.spa-tendenz-cell');
          if (spaTendenzZelle) {
            // Tendenznote zu Punkten 0-15 (SPA-Notenskala, siehe src/spa-grade-calc.js)
            const skala = ['6', '5-', '5', '5+', '4-', '4', '4+', '3-', '3', '3+', '2-', '2', '2+', '1-', '1', '1+'];
            spaTendenzZelle.textContent = s.gesamt !== null ? skala[Math.max(0, Math.min(15, Math.round(s.gesamt)))] : '–';
          }
        }
        document.querySelectorAll('.na-summe[data-sid="' + s.schueler_id + '"]').forEach(function(z) { z.textContent = String(s.naAnzahl); });
        const berZelle = document.querySelector('#endnoten-tabelle tr[data-schueler="' + s.schueler_id + '"] .berechnet');
        if (berZelle) berZelle.textContent = s.gesamtBerechnet !== null ? s.gesamtBerechnet.toString().replace('.', ',') : '–';
        const datumsZelle = document.querySelector('.datums-durchschnitt[data-sid="' + s.schueler_id + '"]');
        if (datumsZelle) {
          datumsZelle.textContent = s.datumsDurchschnitt !== null ? s.datumsDurchschnitt.toString().replace('.', ',') : '–';
        }
      });
    } catch (e) { console.warn(e); }
  }
  function debounce(fn, ms) { let t; return function() { clearTimeout(t); t = setTimeout(fn, ms); }; }
  document.querySelectorAll('input.punkt').forEach(function(inp) {
    inp.addEventListener('input', debounce(async function() {
      // URLSearchParams statt FormData: fetch setzt dafür automatisch
      // Content-Type: application/x-www-form-urlencoded, das Einzige, was
      // der Server (@fastify/formbody) versteht. Mit FormData (→
      // multipart/form-data) antwortet der Server mit 415 und die Punkte
      // werden nie gespeichert — genau das führte dazu, dass live weder
      // Note noch Gesamtnote berechnet wurden.
      const body = new URLSearchParams();
      body.append('schueler_id', inp.dataset.sid);
      body.append('aufgabe_idx', inp.dataset.idx);
      body.append('wert', inp.value);
      const url = inp.dataset.kind === 'k'
        ? '/teacher/klausuren/' + inp.dataset.kid + '/punkte'
        : '/teacher/uls/' + inp.dataset.kid + '/punkte';
      await fetch(url, { method: 'POST', body });
      refresh();
    }, 400));
  });
  // Direkte Endnoteneingabe: Tabelle ein-/ausklappen (Zustand je Fach und Halbjahr
  // gemerkt) und beim Verlassen eines Feldes speichern.
  (function() {
    const knopf = document.getElementById('endnoten-toggle');
    const box = document.getElementById('endnoten-direkt');
    if (!knopf || !box) return;
    const KEY = 'endnoten-offen-' + FACH_ID_END + '-' + HJ_END;
    function setze(offen) {
      box.hidden = !offen;
      knopf.setAttribute('aria-expanded', offen ? 'true' : 'false');
      knopf.classList.toggle('aktiv', offen);
      try { sessionStorage.setItem(KEY, offen ? '1' : '0'); } catch (e) { /* ignorieren */ }
    }
    let offen = false;
    try { offen = sessionStorage.getItem(KEY) === '1'; } catch (e) { /* ignorieren */ }
    setze(offen);
    knopf.addEventListener('click', function() { setze(box.hidden); });
    box.querySelectorAll('input.endnote-eingabe').forEach(function(inp) {
      inp.addEventListener('change', async function() {
        const body = new URLSearchParams();
        body.append('schueler_id', inp.dataset.sid);
        body.append('halbjahr', HJ_END);
        body.append('wert', inp.value);
        let d = null;
        try { d = await (await fetch('/teacher/fach/' + FACH_ID_END + '/endnote', { method: 'POST', body: body })).json(); } catch (e) { /* ignorieren */ }
        if (d && d.ok) {
          inp.value = d.ntg ? 'ntg' : (d.note === null ? '' : String(d.note).replace('.', ','));
          inp.classList.remove('speicherfehler'); inp.title = '';
          refresh();
        } else {
          inp.classList.add('speicherfehler');
          inp.title = (d && d.error) || 'Nicht gespeichert.';
        }
      });
    });
  })();

  // Datumstabelle: nur Noten oder "n.a." (nicht anwesend). Beim Tippen wird
  // gespeichert, sobald der Wert eine gültige Zahl oder n.a. ist; beim
  // Verlassen des Feldes (change) wird jede andere Eingabe zu n.a. und das Feld
  // mit dem gespeicherten Wert überschrieben.
  document.querySelectorAll('input.note-datum').forEach(function(inp) {
    const speichern = async function() {
      const body = new URLSearchParams();
      body.append('schueler_id', inp.dataset.sid);
      body.append('wert', inp.value);
      const r = await fetch('/teacher/unterricht/termine/' + inp.dataset.termin + '/note', { method: 'POST', body });
      let d = null;
      try { d = await r.json(); } catch (e) { /* ignorieren */ }
      return d;
    };
    const zeigeWert = function(d) {
      if (!d || !d.ok) return;
      inp.value = d.na ? 'n.a.' : (d.wert === null ? '' : String(d.wert).replace('.', ','));
      inp.classList.toggle('ist-na', Boolean(d.na));
    };
    const istGueltig = function(v) { return v === '' || /^(n\.?a\.?)$/i.test(v) || /^\d+([.,]\d+)?$/.test(v); };
    inp.addEventListener('input', debounce(async function() {
      if (!istGueltig(inp.value.trim())) return; // erst beim Verlassen zu n.a. machen
      await speichern();
      refresh();
    }, 400));
    inp.addEventListener('change', async function() {
      zeigeWert(await speichern());
      refresh();
    });
  });

  // Gewichtung/Datum/Max-Punkte bei Klausuren und Zusatzleistungen: kein
  // eigener Speichern-Button mehr, stattdessen automatisches Absenden des
  // ganzen (kleinen) Formulars -- per echtem form.submit() samt Seiten-
  // Reload, wie beim Auto-Sync-Haken oben, statt per fetch(): eine Änderung
  // der Aufgaben-Anzahl muss ohnehin die Notentafel-Spalten neu rendern,
  // also lohnt sich hier kein AJAX-Sonderweg. Mit Verzögerung (.auto-speichern),
  // damit z. B. das Tippen einer zweistelligen Gewichtung nicht nach der
  // ersten Ziffer schon abschickt; Datum (.auto-speichern-sofort) speichert
  // dagegen sofort bei "change", weil ein Datepicker ohnehin erst bei
  // vollständiger Auswahl feuert.
  //
  // Scroll-Position und fokussiertes Feld werden vor dem Absenden gemerkt und
  // nach dem Neuladen wiederhergestellt -- sonst springt die Seite bei jeder
  // Änderung (Max-Punkte, Anzahl Aufgaben, Teile, Gewichtung) nach oben und
  // man muss das Feld erst wieder suchen.
  const FOKUS_KEY = 'noteneingabe-fokus';
  function merkeFokus(form, feld) {
    try {
      sessionStorage.setItem(FOKUS_KEY, JSON.stringify({
        pfad: location.pathname + location.search, y: window.scrollY,
        action: form ? form.getAttribute('action') : null, name: feld ? feld.name : null,
      }));
    } catch (e) { /* z. B. privater Modus */ }
  }
  // Merkt sich das gerade aktive Feld (falls es zu einem Formular gehört).
  function merkeAktivesFeld() {
    const aktiv = document.activeElement;
    const form = aktiv && aktiv.form;
    merkeFokus(form || null, form ? aktiv : null);
  }
  function stelleFokusWiederHer() {
    let gemerkt = null;
    try {
      gemerkt = JSON.parse(sessionStorage.getItem(FOKUS_KEY) || 'null');
      sessionStorage.removeItem(FOKUS_KEY);
    } catch (e) { return; }
    if (!gemerkt || gemerkt.pfad.split('?')[0] !== location.pathname) return;
    window.scrollTo(0, gemerkt.y);
    if (!gemerkt.name) return;
    const forms = Array.from(document.querySelectorAll('form')).filter(function(f) { return f.getAttribute('action') === gemerkt.action; });
    for (const f of forms) {
      // form.elements enthält auch Felder außerhalb des <form>, die per form="..." zugeordnet sind (Max-Punkte in der Tabelle)
      const feld = Array.from(f.elements).find(function(el) { return el.name === gemerkt.name && el.offsetParent !== null; });
      if (feld && feld.offsetParent !== null) {
        feld.focus({ preventScroll: true });
        // Cursor ans Ende: number-Felder kennen keine setSelectionRange-Auswahl,
        // das erneute Zuweisen des Werts setzt die Eingabemarke aber ans Ende.
        // Sonst würden langsam getippte Ziffern in falscher Reihenfolge landen.
        const v = feld.value;
        feld.value = '';
        feld.value = v;
        if (typeof feld.setSelectionRange === 'function') {
          try { feld.setSelectionRange(v.length, v.length); } catch (e) { /* number-Felder */ }
        }
        return;
      }
    }
  }
  function inputsVon(form) { return Array.from(form.elements).filter(function(el) { return el.tagName === 'INPUT'; }); }
  document.querySelectorAll('form.auto-speichern').forEach(function(form) {
    const absenden = debounce(function() { merkeAktivesFeld(); form.submit(); }, 800);
    inputsVon(form).forEach(function(feld) {
      if (feld.name === 'anzahl_aufgaben' || feld.name === 'anzahl_teile') {
        // Aufgaben- und Teilezahl formen die Teile um: Zwischenstände beim Tippen
        // ("1" auf dem Weg zu "12") würden sie zerstören. Deshalb erst beim
        // Verlassen des Feldes bzw. mit Enter übernehmen.
        let abgeschickt = false;
        const uebernehmen = function() {
          if (abgeschickt) return;
          abgeschickt = true;
          setTimeout(function() { merkeAktivesFeld(); form.submit(); }, 0);
        };
        feld.addEventListener('change', uebernehmen);
        feld.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') { e.preventDefault(); uebernehmen(); }
        });
        return;
      }
      feld.addEventListener('input', absenden);
    });
  });
  document.querySelectorAll('form.auto-speichern-sofort').forEach(function(form) {
    inputsVon(form).forEach(function(feld) {
      feld.addEventListener('change', function() { setTimeout(function() { merkeAktivesFeld(); form.submit(); }, 0); });
    });
  });
  // Normale Absende-Buttons (z. B. "Teile speichern") bleiben ebenfalls an der Stelle.
  document.querySelectorAll('#panel-klausuren form, #panel-uls form').forEach(function(form) {
    form.addEventListener('submit', function() { merkeFokus(form, null); });
  });
  stelleFokusWiederHer();

  // Notizzettel in der Datumstabelle: Popup mit Verlauf + neuer Notiz (AJAX,
  // die Seite wird nicht neu geladen).
  (function() {
    const dlg = document.getElementById('unterricht-notiz-dialog');
    if (!dlg) return;
    const liste = document.getElementById('unterricht-notiz-liste');
    const leer = document.getElementById('unterricht-notiz-leer');
    const text = document.getElementById('unterricht-notiz-text');
    const FACH = '<%= fach.id %>';
    const HJ = '<%= halbjahr %>';
    let aktuell = null; // { sid, btn }
    const url = function(sid) { return '/teacher/fach/' + FACH + '/unterricht/notizen/' + sid + '?hj=' + encodeURIComponent(HJ); };
    function zeige(notizen) {
      liste.textContent = '';
      notizen.forEach(function(n) {
        const li = document.createElement('li');
        const t = document.createElement('div'); t.className = 'notiz-text'; t.textContent = n.text;
        const m = document.createElement('div'); m.className = 'notiz-meta hint'; m.textContent = n.von + ' · ' + n.am + ' ';
        if (n.loeschbar) {
          const x = document.createElement('button');
          x.type = 'button'; x.className = 'danger'; x.textContent = '🗑'; x.title = 'Notiz löschen';
          x.addEventListener('click', function() {
            if (!confirm('Notiz löschen?')) return;
            fetch('/teacher/unterricht/notizen/' + n.id + '/loeschen', { method: 'POST' })
              .then(function(r) { return r.json(); }).then(function(d) { if (d.ok) zeige(d.notizen); });
          });
          m.appendChild(x);
        }
        li.appendChild(t); li.appendChild(m); liste.appendChild(li);
      });
      leer.hidden = notizen.length > 0;
      if (aktuell) {
        const b = aktuell.btn;
        b.classList.toggle('hat-notiz', notizen.length > 0);
        b.dataset.anzahl = String(notizen.length);
        b.textContent = '📝';
        if (notizen.length) { const sup = document.createElement('sup'); sup.textContent = String(notizen.length); b.appendChild(sup); }
        b.title = notizen.length ? notizen.length + ' Notiz(en) zum Unterricht' : 'Notiz zum Unterricht';
      }
    }
    document.querySelectorAll('button.notiz-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        aktuell = { sid: btn.dataset.sid, btn: btn };
        document.getElementById('unterricht-notiz-name').textContent = btn.dataset.name;
        text.value = '';
        liste.textContent = '';
        leer.hidden = true;
        dlg.showModal();
        fetch(url(aktuell.sid)).then(function(r) { return r.json(); }).then(function(d) { if (d.ok) zeige(d.notizen); });
        text.focus();
      });
    });
    function speichern() {
      const wert = text.value.trim();
      if (!wert || !aktuell) return;
      const body = new URLSearchParams({ text: wert, halbjahr: HJ });
      fetch(url(aktuell.sid), { method: 'POST', headers: { 'content-type': 'application/x-www-form-urlencoded' }, body: body })
        .then(function(r) { return r.json(); })
        .then(function(d) { if (d.ok) { text.value = ''; zeige(d.notizen); text.focus(); } });
    }
    document.getElementById('unterricht-notiz-speichern').addEventListener('click', speichern);
    text.addEventListener('keydown', function(e) { if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); speichern(); } });
    document.getElementById('unterricht-notiz-schliessen').addEventListener('click', function() { dlg.close(); });
  })();

  // Pfeiltasten hoch/runter und Enter springen in derselben Spalte (also
  // z. B. derselben Aufgabe/demselben Termin) zur vorherigen/nächsten
  // Person, statt bei Pfeiltasten den Zahlenwert eines <input type="number">
  // hoch-/runterzuzählen (Standardverhalten des Browsers, wird deshalb
  // bewusst unterdrückt) bzw. bei Enter ein umgebendes <form> abzuschicken.
  function aktiviereSpaltenNavigation(selector, gruppierungsAttribut) {
    document.querySelectorAll(selector).forEach(function(inp) {
      inp.addEventListener('keydown', function(e) {
        if (e.key !== 'Enter' && e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const tabelle = inp.closest('table');
        if (!tabelle) return;
        let spalte = Array.from(tabelle.querySelectorAll(selector));
        if (gruppierungsAttribut) {
          const wert = inp.dataset[gruppierungsAttribut];
          spalte = spalte.filter(function(el) { return el.dataset[gruppierungsAttribut] === wert; });
        }
        const idx = spalte.indexOf(inp);
        const ziel = e.key === 'ArrowUp' ? spalte[idx - 1] : spalte[idx + 1];
        if (ziel) { ziel.focus(); ziel.select(); }
      });
    });
  }
  aktiviereSpaltenNavigation('input.punkt', 'idx');
  aktiviereSpaltenNavigation('input.note-datum', 'termin');
  aktiviereSpaltenNavigation('input.note-historisch', null);

  // Teilnehmer/innen-Suche: Ergebnisse werden bewusst per DOM-API statt
  // innerHTML eingefügt (Nachname/Vorname/Klassenname kommen aus der
  // Datenbank und sind nicht vertrauenswürdig genug für unmaskiertes HTML).
  //
  // Hinzufügen läuft per fetch() statt als normaler Form-POST: ein echter
  // Seiten-Reload hätte die Trefferliste UND die Eingabe im Suchfeld
  // gelöscht -- bei einer ganzen Klasse musste man dann nach jeder einzelnen
  // Person neu "10B" eintippen. Jetzt bleibt die Liste stehen, nur der
  // angeklickte Treffer wird als "✓ hinzugefügt" markiert, damit mehrere
  // Personen nacheinander angeklickt werden können.
  const teilnehmerSucheEingabe = document.getElementById('teilnehmer-suche-eingabe');
  if (teilnehmerSucheEingabe) {
    const ergebnisListe = document.getElementById('teilnehmer-suche-ergebnisse');
    const teilnehmerTabelle = document.getElementById('teilnehmer-tabelle-body');

    function fuegeTeilnehmerZeileHinzu(t) {
      const tr = document.createElement('tr');
      const nameZelle = document.createElement('td');
      nameZelle.className = 'name';
      nameZelle.textContent = t.nachname + ', ' + t.vorname;
      const klasseZelle = document.createElement('td');
      klasseZelle.textContent = t.klasse_name;
      if (!t.fremd) {
        const hinweis = document.createElement('small');
        hinweis.className = 'hint';
        hinweis.textContent = ' (Heimat-Klasse)';
        klasseZelle.appendChild(hinweis);
      }
      const aktionZelle = document.createElement('td');
      const form = document.createElement('form');
      form.method = 'post';
      form.action = '/teacher/fach/<%= fach.id %>/teilnehmer/entfernen';
      form.className = 'inline';
      form.addEventListener('submit', function(e) { if (!confirm('Aus diesem Fach entfernen?')) e.preventDefault(); });
      const sid = document.createElement('input');
      sid.type = 'hidden'; sid.name = 'schueler_id'; sid.value = t.id;
      const hj = document.createElement('input');
      hj.type = 'hidden'; hj.name = 'halbjahr'; hj.value = '<%= halbjahr %>';
      const delBtn = document.createElement('button');
      delBtn.type = 'submit'; delBtn.className = 'danger'; delBtn.textContent = '🗑';
      form.appendChild(sid); form.appendChild(hj); form.appendChild(delBtn);
      aktionZelle.appendChild(form);
      tr.appendChild(nameZelle); tr.appendChild(klasseZelle); tr.appendChild(aktionZelle);
      teilnehmerTabelle.appendChild(tr);
    }

    teilnehmerSucheEingabe.addEventListener('input', debounce(async function() {
      const q = teilnehmerSucheEingabe.value.trim();
      ergebnisListe.textContent = '';
      if (!q) return;
      const r = await fetch('/teacher/fach/<%= fach.id %>/teilnehmer/suche?q=' + encodeURIComponent(q));
      if (!r.ok) return;
      const data = await r.json();
      if (!data.treffer.length) {
        const li = document.createElement('li');
        li.textContent = 'Keine Treffer.';
        ergebnisListe.appendChild(li);
        return;
      }
      data.treffer.forEach(function(t) {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = '+ ' + t.nachname + ', ' + t.vorname + ' (' + t.klasse_name + ')'
          + (t.notenschluessel !== '<%= fach.notenschluessel %>' ? ' — anderer Notenschlüssel' : '');
        btn.addEventListener('click', async function() {
          btn.disabled = true;
          const body = new URLSearchParams();
          body.append('schueler_id', t.id);
          body.append('halbjahr', '<%= halbjahr %>');
          const res = await fetch('/teacher/fach/<%= fach.id %>/teilnehmer/hinzufuegen', {
            method: 'POST', headers: { Accept: 'application/json' }, body,
          });
          const resData = await res.json().catch(function() { return {}; });
          if (res.ok && resData.ok) {
            btn.textContent = '✓ ' + t.nachname + ', ' + t.vorname + ' hinzugefügt';
            fuegeTeilnehmerZeileHinzu(resData.teilnehmer);
          } else {
            btn.disabled = false;
            let fehler = li.querySelector('.err');
            if (!fehler) {
              fehler = document.createElement('div');
              fehler.className = 'err';
              li.appendChild(fehler);
            }
            fehler.textContent = resData.error || 'Hinzufügen fehlgeschlagen.';
          }
        });
        li.appendChild(btn);
        ergebnisListe.appendChild(li);
      });
    }, 300));
  }
</script>

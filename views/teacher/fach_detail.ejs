<h1>
  <%= fach.name %><% if (!fach.ist_kurs) { %> – <%= fach.klasse_name %><% } %>
  <small>(<%= fach.schuljahr_bezeichnung %>, <%= fach.notenschluessel %><% if (fach.ist_kurs) { %>, Kurs<% } %>)</small>
</h1>
<p class="kopf-aktionen">
  <a class="btn" href="/teacher">← Meine Noteneingabe</a>
  <% if (spaLeistung) { %>
    <a class="btn" href="/teacher/fach/<%= fach.id %>?hj=<%= spaLeistung.hjNr %>">← SPA-Eingabemaske (Punkte)</a>
  <% } %>
  <% if (!fach.ist_kurs) { %>
    <a class="btn" href="/teacher/klassen/<%= fach.klasse_id %>/sitzplan">🪑 Sitzplan</a>
  <% } %>
  <% if (schueler.length) { %>
    <a class="btn" href="/teacher/fach/<%= fach.id %>/besprechung/<%= schueler[0].id %>?hj=<%= encodeURIComponent(halbjahr) %>">🗣 Notenbesprechung starten</a>
  <% } %>
</p>

<% if (spaLeistung) { %>
  <div class="card">
    <p class="hint">
      Klausuren und Unterrichtsleistung werden wie bei IHK abgehandelt, aber in <strong>Punkten (0-15)</strong>
      bewertet: der Punkteschlüssel der Klasse übersetzt den Prozentwert in Punkte, die Tendenznote
      (1+ ... 6) wird daraus berechnet. Die Leistungspunkte ersetzen im <%= halbjahr %> den Punktwert dieses
      Fachs -- ein von Hand eingetragener Wert in der SPA-Eingabemaske hat Vorrang. Nur das Zeugnis folgt
      danach dem SPA-Bewertungssystem.
    </p>
    <% if (spaLeistung.schemaHj && spaLeistung.schemaHj.halbjahrModus === 'komponenten_gewichtet') { %>
      <form method="post" action="/teacher/fach/<%= fach.id %>/spa/leistung-ziel" class="inline">
        <input type="hidden" name="halbjahr" value="<%= spaLeistung.hjNr %>">
        <label>Leistungsnote fließt in Komponente
          <select name="komponente" <%= spaLeistung.darfBearbeiten ? '' : 'disabled' %>>
            <option value="">– keine (nur von Hand eintragen) –</option>
            <% spaLeistung.schemaHj.komponenten.forEach(function(k) { %>
              <option value="<%= k.schluessel %>" <%= spaLeistung.ziel === k.schluessel ? 'selected' : '' %>><%= spaLeistung.komponentenNamen[k.schluessel] || k.schluessel %></option>
            <% }); %>
          </select>
        </label>
        <% if (spaLeistung.darfBearbeiten) { %><button type="submit">Übernehmen</button><% } %>
      </form>
    <% } else { %>
      <p class="hint">Dieses Fach hat im <%= halbjahr %> einen einzelnen Punktwert -- die Leistungsnote ersetzt ihn.</p>
    <% } %>
  </div>
<% } %>

<% if (!fach.nur_historisch) { %>
  <div class="hj-tabs">
    <% HALBJAHRE.forEach(function(h) { %>
      <a class="hj-tab <%= h === halbjahr ? 'active' : '' %>" href="?hj=<%= encodeURIComponent(h) %>&tab=uebersicht" title="Schuljahr <%= (typeof HALBJAHR_SCHULJAHR !== 'undefined' && HALBJAHR_SCHULJAHR[h]) || '' %>"><%= h %></a>
    <% }); %>
  </div>
<% } %>

<div class="reiter" data-storage-key="noteneingabe-reiter-<%= fach.id %>">
  <button type="button" class="<%= fach.nur_historisch ? '' : 'active' %>" data-target="panel-uebersicht">Notenübersicht</button>
  <div class="reiter-mehr-wrapper">
    <button type="button" class="reiter-mehr-toggle <%= fach.nur_historisch ? 'active' : '' %>" aria-haspopup="true" aria-expanded="false">⋮ Mehr</button>
    <div class="reiter-mehr-menu">
      <button type="button" data-target="panel-uls">Unterrichtsleistung</button>
      <button type="button" data-target="panel-klausuren">Klausuren</button>
      <% if (!spaLeistung) { %>
        <button type="button" data-target="panel-manuell">Manuelle Noten</button>
        <button type="button" class="<%= fach.nur_historisch ? 'active' : '' %>" data-target="panel-historie">Historische Halbjahre</button>
        <button type="button" data-target="panel-teilnehmer">Teilnehmer/innen</button>
        <button type="button" data-target="panel-sync">Synchronisation</button>
        <% if (darfFachAbschliessen) { %>
          <button type="button" data-target="panel-abschluss">Fach abschließen</button>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<%
  // Manuelle Noten (Tags) und die per Datumstabelle/Klausur berechneten
  // Noten sind zwei alternative Wege, mündlich/schriftlich zu benoten --
  // die jeweils andere Spalte bleibt sonst leer und bläht die Übersicht
  // unnötig auf. Solange NUR der eine Weg benutzt wird, bleibt die Spalte
  // des anderen ausgeblendet (wird bei neuen Einträgen erst nach einem
  // Neuladen der Seite berücksichtigt, siehe unten bei refresh()).
  var NL = spaLeistung ? 'Punkte' : 'Note'; // SPA bewertet Klausuren/UL in Punkten (0-15)
  var hatManuelleMuendlich = rows.some(function(r) { return r.muendlich.length > 0; });
  var hatManuelleSchriftlich = rows.some(function(r) { return r.schriftlich.length > 0; });
  var hatUlEintraege = rows.some(function(r) {
    return r.terminNoten.some(function(t) { return t.wert !== null || t.na; }) || r.uls.some(function(u) { return u.punkte !== null; });
  });
  var hatKlausurEintraege = rows.some(function(r) { return r.klausuren.some(function(k) { return k.punkte !== null; }); });
  var zeigeMuendlicheNoteSpalte = !(hatManuelleMuendlich && !hatUlEintraege);
  var zeigeSchriftlicheNoteSpalte = !(hatManuelleSchriftlich && !hatKlausurEintraege);
  var zeigeNaSpalte = termine.length > 0;
  var sichtbareSpalten = 2 + (zeigeNaSpalte ? 1 : 0) + (hatManuelleMuendlich ? 1 : 0) + (hatManuelleSchriftlich ? 1 : 0)
    + (zeigeMuendlicheNoteSpalte ? 1 : 0) + (zeigeSchriftlicheNoteSpalte ? 1 : 0) + (spaLeistung ? 1 : 0) + (fach.abgeschlossen ? 1 : 0);
%>
<div id="panel-uebersicht" class="reiter-panel<%= fach.nur_historisch ? '' : ' active' %>">
  <h2>Notenübersicht</h2>
  <% if (!spaLeistung) { %>
    <p class="kopf-aktionen">
      <button type="button" id="endnoten-toggle" aria-expanded="false" aria-controls="endnoten-direkt">✏️ Direkte Endnoteneingabe</button>
    </p>
    <div id="endnoten-direkt" class="card" hidden>
      <p class="hint">
        Endnote für das <strong><%= halbjahr %></strong> direkt eintragen. Sie ersetzt die aus Klausuren und
        Unterrichtsleistung berechnete Note. Leer lassen: die berechnete Note gilt. „ntg" = nicht teilgenommen.
        Wird beim Verlassen des Feldes gespeichert; bei gesperrten Personen (Notenkonferenz) ist die Eingabe
        erst nach dem Entsperren durch die Klassenleitung möglich.
      </p>
      <table class="data" id="endnoten-tabelle">
        <thead><tr><th>Schüler/in</th><th title="Aus Klausuren und Unterrichtsleistung berechnet">Berechnet</th><th>Endnote (Direkteingabe)</th></tr></thead>
        <tbody>
          <% rows.forEach(function(r) {
               var gesperrtEn = Boolean(sperren.get(r.schueler_id));
               var en = r.endnote; %>
            <tr data-schueler="<%= r.schueler_id %>">
              <td class="name"><%= r.nachname %>, <%= r.vorname %><% if (gesperrtEn) { %> 🔒<% } %></td>
              <td class="note-cell berechnet"><%= r.gesamtBerechnet === null ? '–' : formatNote(r.gesamtBerechnet) %></td>
              <td>
                <input type="text" inputmode="decimal" autocomplete="off" class="endnote-eingabe" data-sid="<%= r.schueler_id %>"
                  value="<%= en ? (en.ntg ? 'ntg' : String(en.note).replace('.', ',')) : '' %>" placeholder="–"
                  title="<%= fach.notenschluessel === 'IHK' ? 'Note 1 bis 6' : 'Punkte 0 bis 15' %>, ntg oder leer" <%= gesperrtEn ? 'disabled' : '' %>>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
  <table class="data" id="uebersicht">
    <thead>
      <tr>
        <th>Schüler/in</th>
        <% if (hatManuelleMuendlich) { %><th>Mündliche Noten</th><% } %>
        <% if (hatManuelleSchriftlich) { %><th>Schriftliche Noten</th><% } %>
        <% if (zeigeMuendlicheNoteSpalte) { %><th>Mündliche <%= NL %></th><% } %>
        <% if (zeigeSchriftlicheNoteSpalte) { %><th>Schriftliche <%= NL %></th><% } %>
        <th>Gesamt<%= spaLeistung ? 'punkte' : 'note' %></th>
        <% if (spaLeistung) { %><th title="Tendenznote aus den Leistungspunkten (SPA-Notenskala)">Tendenz</th><% } %>
        <% if (zeigeNaSpalte) { %><th title="Summe der Termine mit n.a. (nicht anwesend) in der Datumstabelle">n.a.</th><% } %>
        <% if (fach.abgeschlossen) { %><th>Abschlussnote</th><% } %>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function(r) {
           var sperre = sperren.get(r.schueler_id); %>
        <tr data-schueler="<%= r.schueler_id %>">
          <td class="name">
            <%= r.nachname %>, <%= r.vorname %>
            <% if (r.herkunftKlasse) { %><small class="hint">(<%= r.herkunftKlasse %>)</small><% } %>
            <% if (sperre) { %><span title="Noten für dieses Halbjahr gesperrt (Notenkonferenz)">🔒</span><% } %>
          </td>
          <% if (hatManuelleMuendlich) { %>
          <td class="manuell-muendlich">
            <% r.muendlich.forEach(function(n) { %>
              <% if (sperre) { %>
                <span class="tag" title="gesperrt"><%= Number(n.wert).toString().replace('.', ',') %></span>
              <% } else { %>
                <form method="post" action="/teacher/noten/<%= n.id %>/loeschen" class="inline">
                  <button type="submit" class="tag" title="löschen"><%= Number(n.wert).toString().replace('.', ',') %></button>
                </form>
              <% } %>
            <% }); %>
          </td>
          <% } %>
          <% if (hatManuelleSchriftlich) { %>
          <td class="manuell-schriftlich">
            <% r.schriftlich.forEach(function(n) { %>
              <% if (sperre) { %>
                <span class="tag" title="gesperrt"><%= Number(n.wert).toString().replace('.', ',') %></span>
              <% } else { %>
                <form method="post" action="/teacher/noten/<%= n.id %>/loeschen" class="inline">
                  <button type="submit" class="tag" title="löschen"><%= Number(n.wert).toString().replace('.', ',') %></button>
                </form>
              <% } %>
            <% }); %>
          </td>
          <% } %>
          <% if (zeigeMuendlicheNoteSpalte) { %><td class="note-cell muendliche-note"><%= r.muendlicheNote === null ? '–' : formatNote(r.muendlicheNote) %></td><% } %>
          <% if (zeigeSchriftlicheNoteSpalte) { %><td class="note-cell schriftliche-note"><%= r.schriftlicheNote === null ? '–' : formatNote(r.schriftlicheNote) %></td><% } %>
          <td class="gesamt-cell<%= r.endnote ? ' direkt' : '' %>"<% if (r.endnote) { %> title="Direkt eingetragene Endnote"<% } %>><%= r.gesamt === null ? (r.endnote && r.endnote.ntg ? 'ntg' : '–') : formatNote(r.gesamt) %></td>
          <% if (spaLeistung) { %><td class="note-cell spa-tendenz-cell"><%= r.gesamt === null ? '–' : spaTendenz(r.gesamt) %></td><% } %>
          <% if (zeigeNaSpalte) { %><td class="note-cell na-summe" data-sid="<%= r.schueler_id %>"><%= r.naAnzahl %></td><% } %>
          <% if (fach.abgeschlossen) { %>
            <td class="note-cell"><% var an = abschlussnoten.get(r.schueler_id); %><%= (an === null || an === undefined) ? '–' : formatNote(an) %></td>
          <% } %>
        </tr>
        <% if (sperre && !sperre.aufhebung_angefragt) { %>
          <tr>
            <td colspan="<%= sichtbareSpalten %>">
              <form method="post" action="/teacher/fach/<%= fach.id %>/sperre/<%= r.schueler_id %>/anfragen" class="inline">
                <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
                <input type="text" name="grund" placeholder="Grund (optional)" size="30">
                <button type="submit">🔓 Entsperrung anfragen</button>
              </form>
            </td>
          </tr>
        <% } else if (sperre) { %>
          <tr><td colspan="<%= sichtbareSpalten %>"><small class="hint">⏳ Entsperrung bereits angefragt.</small></td></tr>
        <% } %>
      <% }); %>
    </tbody>
  </table>
</div>

<% if (!spaLeistung) { %>
<div id="panel-manuell" class="reiter-panel card">
  <h2>Manuelle Noten</h2>
  <form method="post" action="/teacher/fach/<%= fach.id %>/noten/hinzufuegen" class="inline">
    <select name="schueler_id" required>
      <% schueler.filter(function(s) { return !sperren.get(s.id); }).forEach(function(s) { %>
        <option value="<%= s.id %>"><%= s.nachname %>, <%= s.vorname %></option>
      <% }); %>
    </select>
    <select name="typ" required>
      <option value="schriftlich">Schriftlich</option>
    </select>
    <input type="number" name="wert" step="0.1" min="<%= fach.notenschluessel === 'BG' ? 0 : 1 %>" max="<%= fach.notenschluessel === 'BG' ? 15 : 6 %>" required>
    <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
    <button type="submit">+ Note</button>
  </form>
  <p class="hint">Für mündliche Noten die Datumstabelle im Reiter „Unterrichtsleistung" nutzen — die zählt (anders als diese Notiz hier) direkt in die Berechnung.</p>
</div>

<div id="panel-historie" class="reiter-panel card<%= fach.nur_historisch ? ' active' : '' %>">
  <h2>Historische Halbjahre <small>(Noten von vor Einführung der App)</small></h2>
  <% if (!historischeHalbjahre.length) { %>
    <p class="hint">Noch keine historischen Halbjahre hinterlegt.</p>
  <% } %>
  <% historischeHalbjahre.forEach(function(hh) { %>
    <details class="card" open>
      <summary><%= hh.bezeichnung %>
      <% if (!hh.darfBearbeiten) { %> <small class="hint" title="Von der Fachlehrkraft angelegt -- nur sie kann die Noten eintragen">🔒 nur Ansicht</small><% } %>
      </summary>
      <% if (darfHistorieLoeschen) { %>
        <form method="post" action="/teacher/historie/<%= hh.id %>/loeschen" class="inline right" onsubmit="return confirm('Historisches Halbjahr entfernen?')">
          <button type="submit" class="danger">🗑</button>
        </form>
      <% } %>
      <% if (hh.darfBearbeiten) { %>
        <form method="post" action="/teacher/historie/<%= hh.id %>/speichern">
          <p class="hint">Note eintragen oder <code>ntg</code> für „nicht teilgenommen".</p>
          <table class="data">
            <thead><tr><th>Schüler/in</th><th>Note</th></tr></thead>
            <tbody>
              <% schuelerHistorie.forEach(function(s) { %>
                <tr>
                  <td class="name"><%= s.nachname %>, <%= s.vorname %></td>
                  <td>
                    <input type="text" name="note_<%= s.id %>" class="note-historisch" size="4"
                           title="Note (<%= fach.notenschluessel === 'BG' ? '0-15' : '1-6' %>) oder ntg"
                           value="<%= hh.noten.get(s.id) === undefined ? '' : hh.noten.get(s.id) %>">
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          <button type="submit">💾 Speichern</button>
        </form>
      <% } else { %>
        <table class="data">
          <thead><tr><th>Schüler/in</th><th>Note</th></tr></thead>
          <tbody>
            <% schuelerHistorie.forEach(function(s) { %>
              <tr>
                <td class="name"><%= s.nachname %>, <%= s.vorname %></td>
                <td><%= hh.noten.get(s.id) === undefined ? '–' : hh.noten.get(s.id) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </details>
  <% }); %>
  <% if (darfHistorieAnlegen) { %>
    <form method="post" action="/teacher/fach/<%= fach.id %>/historie/neu" class="inline">
      <input type="text" name="bezeichnung" placeholder="z. B. 1. Halbjahr 2022/23" required>
      <button type="submit">+ Vergangenes Halbjahr hinzufügen</button>
    </form>
  <% } %>
</div>

<% } %>

<div id="panel-klausuren" class="reiter-panel">
  <div class="reiter unter-reiter card" data-storage-key="noteneingabe-subreiter-klausuren-<%= fach.id %>">
    <% klausuren.forEach(function(k, i) { %>
      <button type="button" class="<%= i === 0 ? 'active' : '' %>" data-target="klausur-panel-<%= k.id %>"><%= k.name %> <small>(<%= k.gewichtung %>%<%= k.datum ? ', ' + k.datum.split('-').reverse().join('.') : '' %>)</small></button>
    <% }); %>
    <button type="button" class="<%= klausuren.length === 0 ? 'active' : '' %>" data-target="klausur-panel-anlegen" title="Klausur anlegen" aria-label="Klausur anlegen">+</button>
  </div>

  <% klausuren.forEach(function(k, i) { %>
    <% var maxArr = JSON.parse(k.max_punkte_pro_aufgabe); %>
    <div id="klausur-panel-<%= k.id %>" class="reiter-panel unter-panel card <%= i === 0 ? 'active' : '' %>">
      <form method="post" action="/teacher/klausuren/<%= k.id %>/loeschen" class="inline right" onsubmit="return confirm('Klausur löschen?')">
        <button type="submit" class="danger">🗑</button>
      </form>
      <p class="hint">Änderungen werden automatisch gespeichert.</p>
      <div class="einstellungen-reihe">
        <form method="post" action="/teacher/klausuren/<%= k.id %>/gewichtung" class="einstellungen auto-speichern">
          <label class="feld">Gewichtung
            <span class="feld-mit-einheit"><input type="number" name="gewichtung" value="<%= k.gewichtung %>" min="0" max="100" step="0.1">%</span>
          </label>
          <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
        </form>
        <form method="post" action="/teacher/klausuren/<%= k.id %>/datum" class="einstellungen auto-speichern-sofort">
          <label class="feld">Datum
            <input type="date" name="datum" value="<%= k.datum || '' %>">
          </label>
        </form>
        <% var anzTeile = k.teileInfo ? k.teileInfo.teile.length : 1; %>
        <form method="post" action="/teacher/klausuren/<%= k.id %>/teile-anzahl" class="einstellungen auto-speichern">
          <label class="feld">Anzahl Teile
            <input type="number" name="anzahl_teile" value="<%= anzTeile %>" min="1" max="6">
          </label>
        </form>
      </div>
      <p class="hint">Anzahl Teile: 1 = normale Klausur. Bei mehreren Teilen bekommt jeder Teil eine eigene Note, die Gesamtnote wird prozentual aus den Teilnoten berechnet.</p>
      <% if (k.teileInfo) { %>
        <form method="post" action="/teacher/klausuren/<%= k.id %>/teile" class="auto-speichern-sofort" autocomplete="off">
          <table class="data">
            <thead><tr><th>Teil</th><th>Name</th><th>Aufgaben</th><th>Gewichtung %</th><th>Bestimmt beste Note</th></tr></thead>
            <tbody>
              <% k.teileInfo.teile.forEach(function(teil, ti) { %>
                <tr>
                  <td><%= ti + 1 %></td>
                  <td><input type="text" name="teil_name" value="<%= teil.name %>" placeholder="Teil <%= ti + 1 %>" maxlength="60"></td>
                  <td><input type="number" name="teil_aufgaben" value="<%= teil.aufgaben %>" min="1" max="20"></td>
                  <td><input type="number" name="teil_gewichtung" value="<%= teil.gewichtung %>" min="0" max="100" step="0.1"></td>
                  <td><input type="radio" name="bestimmend" value="<%= ti %>" <%= k.teileInfo.bestimmend === ti ? 'checked' : '' %> aria-label="Teil <%= ti + 1 %> bestimmt die beste Note"></td>
                </tr>
              <% }); %>
              <tr>
                <td colspan="4"><small class="hint">Kein Teil begrenzt die Gesamtnote. Bestimmt ein Teil die <strong>beste</strong> erreichbare Note, können die anderen Teile die Gesamtnote nicht darüber hinaus verbessern, wohl aber verschlechtern.</small></td>
                <td><input type="radio" name="bestimmend" value="" <%= k.teileInfo.bestimmend === null ? 'checked' : '' %> aria-label="Kein Teil bestimmt die beste Note"></td>
              </tr>
            </tbody>
          </table>
        </form>
      <% } %>
      <form method="post" action="/teacher/klausuren/<%= k.id %>/maxpunkte" id="maxpunkte-form-k<%= k.id %>" class="einstellungen auto-speichern">
        <% if (k.teileInfo) { %>
          <span class="hint">Aufgaben gesamt: <strong><%= maxArr.length %></strong> (Summe der Teile)</span>
        <% } else { %>
          <label class="feld">Anzahl Aufgaben
            <input type="number" name="anzahl_aufgaben" value="<%= maxArr.length %>" min="1" max="20">
          </label>
        <% } %>
        <span class="hint">Die maximal erreichbaren Punkte je Aufgabe stehen direkt über den Spalten der Tabelle.</span>
        <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
      </form>
      <% var maxSumme = maxArr.reduce(function(a, b) { return a + b; }, 0); %>
      <table class="tafel">
        <%
          // Aufgaben-Index -> Teil (nur bei mehrteiliger Klausur): ein Teil-Block endet mit seiner Teilnote.
          var teilEnde = {};
          if (k.teileInfo) { var pos = 0; k.teileInfo.teile.forEach(function(t, ti) { pos += t.aufgaben; teilEnde[pos - 1] = ti; }); }
        %>
        <thead>
          <% if (k.teileInfo) { %>
            <tr>
              <th rowspan="2">Schüler/in</th>
              <% k.teileInfo.teile.forEach(function(t, ti) { %>
                <th colspan="<%= t.aufgaben + 1 %>" class="teil-head"><%= t.name %> <small>(<%= t.gewichtung %>%)</small><%= k.teileInfo.bestimmend === ti ? ' ★' : '' %></th>
              <% }); %>
              <th rowspan="2">Punkte gesamt</th>
              <th rowspan="2" class="note-col">Gesamt<%= spaLeistung ? 'punkte' : 'note' %></th>
            </tr>
            <tr>
              <% maxArr.forEach(function(_, i) { %>
                <th class="aufgabe-head">A<%= i+1 %></th>
                <% if (teilEnde[i] !== undefined) { %><th class="note-col"><%= NL %></th><% } %>
              <% }); %>
            </tr>
          <% } else { %>
            <tr>
              <th>Schüler/in</th>
              <% maxArr.forEach(function(_, i) { %><th class="aufgabe-head">A<%= i+1 %></th><% }); %>
              <th>Punkte gesamt</th>
              <th class="note-col"><%= NL %></th>
            </tr>
          <% } %>
          <tr class="maxpunkte-zeile">
            <th class="aufgabe-head">▼ Max. Punkte</th>
            <% maxArr.forEach(function(mp, i) { %>
              <th class="aufgabe-head"><input type="number" class="maxpunkt" name="mp_<%= i %>" form="maxpunkte-form-k<%= k.id %>" value="<%= mp %>" min="0" step="0.5" title="Max. Punkte Aufgabe <%= i+1 %>" aria-label="Max. Punkte Aufgabe <%= i+1 %>"></th>
              <% if (teilEnde[i] !== undefined) { %><th class="note-col"></th><% } %>
            <% }); %>
            <th class="aufgabe-head"><%= maxSumme %></th>
            <th class="note-col"></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(r) {
               var eintrag = r.klausuren.find(function(x) { return x.id === k.id; });
               var summe = (eintrag && eintrag.punkte) ? eintrag.punkte.reduce(function(a, b) { return a + (b || 0); }, 0) : 0;
               var gesperrt = Boolean(sperren.get(r.schueler_id)); %>
            <tr>
              <td class="name"><%= r.nachname %>, <%= r.vorname %><% if (r.herkunftKlasse) { %> <small class="hint">(<%= r.herkunftKlasse %>)</small><% } %><% if (gesperrt) { %> 🔒<% } %></td>
              <% maxArr.forEach(function(mp, i) {
                   var p = (eintrag && eintrag.punkte) ? eintrag.punkte[i] : null; %>
                <td><input type="number" class="punkt" data-kind="k" data-kid="<%= k.id %>" data-sid="<%= r.schueler_id %>" data-idx="<%= i %>" min="0" max="<%= mp %>" step="0.5" value="<%= p === null || p === undefined ? '' : p %>" placeholder="–" <%= gesperrt ? 'disabled' : '' %>></td>
                <% if (teilEnde[i] !== undefined) {
                     var tn = (eintrag && eintrag.teilNoten) ? eintrag.teilNoten[teilEnde[i]] : null; %>
                  <td class="note-cell k-teilnote" data-sid="<%= r.schueler_id %>" data-kid="<%= k.id %>" data-teil="<%= teilEnde[i] %>"><%= (tn === null || tn === undefined) ? '–' : formatNote(tn) %></td>
                <% } %>
              <% }); %>
              <td class="note-cell k-summe" data-sid="<%= r.schueler_id %>" data-kid="<%= k.id %>" data-max="<%= maxSumme %>"><%= summe %> / <%= maxSumme %></td>
              <td class="note-cell k-note" data-sid="<%= r.schueler_id %>" data-kid="<%= k.id %>"><%= (eintrag && eintrag.note !== null) ? formatNote(eintrag.note) : '–' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% }); %>

  <div id="klausur-panel-anlegen" class="reiter-panel unter-panel card<%= klausuren.length === 0 ? ' active' : '' %>">

<h1><%= fach.name %> – <%= fach.klasse_name %> <small>(<%= fach.schuljahr_bezeichnung %>, <%= fach.notenschluessel %>)</small></h1>
<p>
  <a href="/teacher">← Meine Noteneingabe</a>
  <% if (schueler.length) { %>
    · <a href="/teacher/fach/<%= fach.id %>/besprechung/<%= schueler[0].id %>?hj=<%= encodeURIComponent(halbjahr) %>">🗣 Notenbesprechung starten</a>
  <% } %>
</p>

<div class="card">
  <p>
    <% if (syncMeta) { %>
      Zuletzt mit der Klassenleitung synchronisiert:
      <strong><%= syncMeta.synced_at %></strong>
      (<%= syncMeta.display_name || syncMeta.username || 'unbekannt' %>)
    <% } else { %>
      <strong>Noch nicht synchronisiert</strong> — die Klassenleitung sieht für dieses Halbjahr noch keine Noten dieses Fachs.
    <% } %>
  </p>
  <form method="post" action="/teacher/fach/<%= fach.id %>/sync" class="inline">
    <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
    <button type="submit">🔄 Jetzt synchronisieren</button>
  </form>
  <form method="post" action="/teacher/fach/<%= fach.id %>/auto-sync" class="inline" id="auto-sync-form">
    <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
    <input type="hidden" name="aktiv" id="auto-sync-aktiv" value="<%= autoSync ? '1' : '0' %>">
    <label>
      <input type="checkbox" id="auto-sync-checkbox" <%= autoSync ? 'checked' : '' %>>
      automatisch mit Klassenleitung synchronisieren (bei jeder Notenänderung)
    </label>
  </form>
  <script>
    (function() {
      var cb = document.getElementById('auto-sync-checkbox');
      var hidden = document.getElementById('auto-sync-aktiv');
      var form = document.getElementById('auto-sync-form');
      cb.addEventListener('change', function() {
        hidden.value = cb.checked ? '1' : '0';
        form.submit();
      });
    })();
  </script>
</div>

<div class="hj-tabs">
  <% HALBJAHRE.forEach(function(h) { %>
    <a class="hj-tab <%= h === halbjahr ? 'active' : '' %>" href="?hj=<%= encodeURIComponent(h) %>"><%= h %></a>
  <% }); %>
</div>

<h2>Notenübersicht</h2>
<table class="data" id="uebersicht">
  <thead>
    <tr>
      <th>Schüler/in</th>
      <th>Mündliche Noten</th>
      <th>Schriftliche Noten</th>
      <th>Mündliche Note</th>
      <th>Schriftliche Note</th>
      <th>Gesamtnote</th>
    </tr>
  </thead>
  <tbody>
    <% rows.forEach(function(r) { %>
      <tr data-schueler="<%= r.schueler_id %>">
        <td class="name"><%= r.nachname %>, <%= r.vorname %></td>
        <td class="manuell-muendlich">
          <% r.muendlich.forEach(function(n) { %>
            <form method="post" action="/teacher/noten/<%= n.id %>/loeschen" class="inline">
              <button type="submit" class="tag" title="löschen"><%= Number(n.wert).toString().replace('.', ',') %></button>
            </form>
          <% }); %>
        </td>
        <td class="manuell-schriftlich">
          <% r.schriftlich.forEach(function(n) { %>
            <form method="post" action="/teacher/noten/<%= n.id %>/loeschen" class="inline">
              <button type="submit" class="tag" title="löschen"><%= Number(n.wert).toString().replace('.', ',') %></button>
            </form>
          <% }); %>
        </td>
        <td class="note-cell muendliche-note"><%= r.muendlicheNote === null ? '–' : formatNote(r.muendlicheNote) %></td>
        <td class="note-cell schriftliche-note"><%= r.schriftlicheNote === null ? '–' : formatNote(r.schriftlicheNote) %></td>
        <td class="gesamt-cell"><%= r.gesamt === null ? '–' : formatNote(r.gesamt) %></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<details class="card">
  <summary>+ Manuelle Note hinzufügen</summary>
  <form method="post" action="/teacher/fach/<%= fach.id %>/noten/hinzufuegen" class="inline">
    <select name="schueler_id" required>
      <% schueler.forEach(function(s) { %><option value="<%= s.id %>"><%= s.nachname %>, <%= s.vorname %></option><% }); %>
    </select>
    <select name="typ" required>
      <option value="muendlich">Mündlich</option>
      <option value="schriftlich">Schriftlich</option>
    </select>
    <input type="number" name="wert" step="0.1" min="<%= fach.notenschluessel === 'BG' ? 0 : 1 %>" max="<%= fach.notenschluessel === 'BG' ? 15 : 6 %>" required>
    <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
    <button type="submit">+ Note</button>
  </form>
</details>

<div class="reiter">
  <button type="button" class="active" data-target="panel-klausuren">Klausuren</button>
  <button type="button" data-target="panel-uls">Unterrichtsleistungen</button>
</div>

<div id="panel-klausuren" class="reiter-panel active">
  <details class="card">
    <summary>+ Klausur anlegen</summary>
    <form method="post" action="/teacher/fach/<%= fach.id %>/klausuren/neu">
      <label>Name der Klausur
        <input type="text" name="name" placeholder="z. B. Klausur 1" required>
      </label>
      <label>Anzahl der Aufgaben (Teilpunktzahlen), z. B. 3 bei drei Teilaufgaben
        <input type="number" name="aufgaben" min="1" value="1" size="3">
      </label>
      <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
      <button type="submit">+ Klausur anlegen</button>
    </form>
  </details>

  <% if (!klausuren.length) { %><p class="hint">Noch keine Klausuren.</p><% } %>
  <% klausuren.forEach(function(k) { %>
    <% var maxArr = JSON.parse(k.max_punkte_pro_aufgabe); %>
    <details class="card" open>
      <summary><%= k.name %> <small>(<%= k.gewichtung %>%)</small></summary>
      <form method="post" action="/teacher/klausuren/<%= k.id %>/loeschen" class="inline right" onsubmit="return confirm('Klausur löschen?')">
        <button type="submit" class="danger">🗑</button>
      </form>
      <form method="post" action="/teacher/klausuren/<%= k.id %>/gewichtung" class="inline">
        Gewichtung: <input type="number" name="gewichtung" value="<%= k.gewichtung %>" min="0" max="100" step="0.1" size="5">%
        <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
        <button type="submit">💾</button>
      </form>
      <form method="post" action="/teacher/klausuren/<%= k.id %>/maxpunkte" class="inline">
        Anzahl Aufgaben: <input type="number" name="anzahl_aufgaben" value="<%= maxArr.length %>" min="1" max="20" size="3">
        <span class="hint">Maximal erreichbare Punkte je Aufgabe:</span>
        <span class="aufgabe-liste">
          <% maxArr.forEach(function(mp, i) { %>
            <label class="aufgabe-feld">A<%= i+1 %>
              <input type="number" name="mp_<%= i %>" value="<%= mp %>" min="0" step="0.5" title="Max. Punkte Aufgabe <%= i+1 %>">
            </label>
          <% }); %>
        </span>
        <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
        <button type="submit">💾 Max-Punkte speichern</button>
      </form>
      <% var maxSumme = maxArr.reduce(function(a, b) { return a + b; }, 0); %>
      <table class="tafel">
        <thead>
          <tr>
            <th>Schüler/in</th>
            <% maxArr.forEach(function(_, i) { %><th class="aufgabe-head">A<%= i+1 %></th><% }); %>
            <th>Punkte gesamt</th>
            <th class="note-col">Note</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(r) {
               var eintrag = r.klausuren.find(function(x) { return x.id === k.id; });
               var summe = (eintrag && eintrag.punkte) ? eintrag.punkte.reduce(function(a, b) { return a + (b || 0); }, 0) : 0; %>
            <tr>
              <td class="name"><%= r.nachname %>, <%= r.vorname %></td>
              <% maxArr.forEach(function(mp, i) {
                   var p = (eintrag && eintrag.punkte) ? eintrag.punkte[i] : null; %>
                <td><input type="number" class="punkt" data-kind="k" data-kid="<%= k.id %>" data-sid="<%= r.schueler_id %>" data-idx="<%= i %>" min="0" max="<%= mp %>" step="0.5" value="<%= p === null || p === undefined ? '' : p %>" placeholder="–"></td>
              <% }); %>
              <td class="note-cell k-summe" data-sid="<%= r.schueler_id %>" data-kid="<%= k.id %>" data-max="<%= maxSumme %>"><%= summe %> / <%= maxSumme %></td>
              <td class="note-cell k-note" data-sid="<%= r.schueler_id %>" data-kid="<%= k.id %>"><%= (eintrag && eintrag.note !== null) ? formatNote(eintrag.note) : '–' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </details>
  <% }); %>
</div>

<div id="panel-uls" class="reiter-panel">
  <details class="card">
    <summary>+ Unterrichtsleistung anlegen</summary>
    <form method="post" action="/teacher/fach/<%= fach.id %>/uls/neu">
      <label>Name der Unterrichtsleistung (mündliche Leistung)
        <input type="text" name="name" placeholder="z. B. UL 1 oder Mitarbeit 1. Halbjahr" required>
      </label>
      <label>Anzahl der Aufgaben (Teilpunktzahlen)
        <input type="number" name="aufgaben" min="1" value="1" size="3">
      </label>
      <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
      <button type="submit">+ Unterrichtsleistung anlegen</button>
    </form>
  </details>

  <% if (!uls.length) { %><p class="hint">Noch keine ULs.</p><% } %>
  <% uls.forEach(function(u) { %>
    <% var maxArr = JSON.parse(u.max_punkte_pro_aufgabe); %>
    <details class="card" open>
      <summary><%= u.name %> <small>(<%= u.gewichtung %>%)</small></summary>
      <form method="post" action="/teacher/uls/<%= u.id %>/loeschen" class="inline right" onsubmit="return confirm('UL löschen?')">
        <button type="submit" class="danger">🗑</button>
      </form>
      <form method="post" action="/teacher/uls/<%= u.id %>/gewichtung" class="inline">
        Gewichtung: <input type="number" name="gewichtung" value="<%= u.gewichtung %>" min="0" max="100" step="0.1" size="5">%
        <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
        <button type="submit">💾</button>
      </form>
      <form method="post" action="/teacher/uls/<%= u.id %>/maxpunkte" class="inline">
        Anzahl Aufgaben: <input type="number" name="anzahl_aufgaben" value="<%= maxArr.length %>" min="1" max="20" size="3">
        <span class="hint">Maximal erreichbare Punkte je Aufgabe:</span>
        <span class="aufgabe-liste">
          <% maxArr.forEach(function(mp, i) { %>
            <label class="aufgabe-feld">A<%= i+1 %>
              <input type="number" name="mp_<%= i %>" value="<%= mp %>" min="0" step="0.5" title="Max. Punkte Aufgabe <%= i+1 %>">
            </label>
          <% }); %>
        </span>
        <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
        <button type="submit">💾 Max-Punkte speichern</button>
      </form>
      <% var maxSummeUl = maxArr.reduce(function(a, b) { return a + b; }, 0); %>
      <table class="tafel">
        <thead>
          <tr>
            <th>Schüler/in</th>
            <% maxArr.forEach(function(_, i) { %><th class="aufgabe-head">A<%= i+1 %></th><% }); %>
            <th>Punkte gesamt</th>
            <th class="note-col">Note</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(r) {
               var eintrag = r.uls.find(function(x) { return x.id === u.id; });
               var summeUl = (eintrag && eintrag.punkte) ? eintrag.punkte.reduce(function(a, b) { return a + (b || 0); }, 0) : 0; %>
            <tr>
              <td class="name"><%= r.nachname %>, <%= r.vorname %></td>
              <% maxArr.forEach(function(mp, i) {
                   var p = (eintrag && eintrag.punkte) ? eintrag.punkte[i] : null; %>
                <td><input type="number" class="punkt" data-kind="u" data-kid="<%= u.id %>" data-sid="<%= r.schueler_id %>" data-idx="<%= i %>" min="0" max="<%= mp %>" step="0.5" value="<%= p === null || p === undefined ? '' : p %>" placeholder="–"></td>
              <% }); %>
              <td class="note-cell u-summe" data-sid="<%= r.schueler_id %>" data-kid="<%= u.id %>" data-max="<%= maxSummeUl %>"><%= summeUl %> / <%= maxSummeUl %></td>
              <td class="note-cell u-note" data-sid="<%= r.schueler_id %>" data-kid="<%= u.id %>"><%= (eintrag && eintrag.note !== null) ? formatNote(eintrag.note) : '–' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </details>
  <% }); %>
</div>

<script>
  // Reiter (Klausuren/ULs) umschalten
  document.querySelectorAll('.reiter button').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.reiter button').forEach(function(b) { b.classList.remove('active'); });
      document.querySelectorAll('.reiter-panel').forEach(function(p) { p.classList.remove('active'); });
      btn.classList.add('active');
      document.getElementById(btn.dataset.target).classList.add('active');
    });
  });

  // Live-Update via JSON-API: aktualisiert Punkt-Noten UND die Notenübersicht oben
  const API_URL = '/teacher/fach/<%= fach.id %>/noten?hj=' + encodeURIComponent('<%= halbjahr %>');
  async function refresh() {
    try {
      const r = await fetch(API_URL);
      if (!r.ok) return;
      const data = await r.json();
      data.schueler.forEach(function(s) {
        document.querySelectorAll('.k-note[data-sid="' + s.schueler_id + '"]').forEach(function(cell) {
          const k = s.klausuren.find(function(x) { return x.id === Number(cell.dataset.kid); });
          cell.textContent = (k && k.note !== null) ? k.note.toString().replace('.', ',') : '–';
        });
        document.querySelectorAll('.u-note[data-sid="' + s.schueler_id + '"]').forEach(function(cell) {
          const u = s.uls.find(function(x) { return x.id === Number(cell.dataset.kid); });
          cell.textContent = (u && u.note !== null) ? u.note.toString().replace('.', ',') : '–';
        });
        document.querySelectorAll('.k-summe[data-sid="' + s.schueler_id + '"]').forEach(function(cell) {
          const k = s.klausuren.find(function(x) { return x.id === Number(cell.dataset.kid); });
          const summe = (k && k.punkte) ? k.punkte.reduce(function(a, b) { return a + (b || 0); }, 0) : 0;
          cell.textContent = summe + ' / ' + cell.dataset.max;
        });
        document.querySelectorAll('.u-summe[data-sid="' + s.schueler_id + '"]').forEach(function(cell) {
          const u = s.uls.find(function(x) { return x.id === Number(cell.dataset.kid); });
          const summe = (u && u.punkte) ? u.punkte.reduce(function(a, b) { return a + (b || 0); }, 0) : 0;
          cell.textContent = summe + ' / ' + cell.dataset.max;
        });
        const tr = document.querySelector('#uebersicht tr[data-schueler="' + s.schueler_id + '"]');
        if (tr) {
          tr.querySelector('.muendliche-note').textContent = s.muendlicheNote !== null ? s.muendlicheNote.toString().replace('.', ',') : '–';
          tr.querySelector('.schriftliche-note').textContent = s.schriftlicheNote !== null ? s.schriftlicheNote.toString().replace('.', ',') : '–';
          tr.querySelector('.gesamt-cell').textContent = s.gesamt !== null ? s.gesamt.toString().replace('.', ',') : '–';
        }
      });
    } catch (e) { console.warn(e); }
  }
  function debounce(fn, ms) { let t; return function() { clearTimeout(t); t = setTimeout(fn, ms); }; }
  document.querySelectorAll('input.punkt').forEach(function(inp) {
    inp.addEventListener('input', debounce(async function() {
      // URLSearchParams statt FormData: fetch setzt dafür automatisch
      // Content-Type: application/x-www-form-urlencoded, das Einzige, was
      // der Server (@fastify/formbody) versteht. Mit FormData (→
      // multipart/form-data) antwortet der Server mit 415 und die Punkte
      // werden nie gespeichert — genau das führte dazu, dass live weder
      // Note noch Gesamtnote berechnet wurden.
      const body = new URLSearchParams();
      body.append('schueler_id', inp.dataset.sid);
      body.append('aufgabe_idx', inp.dataset.idx);
      body.append('wert', inp.value);
      const url = inp.dataset.kind === 'k'
        ? '/teacher/klausuren/' + inp.dataset.kid + '/punkte'
        : '/teacher/uls/' + inp.dataset.kid + '/punkte';
      await fetch(url, { method: 'POST', body });
      refresh();
    }, 400));
  });
</script>

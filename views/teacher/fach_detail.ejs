<h1><%= fach.name %> – <%= fach.klasse_name %> <small>(<%= fach.schuljahr_bezeichnung %>, <%= fach.notenschluessel %>)</small></h1>
<p>
  <a href="/teacher">← Meine Noteneingabe</a>
  · <a href="/teacher/klassen/<%= fach.klasse_id %>/sitzplan">🪑 Sitzplan</a>
  <% if (schueler.length) { %>
    · <a href="/teacher/fach/<%= fach.id %>/besprechung/<%= schueler[0].id %>?hj=<%= encodeURIComponent(halbjahr) %>">🗣 Notenbesprechung starten</a>
  <% } %>
</p>

<div class="card">
  <p>
    <% if (syncMeta) { %>
      Zuletzt mit der Klassenleitung synchronisiert:
      <strong><%= formatZeitLokal(syncMeta.synced_at) %></strong>
      (<%= syncMeta.display_name || syncMeta.username || 'unbekannt' %>)
    <% } else { %>
      <strong>Noch nicht synchronisiert</strong> — die Klassenleitung sieht für dieses Halbjahr noch keine Noten dieses Fachs.
    <% } %>
  </p>
  <form method="post" action="/teacher/fach/<%= fach.id %>/sync" class="inline">
    <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
    <button type="submit">🔄 Jetzt synchronisieren</button>
  </form>
  <form method="post" action="/teacher/fach/<%= fach.id %>/auto-sync" class="inline" id="auto-sync-form">
    <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
    <input type="hidden" name="aktiv" id="auto-sync-aktiv" value="<%= autoSync ? '1' : '0' %>">
    <label>
      <input type="checkbox" id="auto-sync-checkbox" <%= autoSync ? 'checked' : '' %>>
      automatisch mit Klassenleitung synchronisieren (bei jeder Notenänderung)
    </label>
  </form>
  <script>
    (function() {
      var cb = document.getElementById('auto-sync-checkbox');
      var hidden = document.getElementById('auto-sync-aktiv');
      var form = document.getElementById('auto-sync-form');
      cb.addEventListener('change', function() {
        hidden.value = cb.checked ? '1' : '0';
        form.submit();
      });
    })();
  </script>
</div>

<% if (darfFachAbschliessen) { %>
  <div class="card">
    <% if (fach.abgeschlossen) { %>
      <p>
        ✅ Fach abgeschlossen am <strong><%= formatZeitLokal(fach.abgeschlossen_am) %></strong> —
        die Fachabschlussnote (Mittelwert aus allen Halbjahren, siehe Notenübersicht) ist eingefroren.
      </p>
      <form method="post" action="/teacher/fach/<%= fach.id %>/oeffnen" class="inline"
            onsubmit="return confirm('Fach wieder öffnen? Die Fachabschlussnote bleibt bis zum nächsten Abschließen unverändert sichtbar.')">
        <button type="submit">🔓 Fach wieder öffnen</button>
      </form>
    <% } else { %>
      <p class="hint">
        Optional: Manche Fächer laufen über mehrere Schuljahre und werden nie abgeschlossen. Beim
        Abschließen wird je Schüler/in eine Fachabschlussnote aus allen vorhandenen Halbjahren
        (aktuelle + historische, siehe unten) berechnet.
      </p>
      <form method="post" action="/teacher/fach/<%= fach.id %>/abschliessen" class="inline"
            onsubmit="return confirm('Fach abschließen? Für jede Schülerin/jeden Schüler wird eine Fachabschlussnote aus allen Halbjahren berechnet.')">
        <button type="submit">✅ Fach abschließen</button>
      </form>
    <% } %>
  </div>
<% } %>

<div class="hj-tabs">
  <% HALBJAHRE.forEach(function(h) { %>
    <a class="hj-tab <%= h === halbjahr ? 'active' : '' %>" href="?hj=<%= encodeURIComponent(h) %>"><%= h %></a>
  <% }); %>
</div>

<div class="reiter" data-storage-key="noteneingabe-reiter-<%= fach.id %>">
  <button type="button" class="active" data-target="panel-uebersicht">Notenübersicht</button>
  <button type="button" data-target="panel-uls">Unterrichtsleistung</button>
  <button type="button" data-target="panel-klausuren">Klausuren</button>
</div>

<div id="panel-uebersicht" class="reiter-panel active">
  <h2>Notenübersicht</h2>
  <table class="data" id="uebersicht">
    <thead>
      <tr>
        <th>Schüler/in</th>
        <th>Mündliche Noten</th>
        <th>Schriftliche Noten</th>
        <th>Mündliche Note</th>
        <th>Schriftliche Note</th>
        <th>Gesamtnote</th>
        <% if (fach.abgeschlossen) { %><th>Abschlussnote</th><% } %>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function(r) {
           var sperre = sperren.get(r.schueler_id); %>
        <tr data-schueler="<%= r.schueler_id %>">
          <td class="name">
            <%= r.nachname %>, <%= r.vorname %>
            <% if (sperre) { %><span title="Noten für dieses Halbjahr gesperrt (Notenkonferenz)">🔒</span><% } %>
          </td>
          <td class="manuell-muendlich">
            <% r.muendlich.forEach(function(n) { %>
              <% if (sperre) { %>
                <span class="tag" title="gesperrt"><%= Number(n.wert).toString().replace('.', ',') %></span>
              <% } else { %>
                <form method="post" action="/teacher/noten/<%= n.id %>/loeschen" class="inline">
                  <button type="submit" class="tag" title="löschen"><%= Number(n.wert).toString().replace('.', ',') %></button>
                </form>
              <% } %>
            <% }); %>
          </td>
          <td class="manuell-schriftlich">
            <% r.schriftlich.forEach(function(n) { %>
              <% if (sperre) { %>
                <span class="tag" title="gesperrt"><%= Number(n.wert).toString().replace('.', ',') %></span>
              <% } else { %>
                <form method="post" action="/teacher/noten/<%= n.id %>/loeschen" class="inline">
                  <button type="submit" class="tag" title="löschen"><%= Number(n.wert).toString().replace('.', ',') %></button>
                </form>
              <% } %>
            <% }); %>
          </td>
          <td class="note-cell muendliche-note"><%= r.muendlicheNote === null ? '–' : formatNote(r.muendlicheNote) %></td>
          <td class="note-cell schriftliche-note"><%= r.schriftlicheNote === null ? '–' : formatNote(r.schriftlicheNote) %></td>
          <td class="gesamt-cell"><%= r.gesamt === null ? '–' : formatNote(r.gesamt) %></td>
          <% if (fach.abgeschlossen) { %>
            <td class="note-cell"><% var an = abschlussnoten.get(r.schueler_id); %><%= (an === null || an === undefined) ? '–' : formatNote(an) %></td>
          <% } %>
        </tr>
        <% if (sperre && !sperre.aufhebung_angefragt) { %>
          <tr>
            <td colspan="<%= fach.abgeschlossen ? 7 : 6 %>">
              <form method="post" action="/teacher/fach/<%= fach.id %>/sperre/<%= r.schueler_id %>/anfragen" class="inline">
                <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
                <input type="text" name="grund" placeholder="Grund (optional)" size="30">
                <button type="submit">🔓 Entsperrung anfragen</button>
              </form>
            </td>
          </tr>
        <% } else if (sperre) { %>
          <tr><td colspan="<%= fach.abgeschlossen ? 7 : 6 %>"><small class="hint">⏳ Entsperrung bereits angefragt.</small></td></tr>
        <% } %>
      <% }); %>
    </tbody>
  </table>

  <details class="card">
    <summary>+ Manuelle Note hinzufügen</summary>
    <form method="post" action="/teacher/fach/<%= fach.id %>/noten/hinzufuegen" class="inline">
      <select name="schueler_id" required>
        <% schueler.filter(function(s) { return !sperren.get(s.id); }).forEach(function(s) { %>
          <option value="<%= s.id %>"><%= s.nachname %>, <%= s.vorname %></option>
        <% }); %>
      </select>
      <select name="typ" required>
        <option value="schriftlich">Schriftlich</option>
      </select>
      <input type="number" name="wert" step="0.1" min="<%= fach.notenschluessel === 'BG' ? 0 : 1 %>" max="<%= fach.notenschluessel === 'BG' ? 15 : 6 %>" required>
      <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
      <button type="submit">+ Note</button>
    </form>
    <p class="hint">Für mündliche Noten die Datumstabelle im Reiter „Unterrichtsleistung" nutzen — die zählt (anders als diese Notiz hier) direkt in die Berechnung.</p>
  </details>

  <details class="card">
    <summary>Historische Halbjahre <small>(Noten von vor Einführung der App)</small></summary>
    <% if (!historischeHalbjahre.length) { %>
      <p class="hint">Noch keine historischen Halbjahre hinterlegt.</p>
    <% } %>
    <% historischeHalbjahre.forEach(function(hh) { %>
      <details class="card" open>
        <summary><%= hh.bezeichnung %></summary>
        <% if (darfHistorieAnlegen) { %>
          <form method="post" action="/teacher/historie/<%= hh.id %>/loeschen" class="inline right" onsubmit="return confirm('Historisches Halbjahr entfernen?')">
            <button type="submit" class="danger">🗑</button>
          </form>
        <% } %>
        <form method="post" action="/teacher/historie/<%= hh.id %>/speichern">
          <table class="data">
            <thead><tr><th>Schüler/in</th><th>Note</th></tr></thead>
            <tbody>
              <% schueler.forEach(function(s) { %>
                <tr>
                  <td class="name"><%= s.nachname %>, <%= s.vorname %></td>
                  <td>
                    <input type="number" name="note_<%= s.id %>" step="0.1"
                           min="<%= fach.notenschluessel === 'BG' ? 0 : 1 %>" max="<%= fach.notenschluessel === 'BG' ? 15 : 6 %>"
                           value="<%= hh.noten.get(s.id) === undefined ? '' : hh.noten.get(s.id) %>">
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          <button type="submit">💾 Speichern</button>
        </form>
      </details>
    <% }); %>
    <% if (darfHistorieAnlegen) { %>
      <form method="post" action="/teacher/fach/<%= fach.id %>/historie/neu" class="inline">
        <input type="text" name="bezeichnung" placeholder="z. B. 1. Halbjahr 2022/23" required>
        <button type="submit">+ Vergangenes Halbjahr hinzufügen</button>
      </form>
    <% } %>
  </details>
</div>

<div id="panel-klausuren" class="reiter-panel">
  <details class="card">
    <summary>+ Klausur anlegen</summary>
    <form method="post" action="/teacher/fach/<%= fach.id %>/klausuren/neu">
      <div class="erstellen-felder">
        <label class="feld">Name der Klausur
          <input type="text" name="name" placeholder="z. B. Klausur 1" required>
        </label>
        <label class="feld">Anzahl der Aufgaben (Teilpunktzahlen), z. B. 3 bei drei Teilaufgaben
          <input type="number" name="aufgaben" min="1" value="1">
        </label>
      </div>
      <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
      <button type="submit">+ Klausur anlegen</button>
    </form>
  </details>

  <% if (!klausuren.length) { %><p class="hint">Noch keine Klausuren.</p><% } %>
  <% if (klausuren.length) { %>
    <div class="reiter unter-reiter" data-storage-key="noteneingabe-subreiter-klausuren-<%= fach.id %>">
      <% klausuren.forEach(function(k, i) { %>
        <button type="button" class="<%= i === 0 ? 'active' : '' %>" data-target="klausur-panel-<%= k.id %>"><%= k.name %> <small>(<%= k.gewichtung %>%)</small></button>
      <% }); %>
    </div>
  <% } %>
  <% klausuren.forEach(function(k, i) { %>
    <% var maxArr = JSON.parse(k.max_punkte_pro_aufgabe); %>
    <div id="klausur-panel-<%= k.id %>" class="reiter-panel unter-panel card <%= i === 0 ? 'active' : '' %>">
      <form method="post" action="/teacher/klausuren/<%= k.id %>/loeschen" class="inline right" onsubmit="return confirm('Klausur löschen?')">
        <button type="submit" class="danger">🗑</button>
      </form>
      <form method="post" action="/teacher/klausuren/<%= k.id %>/gewichtung" class="einstellungen">
        <label class="feld">Gewichtung
          <span class="feld-mit-einheit"><input type="number" name="gewichtung" value="<%= k.gewichtung %>" min="0" max="100" step="0.1">%</span>
        </label>
        <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
        <button type="submit">💾</button>
      </form>
      <form method="post" action="/teacher/klausuren/<%= k.id %>/maxpunkte" class="einstellungen">
        <label class="feld">Anzahl Aufgaben
          <input type="number" name="anzahl_aufgaben" value="<%= maxArr.length %>" min="1" max="20">
        </label>
        <span class="hint">Maximal erreichbare Punkte je Aufgabe:</span>
        <span class="aufgabe-liste">
          <% maxArr.forEach(function(mp, i) { %>
            <label class="aufgabe-feld">A<%= i+1 %>
              <input type="number" name="mp_<%= i %>" value="<%= mp %>" min="0" step="0.5" title="Max. Punkte Aufgabe <%= i+1 %>">
            </label>
          <% }); %>
        </span>
        <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
        <div class="form-actions">
          <button type="submit">💾 Speichern</button>
        </div>
      </form>
      <% var maxSumme = maxArr.reduce(function(a, b) { return a + b; }, 0); %>
      <table class="tafel">
        <thead>
          <tr>
            <th>Schüler/in</th>
            <% maxArr.forEach(function(_, i) { %><th class="aufgabe-head">A<%= i+1 %></th><% }); %>
            <th>Punkte gesamt</th>
            <th class="note-col">Note</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(r) {
               var eintrag = r.klausuren.find(function(x) { return x.id === k.id; });
               var summe = (eintrag && eintrag.punkte) ? eintrag.punkte.reduce(function(a, b) { return a + (b || 0); }, 0) : 0;
               var gesperrt = Boolean(sperren.get(r.schueler_id)); %>
            <tr>
              <td class="name"><%= r.nachname %>, <%= r.vorname %><% if (gesperrt) { %> 🔒<% } %></td>
              <% maxArr.forEach(function(mp, i) {
                   var p = (eintrag && eintrag.punkte) ? eintrag.punkte[i] : null; %>
                <td><input type="number" class="punkt" data-kind="k" data-kid="<%= k.id %>" data-sid="<%= r.schueler_id %>" data-idx="<%= i %>" min="0" max="<%= mp %>" step="0.5" value="<%= p === null || p === undefined ? '' : p %>" placeholder="–" <%= gesperrt ? 'disabled' : '' %>></td>
              <% }); %>
              <td class="note-cell k-summe" data-sid="<%= r.schueler_id %>" data-kid="<%= k.id %>" data-max="<%= maxSumme %>"><%= summe %> / <%= maxSumme %></td>
              <td class="note-cell k-note" data-sid="<%= r.schueler_id %>" data-kid="<%= k.id %>"><%= (eintrag && eintrag.note !== null) ? formatNote(eintrag.note) : '–' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% }); %>
</div>

<div id="panel-uls" class="reiter-panel">
  <div class="reiter unter-reiter" data-storage-key="noteneingabe-subreiter-uls-<%= fach.id %>">
    <button type="button" class="active" data-target="ul-panel-datumstabelle">Datumstabelle</button>
    <% uls.forEach(function(u) { %>
      <button type="button" data-target="ul-panel-<%= u.id %>"><%= u.name %> <small>(<%= u.gewichtung %>%)</small></button>
    <% }); %>
    <button type="button" data-target="ul-panel-anlegen">+ Zusatzleistung anlegen</button>
  </div>

  <div id="ul-panel-datumstabelle" class="reiter-panel unter-panel card active">
    <p class="hint">
      Eine Spalte je Unterrichtstermin, eine Note je Schüler/in ohne
      Einzelgewichtung. Der Durchschnitt aller eingetragenen Noten bildet die
      Basis der Unterrichtsleistungsnote — Zusatzleistungen (eigene Reiter)
      zählen zusätzlich mit ihrer eigenen Gewichtung.
    </p>
    <form method="post" action="/teacher/fach/<%= fach.id %>/unterricht/termine/neu" class="inline">
      <input type="date" name="datum" required>
      <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
      <button type="submit">+ Datum hinzufügen</button>
    </form>

    <% if (!termine.length) { %><p class="hint">Noch keine Termine.</p><% } else { %>
      <div class="tabelle-scroll">
      <table class="tafel" id="datumstabelle">
        <thead>
          <tr>
            <th>Schüler/in</th>
            <% termine.forEach(function(t) { %>
              <th class="datum-head">
                <%= t.datum.split('-').reverse().join('.') %>
                <form method="post" action="/teacher/unterricht/termine/<%= t.id %>/loeschen" class="inline"
                      onsubmit="return confirm('Termin löschen? Alle Noten dieses Termins gehen verloren.')">
                  <button type="submit" class="danger" title="Termin löschen">🗑</button>
                </form>
              </th>
            <% }); %>
            <th>Ø</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(r) {
               var gesperrt = Boolean(sperren.get(r.schueler_id)); %>
            <tr>
              <td class="name"><%= r.nachname %>, <%= r.vorname %><% if (gesperrt) { %> 🔒<% } %></td>
              <% r.terminNoten.forEach(function(tn) { %>
                <td>
                  <input type="number" class="note-datum" data-termin="<%= tn.termin_id %>" data-sid="<%= r.schueler_id %>"
                    min="<%= fach.notenschluessel === 'BG' ? 0 : 1 %>" max="<%= fach.notenschluessel === 'BG' ? 15 : 6 %>" step="0.1"
                    value="<%= tn.wert === null ? '' : tn.wert %>" placeholder="–" <%= gesperrt ? 'disabled' : '' %>>
                </td>
              <% }); %>
              <td class="note-cell datums-durchschnitt" data-sid="<%= r.schueler_id %>">
                <%= r.datumsDurchschnitt === null ? '–' : formatNote(r.datumsDurchschnitt) %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    <% } %>
  </div>

  <% uls.forEach(function(u) { %>
    <% var maxArr = JSON.parse(u.max_punkte_pro_aufgabe); %>
    <div id="ul-panel-<%= u.id %>" class="reiter-panel unter-panel card">
      <form method="post" action="/teacher/uls/<%= u.id %>/loeschen" class="inline right" onsubmit="return confirm('Zusatzleistung löschen?')">
        <button type="submit" class="danger">🗑</button>
      </form>
      <form method="post" action="/teacher/uls/<%= u.id %>/gewichtung" class="einstellungen">
        <label class="feld">Gewichtung (Anteil an der Unterrichtsleistung)
          <span class="feld-mit-einheit"><input type="number" name="gewichtung" value="<%= u.gewichtung %>" min="0" max="100" step="0.1">%</span>
        </label>
        <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
        <button type="submit">💾</button>
      </form>
      <form method="post" action="/teacher/uls/<%= u.id %>/maxpunkte" class="einstellungen">
        <label class="feld">Anzahl Aufgaben
          <input type="number" name="anzahl_aufgaben" value="<%= maxArr.length %>" min="1" max="20">
        </label>
        <span class="hint">Maximal erreichbare Punkte je Aufgabe:</span>
        <span class="aufgabe-liste">
          <% maxArr.forEach(function(mp, i) { %>
            <label class="aufgabe-feld">A<%= i+1 %>
              <input type="number" name="mp_<%= i %>" value="<%= mp %>" min="0" step="0.5" title="Max. Punkte Aufgabe <%= i+1 %>">
            </label>
          <% }); %>
        </span>
        <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
        <div class="form-actions">
          <button type="submit">💾 Speichern</button>
        </div>
      </form>
      <% var maxSummeUl = maxArr.reduce(function(a, b) { return a + b; }, 0); %>
      <table class="tafel">
        <thead>
          <tr>
            <th>Schüler/in</th>
            <% maxArr.forEach(function(_, i) { %><th class="aufgabe-head">A<%= i+1 %></th><% }); %>
            <th>Punkte gesamt</th>
            <th class="note-col">Note</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(r) {
               var eintrag = r.uls.find(function(x) { return x.id === u.id; });
               var summeUl = (eintrag && eintrag.punkte) ? eintrag.punkte.reduce(function(a, b) { return a + (b || 0); }, 0) : 0;
               var gesperrt = Boolean(sperren.get(r.schueler_id)); %>
            <tr>
              <td class="name"><%= r.nachname %>, <%= r.vorname %><% if (gesperrt) { %> 🔒<% } %></td>
              <% maxArr.forEach(function(mp, i) {
                   var p = (eintrag && eintrag.punkte) ? eintrag.punkte[i] : null; %>
                <td><input type="number" class="punkt" data-kind="u" data-kid="<%= u.id %>" data-sid="<%= r.schueler_id %>" data-idx="<%= i %>" min="0" max="<%= mp %>" step="0.5" value="<%= p === null || p === undefined ? '' : p %>" placeholder="–" <%= gesperrt ? 'disabled' : '' %>></td>
              <% }); %>
              <td class="note-cell u-summe" data-sid="<%= r.schueler_id %>" data-kid="<%= u.id %>" data-max="<%= maxSummeUl %>"><%= summeUl %> / <%= maxSummeUl %></td>
              <td class="note-cell u-note" data-sid="<%= r.schueler_id %>" data-kid="<%= u.id %>"><%= (eintrag && eintrag.note !== null) ? formatNote(eintrag.note) : '–' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% }); %>

  <div id="ul-panel-anlegen" class="reiter-panel unter-panel card">
    <p class="hint">
      Zusätzliche, einzeln benotete Leistungen (z. B. Präsentationen). Die
      Gewichtung gilt als Anteil an der Unterrichtsleistung — der Rest bis
      100 % entfällt automatisch auf die Datumstabelle. Ohne Gewichtung
      zählt eine Zusatzleistung nicht mit.
    </p>
    <form method="post" action="/teacher/fach/<%= fach.id %>/uls/neu">
      <div class="erstellen-felder">
        <label class="feld">Name der Zusatzleistung
          <input type="text" name="name" placeholder="z. B. Präsentation" required>
        </label>
        <label class="feld">Anzahl der Aufgaben (Teilpunktzahlen)
          <input type="number" name="aufgaben" min="1" value="1">
        </label>
      </div>
      <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
      <button type="submit">+ Zusatzleistung anlegen</button>
    </form>
  </div>
</div>

<script>
  // Reiter (Notenübersicht/Unterrichtsleistung/Klausuren, sowie die
  // Unter-Reiter je Klausur und je Zusatzleistung) umschalten. Jede
  // .reiter-Gruppe verwaltet nur ihre eigenen Buttons/Panels (sonst würde
  // ein Klick auf einen Unter-Reiter versehentlich auch die oberste
  // Reiter-Ebene umschalten). Der gewählte Reiter wird je Gruppe in
  // localStorage gemerkt, damit er nach einem Seiten-Reload (z. B. nach dem
  // Anlegen/Löschen einer Klausur oder UL, oder dem Speichern von
  // Gewichtung/Max-Punkten — alles normale Form-POSTs mit vollem Reload)
  // erhalten bleibt, statt immer wieder auf den ersten Reiter zurückzuspringen.
  function initReiterGruppe(gruppe) {
    const buttons = Array.from(gruppe.querySelectorAll(':scope > button'));
    const storageKey = gruppe.dataset.storageKey;
    function setzeReiter(targetId) {
      buttons.forEach(function(b) { b.classList.toggle('active', b.dataset.target === targetId); });
      buttons.forEach(function(b) {
        const panel = document.getElementById(b.dataset.target);
        if (panel) panel.classList.toggle('active', b.dataset.target === targetId);
      });
    }
    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        setzeReiter(btn.dataset.target);
        if (storageKey) {
          try { localStorage.setItem(storageKey, btn.dataset.target); } catch (e) { /* z. B. privater Modus */ }
        }
      });
    });
    if (storageKey) {
      try {
        const gemerkterReiter = localStorage.getItem(storageKey);
        if (gemerkterReiter && document.getElementById(gemerkterReiter)) {
          setzeReiter(gemerkterReiter);
        }
      } catch (e) { /* z. B. privater Modus */ }
    }
  }
  document.querySelectorAll('.reiter').forEach(initReiterGruppe);

  // Live-Update via JSON-API: aktualisiert Punkt-Noten UND die Notenübersicht oben
  const API_URL = '/teacher/fach/<%= fach.id %>/noten?hj=' + encodeURIComponent('<%= halbjahr %>');
  async function refresh() {
    try {
      const r = await fetch(API_URL);
      if (!r.ok) return;
      const data = await r.json();
      data.schueler.forEach(function(s) {
        document.querySelectorAll('.k-note[data-sid="' + s.schueler_id + '"]').forEach(function(cell) {
          const k = s.klausuren.find(function(x) { return x.id === Number(cell.dataset.kid); });
          cell.textContent = (k && k.note !== null) ? k.note.toString().replace('.', ',') : '–';
        });
        document.querySelectorAll('.u-note[data-sid="' + s.schueler_id + '"]').forEach(function(cell) {
          const u = s.uls.find(function(x) { return x.id === Number(cell.dataset.kid); });
          cell.textContent = (u && u.note !== null) ? u.note.toString().replace('.', ',') : '–';
        });
        document.querySelectorAll('.k-summe[data-sid="' + s.schueler_id + '"]').forEach(function(cell) {
          const k = s.klausuren.find(function(x) { return x.id === Number(cell.dataset.kid); });
          const summe = (k && k.punkte) ? k.punkte.reduce(function(a, b) { return a + (b || 0); }, 0) : 0;
          cell.textContent = summe + ' / ' + cell.dataset.max;
        });
        document.querySelectorAll('.u-summe[data-sid="' + s.schueler_id + '"]').forEach(function(cell) {
          const u = s.uls.find(function(x) { return x.id === Number(cell.dataset.kid); });
          const summe = (u && u.punkte) ? u.punkte.reduce(function(a, b) { return a + (b || 0); }, 0) : 0;
          cell.textContent = summe + ' / ' + cell.dataset.max;
        });
        const tr = document.querySelector('#uebersicht tr[data-schueler="' + s.schueler_id + '"]');
        if (tr) {
          tr.querySelector('.muendliche-note').textContent = s.muendlicheNote !== null ? s.muendlicheNote.toString().replace('.', ',') : '–';
          tr.querySelector('.schriftliche-note').textContent = s.schriftlicheNote !== null ? s.schriftlicheNote.toString().replace('.', ',') : '–';
          tr.querySelector('.gesamt-cell').textContent = s.gesamt !== null ? s.gesamt.toString().replace('.', ',') : '–';
        }
        const datumsZelle = document.querySelector('.datums-durchschnitt[data-sid="' + s.schueler_id + '"]');
        if (datumsZelle) {
          datumsZelle.textContent = s.datumsDurchschnitt !== null ? s.datumsDurchschnitt.toString().replace('.', ',') : '–';
        }
      });
    } catch (e) { console.warn(e); }
  }
  function debounce(fn, ms) { let t; return function() { clearTimeout(t); t = setTimeout(fn, ms); }; }
  document.querySelectorAll('input.punkt').forEach(function(inp) {
    inp.addEventListener('input', debounce(async function() {
      // URLSearchParams statt FormData: fetch setzt dafür automatisch
      // Content-Type: application/x-www-form-urlencoded, das Einzige, was
      // der Server (@fastify/formbody) versteht. Mit FormData (→
      // multipart/form-data) antwortet der Server mit 415 und die Punkte
      // werden nie gespeichert — genau das führte dazu, dass live weder
      // Note noch Gesamtnote berechnet wurden.
      const body = new URLSearchParams();
      body.append('schueler_id', inp.dataset.sid);
      body.append('aufgabe_idx', inp.dataset.idx);
      body.append('wert', inp.value);
      const url = inp.dataset.kind === 'k'
        ? '/teacher/klausuren/' + inp.dataset.kid + '/punkte'
        : '/teacher/uls/' + inp.dataset.kid + '/punkte';
      await fetch(url, { method: 'POST', body });
      refresh();
    }, 400));
  });
  document.querySelectorAll('input.note-datum').forEach(function(inp) {
    inp.addEventListener('input', debounce(async function() {
      const body = new URLSearchParams();
      body.append('schueler_id', inp.dataset.sid);
      body.append('wert', inp.value);
      await fetch('/teacher/unterricht/termine/' + inp.dataset.termin + '/note', { method: 'POST', body });
      refresh();
    }, 400));
  });
</script>

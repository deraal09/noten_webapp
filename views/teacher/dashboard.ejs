<h1>Noteneingabe</h1>

<% if (!byKlasse.length && !kurse.length) { %>
  <p>Du bist noch keinen Fächern zugewiesen. Bitte wende dich an den Admin oder lege selbst eine <a href="/teacher/klassen">Klasse</a> an.</p>
<% } %>

<% var zeigeKlassenfilter = byKlasse.length + (kurse.length ? 1 : 0) > 1; var zeigeSchuljahrfilter = alleSchuljahre.length > 1; %>
<% if (zeigeKlassenfilter || zeigeSchuljahrfilter) { %>
  <p class="klassenfilter">
    <% if (zeigeSchuljahrfilter) { %>
      <label>Schuljahr
        <select id="schuljahrfilter">
          <option value="">Alle Schuljahre</option>
          <% alleSchuljahre.forEach(function(sj) { %><option value="<%= sj %>"><%= sj %></option><% }); %>
        </select>
      </label>
    <% } %>
    <% if (zeigeKlassenfilter) { %>
      <label>Klasse
        <select id="klassenfilter">
          <option value="">Alle Klassen</option>
          <% byKlasse.forEach(function(k) { %><option value="klasse-<%= k.id %>"><%= k.name %> (<%= klassenSchuljahrText(k.id) %>)</option><% }); %>
          <% if (kurse.length) { %><option value="kurse">Kurse</option><% } %>
        </select>
      </label>
    <% } %>
  </p>
  <p class="hint" id="filter-leer" hidden>Keine Klassen oder Fächer für diese Auswahl.</p>
<% } %>

<% var zeigeLehrkraefteSchalter = byKlasse.some(function(k) { return k.faecher.length || k.weitere.length; }); %>
<% if (zeigeLehrkraefteSchalter) { %>
  <p class="klassenfilter">
    <label class="hj-check"><input type="checkbox" id="lehrkraefte-schalter" checked> Lehrkräfte der Fächer anzeigen</label>
  </p>
<% } %>

<% function eintragenForm(f, klasseId, text) { %>
  <form method="post" action="/teacher/faecher/<%= f.id %>/selbst-eintragen" class="inline">
    <input type="hidden" name="zurueck" value="noteneingabe">
    <button type="submit" title="Für die Halbjahre ohne Lehrkraft eintragen (<%= f.frei.map(function(n) { return n + '.'; }).join(', ') %> Hj.)"><%= text %></button>
  </form>
<% } %>
<% function austragenForm(l, f) { %>
  <form method="post" action="/teacher/zuweisungen/<%= l.id %>/selbst-austragen" class="inline" onsubmit="return confirm('Aus „<%= f.name.replace(/'/g, '') %>“ austragen? Das Fach ist danach wieder frei für andere Lehrkräfte.')">
    <input type="hidden" name="zurueck" value="noteneingabe">
    <button type="submit" title="Dich selbst wieder austragen">Austragen</button>
  </form>
<% } %>
<% function lehrkraefteZeile(f) { %>
  <div class="kachel-sub lehrkraefte-zeile">
    <% if (f.lehrkraefte.length) { %>🎓 <%= f.lehrkraefte.map(function(l) { return (l.ich ? 'Du' : l.name) + (l.halbjahre ? ' (' + l.halbjahre + ')' : ''); }).join(', ') %>
    <% } else { %><span class="hint">keine Lehrkraft</span><% } %>
  </div>
<% } %>

<% byKlasse.forEach(function(k) { %>
  <section class="klassen-gruppe" data-gruppe="klasse-<%= k.id %>" data-schuljahre="<%= k.schuljahre.join('|') %>">
    <h2 id="klasse-<%= k.id %>"><%= k.name %> <small>(<%= klassenSchuljahrText(k.id) %>, Notenschlüssel: <%= k.notenschluessel %>)</small></h2>
    <% if (k.faecher.length) { %>
    <ul class="klasse-liste">
      <% k.faecher.forEach(function(f) { %>
        <li class="fach-kachel" data-schuljahre="<%= f.schuljahre.join('|') %>">
          <a href="/teacher/fach/<%= f.id %>">
            <div class="kachel-zeile">
              <span class="kachel-icon-klein">📝</span>
              <span class="kachel-titel-klein"><%= f.name %></span>
            </div>
          </a>
          <div class="kachel-sub"><%= f.anzahl_klausuren %> Klausur(en) · <%= f.anzahl_uls %> UL(s)<% if (f.halbjahreText) { %> · <%= f.halbjahreText %><% } %></div>
          <% lehrkraefteZeile(f); %>
          <% var meineSelbst = f.lehrkraefte.filter(function(l) { return l.ich && l.selbst; })[0]; %>
          <% if (meineSelbst || (f.frei && f.frei.length)) { %>
            <div class="kachel-aktionen">
              <% if (f.frei && f.frei.length) { eintragenForm(f, k.id, 'Weitere Halbjahre übernehmen'); } %>
              <% if (meineSelbst) { austragenForm(meineSelbst, f); } %>
            </div>
          <% } %>
        </li>
      <% }); %>
    </ul>
    <% } %>

    <% if (k.weitere.length) { %>
      <div class="weitere-faecher" data-klasse="<%= k.id %>" data-dauerhaft="<%= k.istKlassenleitung ? '1' : '0' %>">
        <h3 class="weitere-titel">
          <%= k.faecher.length ? 'Weitere Fächer der Klasse' : 'Fächer der Klasse' %>
          <% if (k.istKlassenleitung) { %>
            <small class="hint">(als Klassenleitung immer sichtbar · <a href="/teacher/klassen/<%= k.id %>#faecher-lehrkraefte">verwalten</a>)</small>
          <% } else { %>
            <button type="button" class="weitere-schalter" aria-expanded="true">Ausblenden</button>
          <% } %>
        </h3>
        <ul class="klasse-liste weitere-liste">
          <% k.weitere.forEach(function(f) { %>
            <li class="fach-kachel fach-weitere" data-schuljahre="<%= f.schuljahre.join('|') %>">
              <div class="kachel-zeile">
                <span class="kachel-icon-klein">📋</span>
                <span class="kachel-titel-klein"><%= f.name %></span>
              </div>
              <% if (f.halbjahreText) { %><div class="kachel-sub"><%= f.halbjahreText %></div><% } %>
              <% lehrkraefteZeile(f); %>
              <% var meine = f.lehrkraefte.filter(function(l) { return l.ich && l.selbst; })[0]; %>
              <% if (meine || f.frei.length) { %>
                <div class="kachel-aktionen">
                  <% if (f.frei.length) { eintragenForm(f, k.id, 'Für dieses Fach eintragen'); } %>
                  <% if (meine) { austragenForm(meine, f); } %>
                </div>
              <% } %>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>
  </section>
  <% }); %>

  <% if (kurse.length) { %>
  <section class="klassen-gruppe" data-gruppe="kurse" data-schuljahre="<%= kurse.reduce(function(a, f) { return a.concat(f.schuljahre); }, []).join('|') %>">
    <h2>Kurse</h2>
    <ul class="klasse-liste">
      <% kurse.forEach(function(f) { %>
        <li class="fach-kachel" data-schuljahre="<%= f.schuljahre.join('|') %>">
          <a href="/teacher/fach/<%= f.id %>">
            <div class="kachel-zeile">
              <span class="kachel-icon-klein">📘</span>
              <span class="kachel-titel-klein"><%= f.name %></span>
            </div>
          </a>
          <div class="kachel-sub">
            <%= f.schuljahr_bezeichnung %>, Notenschlüssel: <%= f.notenschluessel %> ·
            <%= f.anzahl_klausuren %> Klausur(en) · <%= f.anzahl_uls %> UL(s)<% if (f.halbjahreText) { %> · <%= f.halbjahreText %><% } %>
          </div>
        </li>
      <% }); %>
    </ul>
  </section>
  <% } %>

<script>
  (function() {
    var klasse = document.getElementById('klassenfilter');
    var schuljahr = document.getElementById('schuljahrfilter');
    if (!klasse && !schuljahr) return;
    var KEY_K = 'noteneingabe-klassenfilter', KEY_S = 'noteneingabe-schuljahrfilter';
    function hat(el, sj) { return !sj || (el.dataset.schuljahre || '').split('|').indexOf(sj) !== -1; }
    function anwenden() {
      var k = klasse ? klasse.value : '', sj = schuljahr ? schuljahr.value : '';
      var sichtbar = 0;
      document.querySelectorAll('.klassen-gruppe').forEach(function(g) {
        var faecher = g.querySelectorAll('.fach-kachel');
        var treffer = 0;
        faecher.forEach(function(f) { var ok = hat(f, sj); f.hidden = !ok; if (ok) treffer++; });
        var zeigen = (k === '' || g.dataset.gruppe === k) && treffer > 0;
        g.hidden = !zeigen;
        if (zeigen) sichtbar++;
      });
      var leer = document.getElementById('filter-leer');
      if (leer) leer.hidden = sichtbar > 0 || !document.querySelector('.klassen-gruppe');
    }
    function merke(sel, key) {
      if (!sel) return;
      try {
        var v = localStorage.getItem(key);
        if (v && Array.from(sel.options).some(function(o) { return o.value === v; })) sel.value = v;
      } catch (e) { /* z. B. privater Modus */ }
      sel.addEventListener('change', function() {
        try { localStorage.setItem(key, sel.value); } catch (e) { /* ohne Speicher */ }
        anwenden();
      });
    }
    merke(klasse, KEY_K);
    merke(schuljahr, KEY_S);
    anwenden();
  })();

  // Lehrkräfte der Fächer ein-/ausblenden und die Fächer anderer Lehrkräfte je Klasse ausblenden (außer als Klassenleitung);
  // beides wird im Browser gemerkt.
  (function() {
    function lies(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
    function schreibe(key, wert) { try { localStorage.setItem(key, wert); } catch (e) { /* ohne Speicher */ } }
    var schalter = document.getElementById('lehrkraefte-schalter');
    function lehrkraefte(an) { document.querySelectorAll('.lehrkraefte-zeile').forEach(function(z) { z.hidden = !an; }); }
    if (schalter) {
      schalter.checked = lies('noteneingabe-lehrkraefte') !== '0';
      lehrkraefte(schalter.checked);
      schalter.addEventListener('change', function() { schreibe('noteneingabe-lehrkraefte', schalter.checked ? '1' : '0'); lehrkraefte(schalter.checked); });
    }
    document.querySelectorAll('.weitere-faecher').forEach(function(box) {
      var knopf = box.querySelector('.weitere-schalter');
      var liste = box.querySelector('.weitere-liste');
      if (!knopf || box.dataset.dauerhaft === '1') return; // Klassenleitung: immer sichtbar
      var key = 'noteneingabe-weitere-' + box.dataset.klasse;
      function setze(an) {
        liste.hidden = !an;
        knopf.textContent = an ? 'Ausblenden' : 'Anzeigen';
        knopf.setAttribute('aria-expanded', an ? 'true' : 'false');
      }
      setze(lies(key) !== '0');
      knopf.addEventListener('click', function() { var an = liste.hidden; schreibe(key, an ? '1' : '0'); setze(an); });
    });
  })();
</script>

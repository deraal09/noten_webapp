<h1>Meine Fächer</h1>

<% if (!byKlasse.length) { %>
  <p>Du bist noch keinen Fächern zugewiesen. Bitte wende dich an den Admin.</p>
<% } %>

<% byKlasse.forEach(function(k) { %>
  <h2><%= k.name %> <small>(<%= k.schuljahr_bezeichnung %>, Notenschlüssel: <%= k.notenschluessel %>)</small></h2>
  <table class="data">
    <thead><tr><th>Fach</th><th>Klausuren</th><th>ULs</th><th>Aktion</th></tr></thead>
    <tbody>
      <% k.faecher.forEach(function(f) { %>
        <tr>
          <td><%= f.name %></td>
          <td><%= f.anzahl_klausuren %></td>
          <td><%= f.anzahl_uls %></td>
          <td><a class="btn" href="/teacher/fach/<%= f.id %>">📝 Notentafel</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% }); %>

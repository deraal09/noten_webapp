<h1>Noteneingabe</h1>

<% if (verfuegbareSchuljahre.length) { %>
  <div class="hj-tabs">
    <a class="hj-tab <%= !gewaehltesSchuljahr ? 'active' : '' %>" href="/teacher">Aktuelles Schuljahr</a>
    <% verfuegbareSchuljahre.forEach(function(sj) { %>
      <a class="hj-tab <%= sj === gewaehltesSchuljahr ? 'active' : '' %>" href="/teacher?schuljahr=<%= encodeURIComponent(sj) %>"><%= sj %></a>
    <% }); %>
  </div>
<% } %>

<% if (!byKlasse.length && !kurse.length && !verfuegbareSchuljahre.length) { %>
  <p>Du bist noch keinen Fächern zugewiesen. Bitte wende dich an den Admin oder lege selbst eine <a href="/teacher/klassen">Klasse</a> an.</p>
<% } %>

<% if (gewaehltesSchuljahr) { %>
  <h2>Vergangenes Schuljahr <%= gewaehltesSchuljahr %> <small>(rein historische Fächer/Lernfelder)</small></h2>
  <% if (!vergangeneFaecher.length) { %>
    <p class="hint">Für dieses Schuljahr sind dir keine rein historischen Fächer zugeordnet.</p>
  <% } else { %>
    <ul class="klasse-liste">
      <% vergangeneFaecher.forEach(function(f) { %>
        <li>
          <a href="/teacher/fach/<%= f.id %>?tab=historie">
            <div class="kachel-zeile">
              <span class="kachel-icon-klein">🕘</span>
              <span class="kachel-titel-klein"><%= f.name %></span>
            </div>
          </a>
          <div class="kachel-sub"><%= f.klasse_name %> -- Teilnehmer/innen und Noten im Reiter „Historische Halbjahre"</div>
        </li>
      <% }); %>
    </ul>
  <% } %>
<% } %>

<% if (!gewaehltesSchuljahr) { %>
  <% byKlasse.forEach(function(k) { %>
    <h2><%= k.name %> <small>(<%= k.schuljahr_bezeichnung %>, Notenschlüssel: <%= k.notenschluessel %>)</small></h2>
    <ul class="klasse-liste">
      <% k.faecher.forEach(function(f) { %>
        <li>
          <a href="/teacher/fach/<%= f.id %>">
            <div class="kachel-zeile">
              <span class="kachel-icon-klein">📝</span>
              <span class="kachel-titel-klein"><%= f.name %></span>
            </div>
          </a>
          <div class="kachel-sub"><%= f.anzahl_klausuren %> Klausur(en) · <%= f.anzahl_uls %> UL(s)</div>
        </li>
      <% }); %>
    </ul>
  <% }); %>

  <% if (kurse.length) { %>
    <h2>Kurse</h2>
    <ul class="klasse-liste">
      <% kurse.forEach(function(f) { %>
        <li>
          <a href="/teacher/fach/<%= f.id %>">
            <div class="kachel-zeile">
              <span class="kachel-icon-klein">📘</span>
              <span class="kachel-titel-klein"><%= f.name %></span>
            </div>
          </a>
          <div class="kachel-sub">
            <%= f.schuljahr_bezeichnung %>, Notenschlüssel: <%= f.notenschluessel %> ·
            <%= f.anzahl_klausuren %> Klausur(en) · <%= f.anzahl_uls %> UL(s)
          </div>
        </li>
      <% }); %>
    </ul>
  <% } %>
<% } %>

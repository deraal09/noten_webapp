<h1>Noteneingabe</h1>

<% if (!byKlasse.length && !kurse.length) { %>
  <p>Du bist noch keinen Fächern zugewiesen. Bitte wende dich an den Admin oder lege selbst eine <a href="/teacher/klassen">Klasse</a> an.</p>
<% } %>

<% if (byKlasse.length + (kurse.length ? 1 : 0) > 1) { %>
  <p class="klassenfilter">
    <label>Klasse
      <select id="klassenfilter">
        <option value="">Alle Klassen</option>
        <% byKlasse.forEach(function(k) { %><option value="klasse-<%= k.id %>"><%= k.name %> (<%= klassenSchuljahrText(k.id) %>)</option><% }); %>
        <% if (kurse.length) { %><option value="kurse">Kurse</option><% } %>
      </select>
    </label>
  </p>
<% } %>

<% byKlasse.forEach(function(k) { %>
  <section class="klassen-gruppe" data-gruppe="klasse-<%= k.id %>">
    <h2 id="klasse-<%= k.id %>"><%= k.name %> <small>(<%= klassenSchuljahrText(k.id) %>, Notenschlüssel: <%= k.notenschluessel %>)</small></h2>
    <ul class="klasse-liste">
      <% k.faecher.forEach(function(f) { %>
        <li>
          <a href="/teacher/fach/<%= f.id %>">
            <div class="kachel-zeile">
              <span class="kachel-icon-klein">📝</span>
              <span class="kachel-titel-klein"><%= f.name %></span>
            </div>
          </a>
          <div class="kachel-sub"><%= f.anzahl_klausuren %> Klausur(en) · <%= f.anzahl_uls %> UL(s)<% if (f.halbjahreText) { %> · <%= f.halbjahreText %><% } %></div>
        </li>
      <% }); %>
    </ul>
  </section>
  <% }); %>

  <% if (kurse.length) { %>
  <section class="klassen-gruppe" data-gruppe="kurse">
    <h2>Kurse</h2>
    <ul class="klasse-liste">
      <% kurse.forEach(function(f) { %>
        <li>
          <a href="/teacher/fach/<%= f.id %>">
            <div class="kachel-zeile">
              <span class="kachel-icon-klein">📘</span>
              <span class="kachel-titel-klein"><%= f.name %></span>
            </div>
          </a>
          <div class="kachel-sub">
            <%= f.schuljahr_bezeichnung %>, Notenschlüssel: <%= f.notenschluessel %> ·
            <%= f.anzahl_klausuren %> Klausur(en) · <%= f.anzahl_uls %> UL(s)<% if (f.halbjahreText) { %> · <%= f.halbjahreText %><% } %>
          </div>
        </li>
      <% }); %>
    </ul>
  </section>
  <% } %>

<script>
  (function() {
    var auswahl = document.getElementById('klassenfilter');
    if (!auswahl) return;
    var KEY = 'noteneingabe-klassenfilter';
    function anwenden() {
      document.querySelectorAll('.klassen-gruppe').forEach(function(g) {
        g.hidden = auswahl.value !== '' && g.dataset.gruppe !== auswahl.value;
      });
    }
    try {
      var gemerkt = localStorage.getItem(KEY);
      if (gemerkt && Array.from(auswahl.options).some(function(o) { return o.value === gemerkt; })) auswahl.value = gemerkt;
    } catch (e) { /* z. B. privater Modus */ }
    auswahl.addEventListener('change', function() {
      try { localStorage.setItem(KEY, auswahl.value); } catch (e) { /* ohne Speicher */ }
      anwenden();
    });
    anwenden();
  })();
</script>

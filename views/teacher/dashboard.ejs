<h1>Noteneingabe</h1>

<% if (!byKlasse.length && !kurse.length) { %>
  <p>Du bist noch keinen Fächern zugewiesen. Bitte wende dich an den Admin oder lege selbst eine <a href="/teacher/klassen">Klasse</a> an.</p>
<% } %>

<% byKlasse.forEach(function(k) { %>
  <h2><%= k.name %> <small>(<%= k.schuljahr_bezeichnung %>, Notenschlüssel: <%= k.notenschluessel %>)</small></h2>
  <ul class="klasse-liste">
    <% k.faecher.forEach(function(f) { %>
      <li>
        <a href="/teacher/fach/<%= f.id %>">
          <div class="kachel-zeile">
            <span class="kachel-icon-klein">📝</span>
            <span class="kachel-titel-klein"><%= f.name %></span>
          </div>
        </a>
        <div class="kachel-sub"><%= f.anzahl_klausuren %> Klausur(en) · <%= f.anzahl_uls %> UL(s)</div>
        <% if (f.darfLoeschen) { %>
          <div class="kachel-aktionen">
            <form method="post" action="/teacher/faecher/<%= f.id %>/loeschen" class="inline" onsubmit="return confirm('Fach löschen? Klausuren/ULs und Noten gehen verloren.')">
              <button type="submit" class="danger">🗑 Löschen</button>
            </form>
          </div>
        <% } %>
      </li>
    <% }); %>
  </ul>
<% }); %>

<% if (kurse.length) { %>
  <h2>Kurse</h2>
  <ul class="klasse-liste">
    <% kurse.forEach(function(f) { %>
      <li>
        <a href="/teacher/fach/<%= f.id %>">
          <div class="kachel-zeile">
            <span class="kachel-icon-klein">📘</span>
            <span class="kachel-titel-klein"><%= f.name %></span>
          </div>
        </a>
        <div class="kachel-sub">
          <%= f.schuljahr_bezeichnung %>, Notenschlüssel: <%= f.notenschluessel %> ·
          <%= f.anzahl_klausuren %> Klausur(en) · <%= f.anzahl_uls %> UL(s)
        </div>
        <% if (f.darfLoeschen) { %>
          <div class="kachel-aktionen">
            <form method="post" action="/teacher/faecher/<%= f.id %>/loeschen" class="inline" onsubmit="return confirm('Kurs löschen?')">
              <button type="submit" class="danger">🗑 Löschen</button>
            </form>
          </div>
        <% } %>
      </li>
    <% }); %>
  </ul>
<% } %>

<h1>⚙ Fach einstellen: <%= fach.name %> <small>(<%= fach.klasse_name %>)</small></h1>
<p class="kopf-aktionen">
  <a class="btn" href="/teacher/klassen/<%= fach.klasse_id %>#faecher-lehrkraefte">← Zurück zur Klasse</a>
  <a class="btn" href="/teacher/fach/<%= fach.id %>">📝 Zur Noteneingabe</a>
</p>
<%- await include('../partials/fach-reiter', { reiter: reiter, aktiv: 'allgemein' }) %>
<% if (typeof fehler !== 'undefined' && fehler) { %><div class="flash flash-error"><%= fehler %></div><% } %>
<p class="hint">
  Gilt nur für dieses Fach dieser Klasse; die Vorlage bleibt unverändert. Bereits eingetragene Punkte
  bleiben erhalten und werden nach dem neuen Schema berechnet. Wird eine Komponente umbenannt oder entfernt,
  gehören ihre eingetragenen Werte nicht mehr dazu.
</p>
<form method="post" action="/teacher/faecher/<%= fach.id %>/halbjahre" class="card fach-einstellungen">
  <input type="hidden" name="zurueck" value="einstellungen:<%= fach.id %>">
  <fieldset class="hj-auswahl">
    <legend>Gilt in diesen Halbjahren</legend>
    <% laufzeit.halbjahre.forEach(function(h, i) { %>
      <label class="hj-check"><input type="checkbox" name="halbjahre" value="<%= i + 1 %>" <%= gewaehlteHj.indexOf(i + 1) !== -1 ? 'checked' : '' %>>
        <%= i + 1 %>. Halbjahr <small>(<%= laufzeit.schuljahre[Math.floor(i / 2)].bezeichnung %>)</small></label>
    <% }); %>
  </fieldset>
  <button type="submit">Halbjahre speichern</button>
</form>
<form method="post" action="/teacher/faecher/<%= fach.id %>/spa-schema" class="spa-editor">
  <%- await include('../partials/spa-fach-editor', { modell: modell, alleFaecher: alleFaecher, einzeln: true }) %>
  <div class="form-actions"><button type="submit">💾 Schema speichern</button></div>
</form>

<%- await include('../partials/fach-loeschen', { fach: fach }) %>

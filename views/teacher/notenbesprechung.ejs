<% var fq = typeof faecherQuery !== 'undefined' ? faecherQuery : ''; %>
<% function bUrl(id) { return '/teacher/fach/' + fach.id + '/besprechung/' + id + '?hj=' + encodeURIComponent(halbjahr) + fq; } %>
<h1>Notenbesprechung: <%= bloecke.map(function(b) { return b.fach.name; }).join(' + ') %><% if (!fach.ist_kurs) { %> – <%= fach.klasse_name %><% } %></h1>
<p class="kopf-aktionen">
  <a class="btn" href="/teacher/fach/<%= fach.id %>?hj=<%= encodeURIComponent(halbjahr) %>">← Zurück zur Noteneingabe</a>
  <a class="btn" href="/teacher/klassen/<%= fach.klasse_id %>/sitzplan">🪑 Sitzplan</a>
</p>

<div class="hj-tabs">
  <% HALBJAHRE.forEach(function(h) { %>
    <a class="hj-tab <%= h === halbjahr ? 'active' : '' %>"
       href="/teacher/fach/<%= fach.id %>/besprechung/<%= person.schueler_id %>?hj=<%= encodeURIComponent(h) %><%= fq %>" title="Schuljahr <%= (typeof HALBJAHR_SCHULJAHR !== 'undefined' && HALBJAHR_SCHULJAHR[h]) || '' %>"><%= h %></a>
  <% }); %>
</div>

<% if (moegliche.length) { %>
  <details class="card besprechung-faecher"<%= gewaehltIds.length ? ' open' : '' %>>
    <summary>Weitere Fächer in diese Besprechung einbeziehen</summary>
    <form method="get" action="/teacher/fach/<%= fach.id %>/besprechung/<%= person.schueler_id %>">
      <input type="hidden" name="hj" value="<%= halbjahr %>">
      <p class="hint">Fächer dieser Klasse, für die du eingetragen bist. Die Besprechung zeigt dann alle gewählten Fächer je Person.</p>
      <% moegliche.forEach(function(m) { %>
        <label class="hj-check"><input type="checkbox" name="faecher" value="<%= m.id %>" <%= gewaehltIds.indexOf(m.id) !== -1 ? 'checked' : '' %>> <%= m.name %></label>
      <% }); %>
      <button type="submit">Übernehmen</button>
    </form>
  </details>
<% } %>

<div class="card besprechung-nav">
  <% if (vorherige) { %>
    <a class="btn" href="<%= bUrl(vorherige.schueler_id) %>">← Zurück</a>
  <% } else { %>
    <span class="btn disabled">← Zurück</span>
  <% } %>
  <strong><%= position %> / <%= anzahl %>: <%= person.nachname %>, <%= person.vorname %></strong>
  <% if (naechste) { %>
    <a class="btn" href="<%= bUrl(naechste.schueler_id) %>">Weiter →</a>
  <% } else { %>
    <span class="btn disabled">Weiter →</span>
  <% } %>
</div>
<form method="post" action="/teacher/fach/<%= fach.id %>/besprechung/wuerfeln" class="card wuerfel-leiste">
  <input type="hidden" name="hj" value="<%= halbjahr %>">
  <% if (gewaehltIds.length) { %><input type="hidden" name="faecher" value="<%= gewaehltIds.join(',') %>"><% } %>
  <input type="hidden" name="schueler_id" value="<%= person.schueler_id %>">
  <button type="submit" name="aktion" value="wuerfeln" <%= runde && runde.uebrig === 0 ? 'disabled' : '' %>>🎲 Würfeln</button>
  <% if (runde) { %>
    <span class="wuerfel-stand"><strong><%= runde.gerufen %> von <%= anzahl %></strong> aufgerufen<%= runde.uebrig ? ', noch ' + runde.uebrig : ' – alle waren dran' %>.</span>
    <button type="submit" name="aktion" value="neu" class="sekundaer">Neue Runde</button>
    <button type="submit" name="aktion" value="ende" class="sekundaer">Runde beenden</button>
    <% if (!imRunde) { %><span class="hint">Diese Person gehört noch nicht zur Würfelrunde.</span><% } %>
  <% } else { %>
    <span class="hint">Würfelt die nächste Person; jede kommt nur einmal dran, die Zählung läuft in der Reihenfolge des Aufrufs.</span>
  <% } %>
</form>

<% bloecke.forEach(function(blk) { var zeile = blk.zeile; var blockFach = blk.fach; var notizen = blk.notizen; %>
<section class="besprechung-fach">
<% if (mehrere) { %><h2 class="besprechung-fach-titel"><%= blockFach.name %></h2><% } %>
<% if (!zeile) { %>
  <p class="hint"><%= person.vorname %> nimmt an diesem Fach nicht teil.</p>
<% } else { %>
<h2>Noten <%= halbjahr %></h2>
<table class="data">
  <thead><tr><th>Gesamtnote</th><th>Schriftliche Note</th><th>Unterrichtsleistung</th></tr></thead>
  <tbody>
    <tr>
      <td><strong><%= zeile.gesamt === null ? '–' : formatNote(zeile.gesamt) %></strong></td>
      <td><%= zeile.schriftlicheNote === null ? '–' : formatNote(zeile.schriftlicheNote) %></td>
      <td><%= zeile.muendlicheNote === null ? '–' : formatNote(zeile.muendlicheNote) %></td>
    </tr>
  </tbody>
</table>

<h3>Klausuren</h3>
<% if (!zeile.klausuren.length) { %><p class="hint">Keine Klausuren in diesem Halbjahr.</p><% } %>
<table class="data">
  <thead><tr><th>Name</th><th>Gewichtung</th><th>Punkte</th><th>Note</th></tr></thead>
  <tbody>
    <% zeile.klausuren.forEach(function(k) { %>
      <tr>
        <td><%= k.name %></td>
        <td><%= k.gewichtung %>%</td>
        <td><%= k.punkte ? k.punkte.map(function(p){ return p === null ? '–' : p; }).join(', ') : '–' %></td>
        <td><%= k.note === null ? '–' : formatNote(k.note) %></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<h3>Datumstabelle (Unterrichtsleistung)</h3>
<% if (!zeile.terminNoten.length) { %><p class="hint">Noch keine Termine in diesem Halbjahr.</p><% } else { %>
  <p>
    <% zeile.terminNoten.forEach(function(tn) { %>
      <span class="tag" title="<%= tn.datum %>"><%= tn.datum.split('-').reverse().join('.') %>: <%= tn.na ? 'n.a.' : (tn.wert === null ? '–' : Number(tn.wert).toString().replace('.', ',')) %></span>
    <% }); %>
  </p>
  <p>Ø Datumstabelle: <strong><%= zeile.datumsDurchschnitt === null ? '–' : formatNote(zeile.datumsDurchschnitt) %></strong> · nicht anwesend (n.a.): <strong><%= zeile.naAnzahl %></strong></p>
<% } %>
<% var unterrichtNotizen = notizen.filter(function(n) { return n.typ === 'unterricht'; }); %>
<% if (unterrichtNotizen.length) { %>
  <div class="card unterricht-notizen">
    <strong>📝 Notizen zum Unterricht</strong>
    <ul class="notiz-liste">
      <% unterrichtNotizen.forEach(function(n) { %>
        <li>
          <div class="notiz-text"><%= n.text %></div>
          <div class="notiz-meta hint"><%= n.display_name || n.username || 'unbekannt' %> · <%= formatZeitLokal(n.created_at) %></div>
        </li>
      <% }); %>
    </ul>
  </div>
<% } %>

<h3>Zusatzleistungen</h3>
<% if (!zeile.uls.length) { %><p class="hint">Keine Zusatzleistungen in diesem Halbjahr.</p><% } %>
<table class="data">
  <thead><tr><th>Name</th><th>Gewichtung</th><th>Punkte</th><th>Note</th></tr></thead>
  <tbody>
    <% zeile.uls.forEach(function(u) { %>
      <tr>
        <td><%= u.name %></td>
        <td><%= u.gewichtung %>%</td>
        <td><%= u.punkte ? u.punkte.map(function(p){ return p === null ? '–' : p; }).join(', ') : '–' %></td>
        <td><%= u.note === null ? '–' : formatNote(u.note) %></td>
      </tr>
    <% }); %>
  </tbody>
</table>
<% } %>
</section>
<% }); %>

<h2>Notizen</h2>
<form method="post" action="/teacher/fach/<%= fach.id %>/besprechung/<%= person.schueler_id %>/notiz" class="card">
  <input type="hidden" name="halbjahr" value="<%= halbjahr %>">
  <% if (gewaehltIds.length) { %><input type="hidden" name="faecher" value="<%= gewaehltIds.join(',') %>"><% } %>
  <% if (mehrere) { %>
    <label>Fach
      <select name="fach_id">
        <% bloecke.forEach(function(b) { %><option value="<%= b.fach.id %>"><%= b.fach.name %></option><% }); %>
      </select>
    </label>
  <% } %>
  <label>Art
    <select name="typ">
      <option value="besprechung">Notenbesprechung (<%= mehrere ? 'gewähltes Fach' : 'dieses Fach' %>)</option>
      <option value="unterricht">Unterricht / Datumstabelle (<%= mehrere ? 'gewähltes Fach' : 'dieses Fach' %>)</option>
      <option value="konferenz">Notenkonferenz-Entscheidung (klassenweit)</option>
    </select>
  </label>
  <label>Notiz
    <textarea name="text" rows="3" required></textarea>
  </label>
  <button type="submit">+ Notiz speichern</button>
</form>

<% if (!notizen.length) { %>
  <p class="hint">Noch keine Notizen für dieses Halbjahr.</p>
<% } else { %>
  <table class="data">
    <thead><tr><th>Datum</th><% if (mehrere) { %><th>Fach</th><% } %><th>Art</th><th>Von</th><th>Notiz</th></tr></thead>
    <tbody>
      <% notizen.forEach(function(n) { %>
        <tr>
          <td><%= n.created_at %></td>
          <% if (mehrere) { %><td><%= n.fach_name || 'klassenweit' %></td><% } %>
          <td><%= n.typ === 'konferenz' ? 'Notenkonferenz' : (n.typ === 'unterricht' ? 'Unterricht (Datumstabelle)' : 'Besprechung') %></td>
          <td><%= n.display_name || n.username || '—' %></td>
          <td><%= n.text %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

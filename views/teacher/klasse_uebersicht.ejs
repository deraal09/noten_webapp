<h1>Halbjahresübersicht: <%= klasse.name %> <small>(<%= klasse.schuljahr_bezeichnung %>)</small></h1>
<p>
  <a href="/teacher/klassen/<%= klasse.id %>">← Zur Klasse</a>
  <% if (zeilen.length) { %>
    · <a href="/teacher/klassen/<%= klasse.id %>/konferenz/<%= zeilen[0].schueler.id %>?hj=<%= encodeURIComponent(halbjahr) %>">🎓 Konferenzmodus starten</a>
  <% } %>
</p>

<div class="hj-tabs">
  <% HALBJAHRE.forEach(function(h) { %>
    <a class="hj-tab <%= h === halbjahr ? 'active' : '' %>" href="?hj=<%= encodeURIComponent(h) %>"><%= h %></a>
  <% }); %>
</div>

<p><small>
  Zeigt den zuletzt <strong>synchronisierten</strong> Stand je Fach — nicht die Live-Notentafel der
  Fachlehrkräfte. Eine Lehrkraft synchronisiert selbst per Knopfdruck oder automatisch (siehe
  Fachseite). Fehlt eine Spalte „zuletzt synchronisiert", wurde für dieses Fach/Halbjahr noch nie
  synchronisiert.
</small></p>

<% if (!faecher.length) { %>
  <p>Diese Klasse hat noch keine Fächer.</p>
<% } else { %>
  <table class="data">
    <thead>
      <tr>
        <th>Schüler/in</th>
        <% faecher.forEach(function(f) { %>
          <th>
            <%= f.name %><br>
            <small>
              <% var m = syncMeta.get(f.id); %>
              <% if (m) { %>zuletzt sync.: <%= formatZeitLokal(m.synced_at) %><% } else { %>noch nie synchronisiert<% } %>
            </small>
          </th>
        <% }); %>
        <th>Ø Notenschnitt</th>
        <th>Notizen</th>
        <th>Konferenz</th>
      </tr>
    </thead>
    <tbody>
      <% zeilen.forEach(function(z) { %>
        <tr>
          <td class="name"><%= z.schueler.nachname %>, <%= z.schueler.vorname %></td>
          <% z.noten.forEach(function(n) { %>
            <td>
              <%= n.note === null ? '–' : formatNote(n.note) %>
              <% if (n.ueberschrieben) { %><small class="hint" title="Konferenzentscheidung">🎓</small><% } %>
            </td>
          <% }); %>
          <td><strong><%= z.schnitt === null ? '–' : formatNote(z.schnitt) %></strong></td>
          <td>
            <% if (!z.notizen.length) { %>
              —
            <% } else { %>
              <details>
                <summary>📝 <%= z.notizen.length %></summary>
                <ul>
                  <% z.notizen.forEach(function(n) { %>
                    <li>
                      <small>
                        <%= formatZeitLokal(n.created_at) %> ·
                        <%= n.typ === 'konferenz' ? 'Notenkonferenz' : ('Besprechung' + (n.fach_name ? ' (' + n.fach_name + ')' : '')) %> ·
                        <%= n.display_name || n.username || '—' %>
                      </small><br>
                      <%= n.text %>
                    </li>
                  <% }); %>
                </ul>
              </details>
            <% } %>
          </td>
          <td><a class="btn" href="/teacher/klassen/<%= klasse.id %>/konferenz/<%= z.schueler.id %>?hj=<%= encodeURIComponent(halbjahr) %>">Öffnen</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

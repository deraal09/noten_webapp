<h1>Sitzplan: <%= klasse.name %> <small>(<%= klasse.schuljahr_bezeichnung %>)</small></h1>
<p class="kopf-aktionen"><a class="btn" href="/teacher/klassen/<%= klasse.id %>">← Zur Klasse</a></p>

<p class="hint">
  Plätze frei auf dem Blatt anordnen (beliebige Raumform möglich) und Namen eintragen — für jeden Raum,
  in dem die Klasse sitzt, ein eigener Plan. Der Entwurf ist zunächst nur für dich sichtbar und wird
  automatisch gespeichert — erst der Button "An andere Lehrkräfte übertragen" gibt ihn für alle
  Lehrkräfte dieser Klasse frei.
</p>

<%# ---------- Raum-Auswahl ---------- %>
<div class="card sitzplan-raeume">
  <div class="reiter raum-reiter">
    <% raeume.forEach(function(r) { %>
      <a class="btn<%= r.raum.toLowerCase() === raum.toLowerCase() ? ' active' : '' %>" href="<%= raumUrl(r.raum) %>"
         title="<%= r.eigener ? 'Eigener Entwurf' : '' %><%= r.eigener && r.geteilt ? ' · ' : '' %><%= r.geteilt ? 'Geteilter Plan vorhanden' : '' %>"><%= r.raum || 'ohne Raumangabe' %><%= r.geteilt && !r.eigener ? ' 📥' : '' %></a>
    <% }); %>
    <% if (raumIstNeu) { %>
      <a class="btn active" href="<%= raumUrl(raum) %>"><%= raum || 'ohne Raumangabe' %> <small>(neu)</small></a>
    <% } %>
  </div>
  <form method="get" action="/teacher/klassen/<%= klasse.id %>/sitzplan" class="inline raum-neu">
    <input type="text" name="raum" placeholder="z. B. A 204 oder Computerraum" maxlength="40" required aria-label="Neuer Raum">
    <button type="submit">+ Raum</button>
  </form>

  <p class="raum-aktiv">
    Raum: <strong><%= raum || 'ohne Raumangabe' %></strong>
    <% if (!raum) { %><span class="hint"> — bitte angeben, damit der Plan einem Raum zugeordnet ist.</span><% } %>
  </p>
  <details class="raum-bearbeiten"<%= !raum ? ' open' : '' %>>
    <summary><%= raum ? '✏️ Raum umbenennen' : '✏️ Raum angeben' %></summary>
    <form method="post" action="/teacher/klassen/<%= klasse.id %>/sitzplan/raum-umbenennen" class="inline">
      <input type="hidden" name="raum" value="<%= raum %>">
      <input type="text" name="neuer_raum" value="<%= raum %>" maxlength="40" required aria-label="Raum">
      <button type="submit">Speichern</button>
    </form>
  </details>
  <% if (hatEigenen || (geteilt && geteilt.vonMir)) { %>
    <form method="post" action="/teacher/klassen/<%= klasse.id %>/sitzplan/raum-loeschen" class="inline"
          onsubmit="return confirm('Deinen Sitzplan für diesen Raum löschen?<%= geteilt && geteilt.vonMir ? ' Auch der von dir geteilte Stand wird entfernt.' : '' %>')">
      <input type="hidden" name="raum" value="<%= raum %>">
      <button type="submit" class="danger">🗑 Plan für diesen Raum löschen</button>
    </form>
  <% } %>
</div>

<% if (geteilt) { %>
  <div class="card">
    <p>
      Zuletzt an alle Lehrkräfte übertragen: <strong><%= formatZeitLokal(geteilt.geteilt_at) %></strong>
      von <%= geteilt.display_name || geteilt.username || 'unbekannt' %>
      (<%= geteilt.plaetze.length %> Plätze).
    </p>
    <details>
      <summary>Geteilten Sitzplan anzeigen</summary>
      <div class="sitzplan-blatt sitzplan-vorschau">
        <% geteilt.plaetze.forEach(function(p) { %>
          <div class="platz" style="left: <%= p.x %>%; top: <%= p.y %>%;"><%= p.text %></div>
        <% }); %>
      </div>
    </details>
    <form method="post" action="/teacher/klassen/<%= klasse.id %>/sitzplan/uebernehmen" class="inline"
          onsubmit="return confirm('Den geteilten Sitzplan als eigenen Entwurf übernehmen? Dein aktueller Entwurf für diesen Raum wird dabei überschrieben.')">
      <input type="hidden" name="raum" value="<%= raum %>">
      <button type="submit">📥 Geteilten Sitzplan übernehmen</button>
    </form>
  </div>
<% } else { %>
  <p class="hint">Noch kein Sitzplan an andere Lehrkräfte dieser Klasse übertragen (für diesen Raum).</p>
<% } %>

<div class="card">
  <button type="button" id="platz-hinzufuegen">+ Platz hinzufügen</button>
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/sitzplan/uebertragen" class="inline"
        onsubmit="return confirm('Diesen Sitzplan jetzt an alle Lehrkräfte dieser Klasse übertragen?')">
    <input type="hidden" name="raum" value="<%= raum %>">
    <button type="submit">📤 An andere Lehrkräfte übertragen</button>
  </form>
  <span id="speicher-status" class="hint"></span>
</div>

<div id="sitzplan-blatt" class="sitzplan-blatt"></div>

<datalist id="schueler-liste">
  <% namensvorschlaege.forEach(function(v) { %>
    <option value="<%= v.label %>"></option>
  <% }); %>
</datalist>

<script>
(function() {
  const blatt = document.getElementById('sitzplan-blatt');
  const status = document.getElementById('speicher-status');
  const SPEICHER_URL = '/teacher/klassen/<%= klasse.id %>/sitzplan/speichern';
  const RAUM = <%- jsonFuerSkript(raum) %>;
  let plaetze = <%- jsonFuerSkript(plaetze) %>;
  let naechsteId = plaetze.length;

  function debounce(fn, ms) { let t; return function() { clearTimeout(t); t = setTimeout(fn, ms); }; }

  // Kasten passt sich der Namenslänge an: die tatsächliche Textbreite wird
  // mit einem unsichtbaren Mess-Span in derselben Schrift gemessen (ch-Werte
  // sind zu ungenau, besonders bei breiten Zeichen wie Ä/Ö/Ü/W/M).
  const messSpan = document.createElement('span');
  messSpan.style.position = 'absolute';
  messSpan.style.visibility = 'hidden';
  messSpan.style.whiteSpace = 'pre';
  messSpan.style.left = '-9999px';
  document.body.appendChild(messSpan);

  // Nur aufrufen, wenn das Feld schon im Dokument hängt: an einem noch
  // nicht eingehängten Element liefert getComputedStyle() leere Werte, und
  // gemessen würde dann in der falschen Schrift. Die Schrift wird über die
  // Einzel-Eigenschaften übernommen statt über das Kürzel `font`, das nicht
  // jeder Browser aus getComputedStyle() zurückgibt.
  function groesseAnpassen(input) {
    const text = input.value || input.placeholder || '';
    const stil = window.getComputedStyle(input);
    ['fontStyle', 'fontVariant', 'fontWeight', 'fontSize', 'fontFamily', 'letterSpacing'].forEach(function(e) {
      messSpan.style[e] = stil[e];
    });
    messSpan.textContent = text;
    const innenabstand = parseFloat(stil.paddingLeft) + parseFloat(stil.paddingRight);
    // +4 px Luft für den Cursor am Textende.
    const breite = Math.max(30, Math.ceil(messSpan.getBoundingClientRect().width + innenabstand + 4));
    input.style.width = breite + 'px';
    // Gegenprobe am echten Feld: Belegt der Browser innen zusätzlichen Platz
    // (z. B. ein Aufklapp-Pfeil der Vorschlagsliste), läuft der Text trotz
    // korrekter Messung über — dann um genau diesen Überhang verbreitern.
    const ueberhang = input.scrollWidth - input.clientWidth;
    if (ueberhang > 0) input.style.width = (breite + ueberhang) + 'px';
  }

  async function speichern() {
    status.textContent = 'speichert …';
    const body = new URLSearchParams();
    body.append('raum', RAUM);
    body.append('plaetze', JSON.stringify(plaetze));
    try {
      const r = await fetch(SPEICHER_URL, { method: 'POST', body });
      status.textContent = r.ok ? 'gespeichert ✓' : 'Fehler beim Speichern';
    } catch (e) {
      status.textContent = 'Fehler beim Speichern';
    }
  }
  const speichernVerzoegert = debounce(speichern, 500);

  function render() {
    blatt.innerHTML = '';
    plaetze.forEach(function(p) {
      const el = document.createElement('div');
      el.className = 'platz';
      el.style.left = p.x + '%';
      el.style.top = p.y + '%';
      el.dataset.id = p.id;

      const griff = document.createElement('span');
      griff.className = 'platz-griff';
      griff.title = 'Verschieben';
      griff.textContent = '⠿';

      const entfernen = document.createElement('button');
      entfernen.type = 'button';
      entfernen.className = 'platz-loeschen';
      entfernen.title = 'Entfernen';
      entfernen.textContent = '×';
      entfernen.addEventListener('click', function() {
        plaetze = plaetze.filter(function(x) { return x.id !== p.id; });
        render();
        speichernVerzoegert();
      });

      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'platz-name';
      input.setAttribute('list', 'schueler-liste');
      input.placeholder = 'Name';
      input.value = p.text;
      input.addEventListener('input', function() {
        p.text = input.value;
        groesseAnpassen(input);
        speichernVerzoegert();
      });

      griff.addEventListener('pointerdown', function(ev) {
        ev.preventDefault();
        const rect = blatt.getBoundingClientRect();
        function aufBewegen(mv) {
          const x = ((mv.clientX - rect.left) / rect.width) * 100;
          const y = ((mv.clientY - rect.top) / rect.height) * 100;
          p.x = Math.min(94, Math.max(0, x));
          p.y = Math.min(90, Math.max(0, y));
          el.style.left = p.x + '%';
          el.style.top = p.y + '%';
        }
        function aufLoslassen() {
          document.removeEventListener('pointermove', aufBewegen);
          document.removeEventListener('pointerup', aufLoslassen);
          speichernVerzoegert();
        }
        document.addEventListener('pointermove', aufBewegen);
        document.addEventListener('pointerup', aufLoslassen);
      });

      el.appendChild(griff);
      el.appendChild(input);
      el.appendChild(entfernen);
      blatt.appendChild(el);
      groesseAnpassen(input); // erst jetzt, eingehängt, stimmt die gemessene Schrift
    });
  }

  document.getElementById('platz-hinzufuegen').addEventListener('click', function() {
    // Leicht versetzt statt immer an derselben Stelle -- sonst lagen mehrere
    // neue Plätze deckungsgleich übereinander und nur der oberste war sichtbar.
    const versatz = plaetze.length % 10;
    plaetze.push({ id: 'p' + (naechsteId++) + '-' + Date.now(), x: 4 + versatz * 2, y: 4 + versatz * 7, text: '' });
    render();
    speichernVerzoegert();
  });

  render();
})();
</script>

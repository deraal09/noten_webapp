<h1>Meine Klassen</h1>
<p><small>
  <% if (kannSelbstKlasseAnlegen) { %>
    Als Lehrkraft mit LDAP-Zugang kannst du eigene Klassen selbst anlegen — eine Zuweisung durch
    den Admin ist nicht nötig, kann aber jederzeit zusätzlich erfolgen (Admin → Zuweisungen).
  <% } else { %>
    Hier erscheinen die Klassen, denen du zugewiesen bist. Eigene Klassen anlegen können nur
    Lehrkräfte mit LDAP-Zugang — bitte eine Klassenleitung oder den Admin bitten, dich einem
    Fach zuzuweisen.
  <% } %>
</small></p>

<% if (wartetAufMich.length) { %>
  <h2>Verknüpfungsanfragen, die auf dich warten</h2>
  <table class="data">
    <thead><tr><th>Klasse</th><th>Schuljahr</th><th>Vorgeschlagenes Fach</th><th>Von</th><th>Aktion</th></tr></thead>
    <tbody>
      <% wartetAufMich.forEach(function(a) { %>
        <tr>
          <td><%= a.klasse_name %></td>
          <td><%= a.schuljahr_bezeichnung %></td>
          <td><%= a.vorgeschlagenes_fach %></td>
          <td><%= a.angefragt_von_name || a.angefragt_von_username %></td>
          <td>
            <form method="post" action="/teacher/verknuepfungen/<%= a.id %>/antwort" class="inline">
              <input type="hidden" name="zustimmung" value="1">
              <button type="submit">✅ Zustimmen</button>
            </form>
            <form method="post" action="/teacher/verknuepfungen/<%= a.id %>/antwort" class="inline">
              <input type="hidden" name="zustimmung" value="0">
              <button type="submit" class="danger">❌ Ablehnen</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<% if (meineAnfragen.length) { %>
  <h2>Meine Verknüpfungsanfragen</h2>
  <table class="data">
    <thead><tr><th>Klasse</th><th>Schuljahr</th><th>Fach</th><th>Status</th></tr></thead>
    <tbody>
      <% meineAnfragen.forEach(function(a) { %>
        <tr>
          <td><%= a.klasse_name %></td>
          <td><%= a.schuljahr_bezeichnung %></td>
          <td><%= a.vorgeschlagenes_fach %></td>
          <td>
            <% if (a.status === 'offen') { %>⏳ offen
            <% } else if (a.status === 'angenommen') { %>✅ angenommen
            <% } else { %>❌ abgelehnt<% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<details>
  <summary>Neue Klasse anlegen</summary>
  <% if (!kannSelbstKlasseAnlegen) { %>
    <p class="hint">
      Eigene Klassen anlegen können nur Lehrkräfte mit LDAP-Zugang. Bitte eine Klassenleitung oder
      den Admin bitten, dich einem Fach zuzuweisen — sobald das geschehen ist, erscheint die
      passende Klasse hier automatisch.
    </p>
  <% } else if (!schuljahre.length) { %>
    <p>Noch kein Schuljahr angelegt. Bitte den Admin bitten, zuerst ein Schuljahr anzulegen.</p>
  <% } else { %>
    <% var hatBekannteNamen = bekannteKlassennamen.length > 0; %>
    <div class="reiter unter-reiter" data-storage-key="klassen-anlegen-modus">
      <% if (hatBekannteNamen) { %>
        <button type="button" class="active" data-target="klasse-anlegen-vorhanden">Vorhandene Klasse wählen</button>
      <% } %>
      <button type="button" class="<%= hatBekannteNamen ? '' : 'active' %>" data-target="klasse-anlegen-neu">Neue Klasse anlegen</button>
    </div>

    <% if (hatBekannteNamen) { %>
      <div id="klasse-anlegen-vorhanden" class="reiter-panel unter-panel card active">
        <form method="post" action="/teacher/klassen/neu">
          <label>Schuljahr
            <select name="schuljahr_id">
              <% schuljahre.forEach(function(s) { %>
                <option value="<%= s.id %>"><%= s.bezeichnung %></option>
              <% }); %>
            </select>
          </label>
          <label>Klasse
            <select name="name" required>
              <option value="">— wählen —</option>
              <% bekannteKlassennamen.forEach(function(n) { %>
                <option value="<%= n %>"><%= n %></option>
              <% }); %>
            </select>
          </label>
          <label>Notenschlüssel
            <select name="notenschluessel">
              <option value="IHK">IHK (1–6)</option>
              <option value="BG">BG (0–15)</option>
            </select>
          </label>
          <button type="submit">+ Klasse anlegen</button>
        </form>
      </div>
    <% } %>

    <div id="klasse-anlegen-neu" class="reiter-panel unter-panel card<%= hatBekannteNamen ? '' : ' active' %>">
      <p class="hint">Für einen Klassennamen, der noch nirgends im System vorkommt.</p>
      <form method="post" action="/teacher/klassen/neu">
        <label>Schuljahr
          <select name="schuljahr_id">
            <% schuljahre.forEach(function(s) { %>
              <option value="<%= s.id %>"><%= s.bezeichnung %></option>
            <% }); %>
          </select>
        </label>
        <label>Klassenname
          <input type="text" name="name" placeholder="z. B. 12BFI1" required>
        </label>
        <label>Notenschlüssel
          <select name="notenschluessel">
            <option value="IHK">IHK (1–6)</option>
            <option value="BG">BG (0–15)</option>
          </select>
        </label>
        <button type="submit">+ Klasse anlegen</button>
      </form>
    </div>
  <% } %>
</details>

<h2>Vorhandene Klassen</h2>
<% if (!schuljahreReiter.length) { %>
  <p>Noch kein Schuljahr angelegt.</p>
<% } else { %>
  <div class="reiter">
    <% schuljahreReiter.forEach(function(sj, i) { %>
      <button type="button" class="<%= i === 0 ? 'active' : '' %>" data-target="sj-panel-<%= sj.id %>"><%= sj.bezeichnung %></button>
    <% }); %>
  </div>
  <% schuljahreReiter.forEach(function(sj, i) {
       var sjKlassen = klassenNachSchuljahr.get(sj.id) || []; %>
    <div id="sj-panel-<%= sj.id %>" class="reiter-panel <%= i === 0 ? 'active' : '' %>">
      <% if (!sjKlassen.length) { %>
        <p>Keine Klassen im Schuljahr <%= sj.bezeichnung %> — leg oben eine an oder warte auf eine Zuweisung.</p>
      <% } else { %>
        <ul class="klasse-liste">
          <% sjKlassen.forEach(function(k) { %>
            <li>
              <a href="/teacher/klassen/<%= k.id %>">
                <div class="kachel-zeile">
                  <span class="kachel-icon-klein">🏫</span>
                  <span class="kachel-titel-klein"><%= k.name %></span>
                </div>
              </a>
              <div class="kachel-sub">Notenschlüssel: <%= k.notenschluessel %></div>
              <div class="kachel-aktionen">
                <a href="/teacher/klassen/<%= k.id %>/sitzplan">🪑 Sitzplan</a>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  <% }); %>
<% } %>

<script>
  // Jede .reiter-Gruppe schaltet nur ihre eigenen Buttons/Panels um --
  // sonst würde z. B. ein Klick im Register "Neue Klasse anlegen" auch die
  // Schuljahres-Reiter weiter unten auf der Seite umschalten.
  document.querySelectorAll('.reiter').forEach(function(gruppe) {
    var buttons = Array.from(gruppe.querySelectorAll(':scope > button'));
    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        buttons.forEach(function(b) {
          b.classList.toggle('active', b === btn);
          var panel = document.getElementById(b.dataset.target);
          if (panel) panel.classList.toggle('active', b === btn);
        });
      });
    });
  });
</script>

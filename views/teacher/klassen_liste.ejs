<h1>Meine Klassen</h1>
<p><small>
  <% if (kannSelbstKlasseAnlegen) { %>
    Als Lehrkraft mit LDAP-Zugang kannst du eigene Klassen selbst anlegen — eine Zuweisung durch
    den Admin ist nicht nötig, kann aber jederzeit zusätzlich erfolgen (Admin → Zuweisungen).
  <% } else { %>
    Hier erscheinen die Klassen, denen du zugewiesen bist. Eigene Klassen anlegen können nur
    Lehrkräfte mit LDAP-Zugang — bitte eine Klassenleitung oder den Admin bitten, dich einem
    Fach zuzuweisen.
  <% } %>
</small></p>

<div class="reiter knopf-reihe">
  <button type="button" data-target="panel-klasse-anlegen">+ Neue Klasse anlegen</button>
  <button type="button" data-target="panel-kurs-anlegen">+ Neuen Kurs anlegen</button>
</div>

<div id="panel-klasse-anlegen" class="reiter-panel">
  <% if (!kannSelbstKlasseAnlegen) { %>
    <p class="hint">
      Eigene Klassen anlegen können nur Lehrkräfte mit LDAP-Zugang. Bitte eine Klassenleitung oder
      den Admin bitten, dich einem Fach zuzuweisen — sobald das geschehen ist, erscheint die
      passende Klasse hier automatisch.
    </p>
  <% } else if (!schuljahre.length) { %>
    <p>Noch kein Schuljahr angelegt. Bitte den Admin bitten, zuerst ein Schuljahr anzulegen.</p>
  <% } else { %>
    <% var hatBekannteNamen = bekannteKlassennamen.length > 0; %>
    <div class="reiter unter-reiter" data-storage-key="klassen-anlegen-modus">
      <% if (hatBekannteNamen) { %>
        <button type="button" class="active" data-target="klasse-anlegen-vorhanden">Vorhandene Klasse wählen</button>
      <% } %>
      <button type="button" class="<%= hatBekannteNamen ? '' : 'active' %>" data-target="klasse-anlegen-neu">Neue Klasse anlegen</button>
    </div>

    <% if (hatBekannteNamen) { %>
      <div id="klasse-anlegen-vorhanden" class="reiter-panel unter-panel card active">
        <form method="post" action="/teacher/klassen/neu">
          <label>Schuljahr
            <select name="schuljahr_id">
              <% schuljahre.forEach(function(s) { %>
                <option value="<%= s.id %>"><%= s.bezeichnung %></option>
              <% }); %>
            </select>
          </label>
          <label>Klasse
            <select name="name" required>
              <option value="">— wählen —</option>
              <% bekannteKlassennamen.forEach(function(n) { %>
                <option value="<%= n %>"><%= n %></option>
              <% }); %>
            </select>
          </label>
          <label>Notenschlüssel
            <select name="notenschluessel" class="ns-auswahl">
              <option value="IHK" selected>IHK (1–6)</option>
              <option value="BG">BG (0–15 Punkte)</option>
              <option value="SPA">SPA (Sozialpädagogische Assistenz)</option>
            </select>
          </label>
          <p class="hint">Bei IHK/BG kann der Admin den Notenschlüssel nachträglich ändern.</p>
          <div class="spa-bildungsgang-auswahl" style="display:none;">
            <p class="hint">
              SPA-Klassen laufen durchgehend über 4 Halbjahre (2 Schuljahre) mit fest vorgegebenen
              Lernfeldern/Fächern — der Bildungsgang bestimmt, welche Fächer/Gewichte gelten, und
              lässt sich danach nicht mehr ändern.
            </p>
            <% bildungsgaenge.forEach(function(bg) { %>
              <label><input type="radio" name="spa_bildungsgang" value="<%= bg.schluessel %>"> <%= bg.bezeichnung %></label>
            <% }); %>
          </div>
          <label>
            <input type="checkbox" name="offen_fuer_beitritt" value="1">
            Automatisch für andere Lehrkräfte freigeben (wer ein Fach mit demselben
            Klassennamen anlegt, bekommt sofort Zugriff, ohne Rückfrage)
          </label>
          <button type="submit">+ Klasse anlegen</button>
        </form>
      </div>
    <% } %>

    <div id="klasse-anlegen-neu" class="reiter-panel unter-panel card<%= hatBekannteNamen ? '' : ' active' %>">
      <p class="hint">Für einen Klassennamen, der noch nirgends im System vorkommt.</p>
      <form method="post" action="/teacher/klassen/neu">
        <label>Schuljahr
          <select name="schuljahr_id">
            <% schuljahre.forEach(function(s) { %>
              <option value="<%= s.id %>"><%= s.bezeichnung %></option>
            <% }); %>
          </select>
        </label>
        <label>Klassenname
          <input type="text" name="name" placeholder="z. B. 12BFI1" required>
        </label>
        <label>Notenschlüssel
          <select name="notenschluessel" class="ns-auswahl">
            <option value="IHK" selected>IHK (1–6)</option>
            <option value="BG">BG (0–15 Punkte)</option>
            <option value="SPA">SPA (Sozialpädagogische Assistenz)</option>
          </select>
        </label>
        <p class="hint">Bei IHK/BG kann der Admin den Notenschlüssel nachträglich ändern.</p>
        <div class="spa-bildungsgang-auswahl" style="display:none;">
          <p class="hint">
            SPA-Klassen laufen durchgehend über 4 Halbjahre (2 Schuljahre) mit fest vorgegebenen
            Lernfeldern/Fächern — der Bildungsgang bestimmt, welche Fächer/Gewichte gelten, und
            lässt sich danach nicht mehr ändern.
          </p>
          <% bildungsgaenge.forEach(function(bg) { %>
            <label><input type="radio" name="spa_bildungsgang" value="<%= bg.schluessel %>"> <%= bg.bezeichnung %></label>
          <% }); %>
        </div>
        <label>
          <input type="checkbox" name="offen_fuer_beitritt" value="1">
          Automatisch für andere Lehrkräfte freigeben (wer ein Fach mit demselben
          Klassennamen anlegt, bekommt sofort Zugriff, ohne Rückfrage)
        </label>
        <button type="submit">+ Klasse anlegen</button>
      </form>
    </div>
  <% } %>
</div>

<div id="panel-kurs-anlegen" class="reiter-panel">
  <% if (!kannSelbstKlasseAnlegen) { %>
    <p class="hint">
      Eigene Kurse anlegen können nur Lehrkräfte mit LDAP-Zugang. Bitte eine Klassenleitung oder
      den Admin bitten, dich einem Fach zuzuweisen.
    </p>
  <% } else if (!schuljahre.length) { %>
    <p>Noch kein Schuljahr angelegt. Bitte den Admin bitten, zuerst ein Schuljahr anzulegen.</p>
  <% } else { %>
    <p class="hint">
      Ein Kurs ist ein Fach, dessen Teilnehmerliste sich frei aus mehreren Klassen desselben
      Schuljahres zusammenstellen lässt, statt an eine feste Klasse gebunden zu sein --
      praktisch, wenn ein Kurs nur einen Teil mehrerer Klassen umfasst, oder klassenübergreifend
      neu zusammengestellt wird (z. B. eine AG oder ein Wahlpflichtkurs). Schüler/innen kommen
      erst danach dazu, auf der Fach-Seite im Reiter „Teilnehmer/innen": aus einer bestehenden
      Klasse ausgewählt, oder manuell mit Namen und Klasse eingetragen -- gibt es diese Klasse
      noch nicht, wird sie dabei still (ohne Klassenleitung) neu angelegt und steht danach jeder
      Lehrkraft offen, die später selbst eine Klasse mit demselben Namen anlegt.
    </p>
    <form method="post" action="/teacher/kurse/neu">
      <label>Kursname
        <input type="text" name="name" placeholder="z. B. Spanisch AG" required>
      </label>
      <label>Schuljahr
        <select name="schuljahr_id">
          <% schuljahre.forEach(function(s) { %>
            <option value="<%= s.id %>"><%= s.bezeichnung %></option>
          <% }); %>
        </select>
      </label>
      <label>Notenschlüssel
        <select name="notenschluessel">
          <option value="IHK" selected>IHK (1–6)</option>
          <option value="BG">BG (0–15 Punkte)</option>
        </select>
      </label>
      <p class="hint">Bei Bedarf kann der Admin den Notenschlüssel nachträglich ändern.</p>
      <button type="submit">+ Kurs anlegen</button>
    </form>
  <% } %>
</div>

<h2>Vorhandene Klassen</h2>
<% if (!schuljahreReiter.length) { %>
  <p>Noch kein Schuljahr angelegt.</p>
<% } else { %>
  <div class="reiter">
    <% schuljahreReiter.forEach(function(sj, i) { %>
      <button type="button" class="<%= i === 0 ? 'active' : '' %>" data-target="sj-panel-<%= sj.id %>"><%= sj.bezeichnung %></button>
    <% }); %>
  </div>
  <% schuljahreReiter.forEach(function(sj, i) {
       var sjKlassen = klassenNachSchuljahr.get(sj.id) || [];
       var sjKurse = kurseNachSchuljahr.get(sj.id) || []; %>
    <div id="sj-panel-<%= sj.id %>" class="reiter-panel <%= i === 0 ? 'active' : '' %>">
      <h3>Klassen</h3>
      <% if (!sjKlassen.length) { %>
        <p>Keine Klassen im Schuljahr <%= sj.bezeichnung %> — leg oben eine an oder warte auf eine Zuweisung.</p>
      <% } else { %>
        <ul class="klasse-liste">
          <% sjKlassen.forEach(function(k) { %>
            <li>
              <a href="/teacher/klassen/<%= k.id %>">
                <div class="kachel-zeile">
                  <span class="kachel-icon-klein">🏫</span>
                  <span class="kachel-titel-klein"><%= k.name %></span>
                </div>
              </a>
              <div class="kachel-sub">Notenschlüssel: <%= k.notenschluessel %></div>
              <div class="kachel-aktionen">
                <a href="/teacher/klassen/<%= k.id %>/sitzplan">🪑 Sitzplan</a>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>

      <h3>Kurse</h3>
      <% if (!sjKurse.length) { %>
        <p class="hint">Keine Kurse im Schuljahr <%= sj.bezeichnung %> — siehe oben „+ Neuen Kurs anlegen".</p>
      <% } else { %>
        <ul class="klasse-liste">
          <% sjKurse.forEach(function(k) { %>
            <li>
              <a href="/teacher/fach/<%= k.id %>">
                <div class="kachel-zeile">
                  <span class="kachel-icon-klein">📘</span>
                  <span class="kachel-titel-klein"><%= k.name %></span>
                </div>
              </a>
              <div class="kachel-sub">
                <% if (!k.klasse_ist_huelle) { %>Ausgangsklasse <%= k.klasse_name %> · <% } %>
                Notenschlüssel <%= k.notenschluessel %> ·
                <%= k.teilnehmer_anzahl %> Teilnehmer/in<%= k.teilnehmer_anzahl === 1 ? '' : 'nen' %>
              </div>
              <div class="kachel-aktionen">
                <a href="/teacher/fach/<%= k.id %>?tab=teilnehmer">👥 Teilnehmer/innen</a>
                <% if (k.darfLoeschen) { %>
                  <form method="post" action="/teacher/faecher/<%= k.id %>/loeschen" class="inline" onsubmit="return confirm('Kurs löschen?')">
                    <button type="submit" class="danger">🗑 Löschen</button>
                  </form>
                <% } %>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  <% }); %>
<% } %>

<script>
  // Jede .reiter-Gruppe schaltet nur ihre eigenen Buttons/Panels um --
  // sonst würde z. B. ein Klick im Register "Neue Klasse anlegen" auch die
  // Schuljahres-Reiter weiter unten auf der Seite umschalten.
  document.querySelectorAll('.reiter').forEach(function(gruppe) {
    var buttons = Array.from(gruppe.querySelectorAll(':scope > button'));
    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        buttons.forEach(function(b) {
          b.classList.toggle('active', b === btn);
          var panel = document.getElementById(b.dataset.target);
          if (panel) panel.classList.toggle('active', b === btn);
        });
      });
    });
  });

  // Bildungsgang-Auswahl nur einblenden, solange "SPA" als Notenschlüssel gewählt ist.
  document.querySelectorAll('.ns-auswahl').forEach(function(select) {
    var form = select.closest('form');
    var block = form && form.querySelector('.spa-bildungsgang-auswahl');
    if (!block) return;
    var aktualisieren = function() {
      block.style.display = select.value === 'SPA' ? '' : 'none';
    };
    select.addEventListener('change', aktualisieren);
    aktualisieren();
  });
</script>

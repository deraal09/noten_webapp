<h1>Sitzpläne</h1>
<p><a href="/start">← Start</a></p>

<% if (!klassen.length) { %>
  <p>Noch keine Klassen mit Zugriff — siehe <a href="/teacher/klassen">Meine Klassen</a>.</p>
<% } else { %>
  <ul class="klasse-liste">
    <% klassen.forEach(function(k) { %>
      <li>
        <a href="/teacher/klassen/<%= k.id %>/sitzplan">
          <div class="kachel-zeile">
            <span class="kachel-icon-klein">🪑</span>
            <span class="kachel-titel-klein"><%= k.name %></span>
          </div>
        </a>
        <div class="kachel-sub"><%= k.schuljahr_bezeichnung %></div>
      </li>
    <% }); %>
  </ul>
<% } %>

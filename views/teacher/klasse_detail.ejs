<h1><%= klasse.name %> <small>(<%= klassenSchuljahrText(klasse) %>)</small></h1>
<% if (!klasse.ist_ablage) { %>
  <p class="klassenleitung-zeile">
    🎓 <strong>Klassenleitung:</strong>
    <% if (klassenleitungNamen.length) { %><%= klassenleitungNamen.join(', ') %><% } else { %><span class="hint">noch niemand eingetragen</span><% } %>
  </p>
<% } %>
<p class="kopf-aktionen">
  <a class="btn" href="/teacher/klassen">← Meine Klassen</a>
  <% if (!klasse.ist_ablage) { %><a class="btn" href="/teacher#klasse-<%= klasse.id %>">📝 Noteneingabe</a><% } %>
  <% if (!klasse.ist_ablage) { %><a class="btn" href="/teacher/klassen/<%= klasse.id %>/sitzplan">🪑 Sitzplan</a><% } %>
  <% if (klasse.notenschluessel === 'SPA' && istKlassenlehrer) { %>
    <a class="btn" href="/teacher/klassen/<%= klasse.id %>/zeugnis">📋 Zeugnisübersicht</a>
  <% } %>
  <% if (kannExportieren) { %>
    <a class="btn" href="/export/klasse/<%= klasse.id %>.csv">📥 CSV-Export</a>
  <% } %>
  <% if (istKlassenlehrer) { %>
    <a class="btn" href="/klassenlehrer/klasse/<%= klasse.id %>">🎓 Klassenleitung</a>
  <% } %>
  <% if (darfVerwalten) { %>
    <form method="post" action="/teacher/klassen/<%= klasse.id %>/loeschen" class="inline" onsubmit="return confirm('<% if (klasse.ist_ablage) { %>Sammelklasse löschen? Die enthaltenen Schüler/innen gehen dabei verloren.<% } else { %>Klasse löschen? Fächer, Klausuren und Noten dieser Klasse gehen verloren. Die Schüler/innen (nur Name) bleiben in der Sammelklasse „Ohne Klasse“ erhalten und können von dort in andere Klassen versetzt werden.<% } %>')">
      <button type="submit" class="danger">🗑 Klasse löschen</button>
    </form>
  <% } %>
</p>

<% if (istKlassenlehrer) { %>
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/offen-fuer-beitritt" class="inline" id="offen-beitritt-form">
    <input type="hidden" name="offen" id="offen-beitritt-wert" value="<%= klasse.offen_fuer_beitritt ? '1' : '0' %>">
    <label>
      <input type="checkbox" id="offen-beitritt-checkbox" <%= klasse.offen_fuer_beitritt ? 'checked' : '' %>>
      Automatisch für andere Lehrkräfte freigeben (wer ein Fach mit demselben Klassennamen anlegt, bekommt sofort Zugriff, ohne Rückfrage)
    </label>
  </form>
  <script>
    (function() {
      var cb = document.getElementById('offen-beitritt-checkbox');
      var hidden = document.getElementById('offen-beitritt-wert');
      var form = document.getElementById('offen-beitritt-form');
      cb.addEventListener('change', function() {
        hidden.value = cb.checked ? '1' : '0';
        form.submit();
      });
    })();
  </script>

  <details class="card" id="einschulungsjahr-festlegen">
    <summary>Einschulungsjahr festlegen <small class="hint">(aktuell <%= laufzeit.schuljahre[0].bezeichnung %>, <%= laufzeit.jahre %> Jahre bis <%= laufzeit.schuljahre[laufzeit.schuljahre.length - 1].bezeichnung %>)</small></summary>
    <p class="hint">
      Eine Klasse läuft über mehrere Schuljahre; die Halbjahre werden ab dem Einschulungsjahr durchgezählt
      (<%= laufzeit.anzahlHalbjahre %> Halbjahre). Lege fest, in welchem Schuljahr die Klasse an die Schule
      gekommen ist und wie viele Jahre sie dort bleibt (z. B. 2 oder 3). Ohne Angabe gilt die Standarddauer
      (SPA 2, BG/IHK 3 Jahre).
    </p>
    <% var optionenJahre = jahresOptionen.map(function(j) { return j.jahr; });
       var alleJahre = jahresOptionen.slice();
       if (optionenJahre.indexOf(laufzeit.einschulungJahr) === -1) { alleJahre.push({ jahr: laufzeit.einschulungJahr, bezeichnung: laufzeit.schuljahre[0].bezeichnung }); }
       alleJahre.sort(function(a, b) { return a.jahr - b.jahr; }); %>
    <form method="post" action="/teacher/klassen/<%= klasse.id %>/laufzeit">
      <input type="hidden" name="zurueck" value="klasse">
      <label>Einschulungsjahr
        <select name="einschulung_jahr">
          <% alleJahre.forEach(function(j) { %><option value="<%= j.jahr %>" <%= j.jahr === laufzeit.einschulungJahr ? 'selected' : '' %>><%= j.bezeichnung %></option><% }); %>
        </select>
      </label>
      <label>Anzahl Jahre an der Schule
        <select name="anzahl_jahre">
          <option value="" <%= laufzeit.abschlussIstStandard ? 'selected' : '' %>>Standard (<%= klasse.notenschluessel === 'SPA' ? 2 : 3 %> Jahre)</option>
          <% for (var aj = 1; aj <= 6; aj++) { %><option value="<%= aj %>" <%= (!laufzeit.abschlussIstStandard && laufzeit.jahre === aj) ? 'selected' : '' %>><%= aj %> <%= aj === 1 ? 'Jahr' : 'Jahre' %></option><% } %>
        </select>
      </label>
      <button type="submit">Speichern</button>
    </form>
  </details>
<% } else if (kannSelbstAlsKlassenlehrerEintragen) { %>
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/klassenlehrer/eintragen" class="inline">
    <button type="submit">Als Klassenleitung eintragen (alle Noten der Klasse sehen, Fächer zuordnen)</button>
  </form>
<% } %>

<h2>Schüler/innen (<%= schueler.length %>)</h2>
<% if (!klasse.ist_ablage || darfVerwalten) { %>
<div class="reiter unter-reiter" data-storage-key="klasse-<%= klasse.id %>-schueler-hinzufuegen">
  <button type="button" class="active" data-target="schueler-einzeln">Einzeln</button>
  <button type="button" data-target="schueler-mehrere">Mehrere auf einmal</button>
  <button type="button" data-target="schueler-csv">CSV-Import</button>
  <% if (ablagePersonen.length) { %>
    <button type="button" data-target="schueler-ablage">Aus „Ohne Klasse“ übernehmen (<%= ablagePersonen.length %>)</button>
  <% } %>
</div>

<div id="schueler-einzeln" class="reiter-panel unter-panel card active">
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/schueler/neu" class="inline">
    <input type="text" name="nachname" placeholder="Nachname" required>
    <input type="text" name="vorname" placeholder="Vorname" required>
    <button type="submit">+ Hinzufügen</button>
  </form>
</div>

<div id="schueler-mehrere" class="reiter-panel unter-panel card">
  <p class="hint">
    Eine Zeile je Person, immer <strong>Nachname zuerst</strong>, getrennt durch Komma, Semikolon, Tab oder Leerzeichen
    (z. B. <code>Müller, Anna</code>, <code>Müller Anna</code> oder aus einer Tabelle kopiert).
    Bei Doppelnamen bitte ein <strong>Komma direkt nach dem Nachnamen</strong> setzen
    (<code>Müller Schmidt, Anna Maria</code>) – sonst ist nicht erkennbar, wo der Nachname endet.
  </p>
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/schueler/bulk">
    <textarea name="text" rows="6" id="bulk-text" placeholder="Müller, Anna
Schmidt Bernd
Meier;Carla"><%= bulkVorbelegung %></textarea>
    <button type="submit">Alle anlegen</button>
  </form>
  <% if (bulkVorbelegung) { %>
    <script>
      // Zur Korrektur zurückgegebene Zeilen: direkt dieses Register öffnen.
      document.addEventListener('DOMContentLoaded', function() {
        var knopf = document.querySelector('.unter-reiter button[data-target="schueler-mehrere"]');
        if (knopf) knopf.click();
        var feld = document.getElementById('bulk-text');
        if (feld) { feld.focus(); feld.setSelectionRange(0, 0); }
      });
    </script>
  <% } %>
</div>

<div id="schueler-csv" class="reiter-panel unter-panel card">
  <p class="hint">
    Erwartet eine Spalte für Nachname und eine für Vorname — mit Kopfzeile
    (z. B. „Nachname"/„Vorname" oder englisch „Name"/„Forename") oder
    ohne (dann werden die ersten beiden Spalten verwendet). Semikolon,
    Komma oder Tab als Trennzeichen werden automatisch erkannt (z. B. für
    eine von Hand aus Untis oder einer anderen Schulverwaltungssoftware
    exportierte Liste).
  </p>
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/schueler/csv" enctype="multipart/form-data">
    <input type="file" name="datei" accept=".csv,text/csv" required>
    <button type="submit">Datei importieren</button>
  </form>
</div>

<% if (ablagePersonen.length) { %>
<div id="schueler-ablage" class="reiter-panel unter-panel card">
  <p class="hint">
    Personen aus der Sammelklasse „Ohne Klasse“ (z. B. nach dem Löschen einer Klasse oder bei
    Wiederholern) auswählen und in diese Klasse übernehmen. Alle bisherigen Noten der Personen bleiben erhalten.
  </p>
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/schueler/aus-ablage">
    <label class="feld">Suche
      <input type="text" id="ablage-suche" placeholder="Name eingeben …" autocomplete="off">
    </label>
    <ul class="klasse-liste" id="ablage-liste">
      <% ablagePersonen.forEach(function(p) { %>
        <li data-name="<%= (p.nachname + ' ' + p.vorname).toLowerCase() %>">
          <label>
            <input type="checkbox" name="schueler_id" value="<%= p.id %>">
            <%= p.nachname %>, <%= p.vorname %> <small class="hint">(<%= p.schuljahr_bezeichnung %><%= p.status === 'abgang' ? ', Abgang' : '' %>)</small>
          </label>
        </li>
      <% }); %>
    </ul>
    <button type="submit">+ Ausgewählte übernehmen</button>
  </form>
  <script>
    (function() {
      var suche = document.getElementById('ablage-suche');
      var eintraege = document.querySelectorAll('#ablage-liste li');
      suche.addEventListener('input', function() {
        var q = suche.value.trim().toLowerCase();
        eintraege.forEach(function(li) { li.hidden = q !== '' && li.dataset.name.indexOf(q) === -1; });
      });
    })();
  </script>
</div>
<% } %>
<% } %>

<% var schuelerAktiv = schueler.filter(function(s) { return s.status !== 'abgang'; });
   var schuelerAbgang = schueler.filter(function(s) { return s.status === 'abgang'; }); %>
<table class="data">
  <thead><tr><th>Nachname</th><th>Vorname</th><% if (darfVerwalten || darfVersetzen) { %><th>Aktion</th><% } %></tr></thead>
  <tbody>
    <% schuelerAktiv.forEach(function(s) { %>
      <tr>
        <td><%= s.nachname %></td>
        <td><%= s.vorname %></td>
        <% if (darfVerwalten || darfVersetzen) { %>
        <td class="aktionen-zelle">
          <button type="button" class="aktionen-knopf" aria-haspopup="true" aria-expanded="false" aria-label="Aktionen für <%= s.vorname %> <%= s.nachname %>" title="Aktionen">
            <span class="drei-balken" aria-hidden="true"><span></span><span></span><span></span></span>
          </button>
          <div class="aktionen-inhalt" hidden>
            <% if (versetzZiele.length) { %>
              <button type="button" class="menue-eintrag" data-versetzen data-sid="<%= s.id %>" data-name="<%= s.vorname %> <%= s.nachname %>" title="In eine andere Klasse versetzen (Noten bleiben erhalten)">↔ Versetzen …</button>
            <% } %>
            <% if (darfVerwalten) { %>
              <form method="post" action="/teacher/schueler/<%= s.id %>/abgang" onsubmit="return confirm('Abgang aus der Klasse eintragen? Die Person zählt danach nicht mehr als aktuelle/r Schüler/in, alle bisherigen Noten bleiben aber erhalten.')">
                <button type="submit" class="menue-eintrag" name="zeugnis" value="0" title="Abgang aus der Klasse (Noten bleiben erhalten)">🚪 Abgang</button>
                <button type="submit" class="menue-eintrag" name="zeugnis" value="1" title="Abgang eintragen und direkt das Abgangszeugnis mit allen Noten erstellen">🚪🎓 Abgang + Abgangszeugnis</button>
              </form>
              <form method="post" action="/teacher/schueler/<%= s.id %>/loeschen" onsubmit="return confirm('Schüler/in komplett löschen? ALLE Noten gehen dabei unwiderruflich verloren. Für einen normalen Abgang stattdessen den Eintrag „🚪 Abgang“ nutzen.')">
                <button type="submit" class="menue-eintrag danger" title="Komplett löschen (Noten gehen verloren)">🗑 Löschen</button>
              </form>
            <% } %>
          </div>
        </td>
        <% } %>
      </tr>
    <% }); %>
  </tbody>
</table>

<% if (schuelerAbgang.length) { %>
  <details class="card">
    <summary>Ehemalige Schüler/innen (Abgang, <%= schuelerAbgang.length %>)</summary>
    <table class="data">
      <thead><tr><th>Nachname</th><th>Vorname</th><th>Abgang am</th><% if (darfVerwalten) { %><th>Aktion</th><% } %></tr></thead>
      <tbody>
        <% schuelerAbgang.forEach(function(s) { %>
          <tr>
            <td><%= s.nachname %></td>
            <td><%= s.vorname %></td>
            <td><%= s.abgang_am ? formatZeitLokal(s.abgang_am) : '–' %></td>
            <% if (darfVerwalten) { %>
            <td class="aktionen-zelle">
              <button type="button" class="aktionen-knopf" aria-haspopup="true" aria-expanded="false" aria-label="Aktionen für <%= s.vorname %> <%= s.nachname %>" title="Aktionen">
                <span class="drei-balken" aria-hidden="true"><span></span><span></span><span></span></span>
              </button>
              <div class="aktionen-inhalt" hidden>
                <a class="menue-eintrag" href="/teacher/schueler/<%= s.id %>/abgangszeugnis">🎓 Abgangszeugnis</a>
                <form method="post" action="/teacher/schueler/<%= s.id %>/reaktivieren">
                  <button type="submit" class="menue-eintrag" title="Abgang rückgängig machen">↩ Reaktivieren</button>
                </form>
                <form method="post" action="/teacher/schueler/<%= s.id %>/loeschen" onsubmit="return confirm('Schüler/in komplett löschen? ALLE Noten gehen dabei unwiderruflich verloren.')">
                  <button type="submit" class="menue-eintrag danger" title="Komplett löschen (Noten gehen verloren)">🗑 Löschen</button>
                </form>
              </div>
            </td>
            <% } %>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </details>
<% } %>

<div id="aktionen-popover" class="aktionen-popover" role="menu" hidden></div>

<% if (versetzZiele.length) { %>
<dialog id="versetzen-dialog" class="notiz-dialog">
  <form method="post" id="versetzen-form" action="">
    <h2>Versetzen: <span id="versetzen-name"></span></h2>
    <p class="hint">Alle bisherigen Noten bleiben der Person erhalten.</p>
    <label>Zielklasse
      <select name="ziel_klasse_id" required>
        <option value="">— Klasse wählen —</option>
        <% if (!klasse.ist_ablage) { %><option value="ohne-klasse">Ohne Klasse</option><% } %>
        <% versetzZiele.filter(function(z) { return !z.ist_ablage; }).forEach(function(z) { %>
          <option value="<%= z.id %>"><%= z.name %> (<%= z.schuljahr_bezeichnung %>)</option>
        <% }); %>
        <% versetzZiele.filter(function(z) { return z.ist_ablage; }).forEach(function(z) { %>
          <option value="<%= z.id %>"><%= z.name %> (<%= z.schuljahr_bezeichnung %>)</option>
        <% }); %>
      </select>
    </label>
    <div class="form-actions">
      <button type="submit">↔ Versetzen</button>
      <button type="button" id="versetzen-abbrechen">Abbrechen</button>
    </div>
  </form>
</dialog>
<% } %>

<script>
  // Aktionen je Person hinter den "drei Balken": ein gemeinsames Menü am Seitenende (wird
  // nicht von der scrollbaren Tabelle abgeschnitten); "Versetzen" öffnet einen Dialog.
  (function() {
    var pop = document.getElementById('aktionen-popover');
    var offen = null;
    function schliessen() {
      if (offen) { offen.setAttribute('aria-expanded', 'false'); offen = null; }
      pop.hidden = true; pop.textContent = '';
    }
    document.querySelectorAll('.aktionen-knopf').forEach(function(knopf) {
      knopf.addEventListener('click', function(e) {
        e.stopPropagation();
        if (offen === knopf) { schliessen(); return; }
        schliessen();
        var inhalt = knopf.parentElement.querySelector('.aktionen-inhalt');
        Array.from(inhalt.children).forEach(function(kind) { pop.appendChild(kind.cloneNode(true)); });
        pop.hidden = false;
        var r = knopf.getBoundingClientRect();
        var breite = pop.offsetWidth;
        pop.style.top = (window.scrollY + r.bottom + 4) + 'px';
        pop.style.left = Math.max(8, window.scrollX + Math.min(r.right - breite, document.documentElement.clientWidth - breite - 8)) + 'px';
        knopf.setAttribute('aria-expanded', 'true');
        offen = knopf;
        var erster = pop.querySelector('button, a'); if (erster) erster.focus();
      });
    });
    document.addEventListener('click', function(e) {
      var ziel = e.target.closest('[data-versetzen]');
      if (ziel) {
        var dlg = document.getElementById('versetzen-dialog');
        document.getElementById('versetzen-form').action = '/teacher/schueler/' + ziel.dataset.sid + '/versetzen';
        document.getElementById('versetzen-name').textContent = ziel.dataset.name;
        schliessen();
        dlg.showModal();
        return;
      }
      if (offen && !pop.contains(e.target)) schliessen();
    });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') schliessen(); });
    window.addEventListener('resize', schliessen);
    var abbrechen = document.getElementById('versetzen-abbrechen');
    if (abbrechen) abbrechen.addEventListener('click', function() { document.getElementById('versetzen-dialog').close(); });
  })();
</script>

<% if (!klasse.ist_ablage) { %>
<h2 id="faecher-lehrkraefte">Fächer und Lehrkräftezuordnung</h2>
<p><small>Ein neu angelegtes Fach wird dir automatisch zugewiesen.
  <% if (istKlassenlehrer) { %>Als Klassenleitung stellst du alles zu einem Fach über das Zahnrad (⚙) ein: Name, Halbjahre, Lehrkräfte je Halbjahr, Unterfächer, Verrechnung, Teilnehmer/innen und Löschen.
  <% } else { %>Lehrkräfte kann die Klassenleitung oder der Admin zuordnen.<% } %></small></p>
<%
  function hjBereiche(nummern) {
    var teile = []; var start = null; var vor = null;
    nummern.forEach(function(n) {
      if (start === null) { start = n; vor = n; }
      else if (n === vor + 1) { vor = n; }
      else { teile.push(start === vor ? start + '' : start + '–' + vor); start = n; vor = n; }
    });
    if (start !== null) teile.push(start === vor ? start + '' : start + '–' + vor);
    return teile.join(', ');
  }
  // Beschriftung einer Halbjahres-Menge samt Schuljahr(en), z. B. "1.–2. Halbjahr (2025/26)"
  function hjText(nummern) {
    if (!nummern.length) return '–';
    if (nummern.length === laufzeit.anzahlHalbjahre) return 'alle Halbjahre';
    var sj = [];
    nummern.forEach(function(n) { var b = laufzeit.schuljahre[Math.floor((n - 1) / 2)].bezeichnung; if (sj.indexOf(b) === -1) sj.push(b); });
    return hjBereiche(nummern) + '. Halbjahr (' + sj.join(', ') + ')';
  }
  // Name eines (Unter-)Fachs: Link zur Noteneingabe (Einstellungen: ⚙ am Fach).
  function fachNameElement(f, anzeige) {
    return '<a class="fach-name" href="/teacher/fach/' + f.id + '">' + anzeige + '</a>';
  }
  // Prozent-Felder der Verrechnung (p_<n>), vorbelegt mit `werte`
  function vrFelder(werte) {
    if (laufzeit.anzahlHalbjahre < 2) return '';
    var h = '<fieldset class="hj-auswahl"><legend>Verrechnung der Halbjahre <small>(Prozent der Vorhalbjahres-Note)</small></legend><div class="verrechnung-raster">';
    for (var n = 1; n < laufzeit.anzahlHalbjahre; n++) {
      h += '<label class="feld">' + n + '. → ' + (n + 1) + '. Halbjahr <span class="feld-mit-einheit"><input type="number" name="p_' + n + '" min="0" max="100" step="1" value="' + ((werte && werte[String(n)]) || 0) + '">%</span></label>';
    }
    return h + '</div></fieldset>';
  }
  // Checkbox-Reihe für Halbjahre (name="halbjahre"), nur die erlaubten Nummern
  function hjChecks(erlaubt, gewaehlt) {
    return erlaubt.map(function(n) {
      return '<label class="hj-check"><input type="checkbox" name="halbjahre" value="' + n + '"' + (gewaehlt.indexOf(n) !== -1 ? ' checked' : '') + '> ' + n + '</label>';
    }).join(' ');
  }
%>

<% function zeigeLehrkraefte(fachId, erlaubtFuerBearbeiten) { %>
  <% var liste = zuweisungenProFach[fachId] || []; %>
  <% if (liste.length) { %>
    <ul class="lehrkraefte-liste">
      <% liste.forEach(function(z) { %>
        <li>
          <span class="lehrkraft-name">🎓 <%= z.name %></span>
          <span class="hint lehrkraft-hj"><%= hjText(z.halbjahre) %></span>
          <% if (z.selbst && z.user_id === user.id) { %>
            <form method="post" action="/teacher/zuweisungen/<%= z.id %>/selbst-austragen" class="inline" onsubmit="return confirm('Dich aus diesem Fach austragen? Es ist danach wieder frei für andere Lehrkräfte.')">
              <button type="submit" title="Dich selbst wieder austragen">Austragen</button>
            </form>
          <% } %>
        </li>
      <% }); %>
    </ul>
  <% } %>
<% } %>

<% var verrechenbareFaecher = baum.filter(function(e) { return verrechnungProFach[e.fach.id]; }); %>
<% if (istKlassenlehrer && laufzeit.anzahlHalbjahre >= 2 && verrechenbareFaecher.length) { %>
<details class="card" id="verrechnung">
  <summary>Verrechnung der Halbjahre</summary>
  <p class="hint">
    Übersicht: Je Fach steht hier, zu wie viel Prozent die Note eines Halbjahres in das <strong>nächste</strong> Halbjahr einfließt
    (0 % = gar nicht). Beispiel: 50 % bei „1. → 2. Halbjahr" – die Note des 2. Halbjahres besteht je zur Hälfte aus den
    Leistungen des 2. Halbjahres und der (endgültigen) Note des 1. Halbjahres. Gilt für Fächer, nicht für Unterfächer
    (die fließen gewichtet ins Fach) und nicht für SPA-Fächer. Eingestellt wird die Verrechnung über das ⚙ am Fach.
  </p>
  <table class="data">
    <thead><tr><th>Fach</th><th>Verrechnung</th><th></th></tr></thead>
    <tbody>
      <% verrechenbareFaecher.forEach(function(e) {
           var v = verrechnungProFach[e.fach.id];
           var teile = [];
           for (var vn = 1; vn < laufzeit.anzahlHalbjahre; vn++) { if (v.werte[String(vn)]) teile.push(vn + '. → ' + (vn + 1) + '.: ' + String(v.werte[String(vn)]).replace('.', ',') + ' %'); } %>
        <tr>
          <td><%= e.fach.name %></td>
          <td><%= teile.length ? teile.join(' · ') : 'keine' %><% if (!v.eigene && teile.length) { %> <small class="hint">(Vorgabe der Klasse)</small><% } %></td>
          <td><a class="icon-knopf" href="/teacher/faecher/<%= e.fach.id %>/einstellungen" title="Fach einstellen (Verrechnung, Halbjahre, Unterfächer)" aria-label="Fach einstellen: <%= e.fach.name %>">⚙</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</details>

<% } %>

<% function zeigeFaecherBaum(liste, leerText) { %>
<ul class="faecher-baum">
  <% liste.forEach(function(eintrag) {
       var f = eintrag.fach; %>
    <li class="fach-eintrag">
      <div class="fach-zeile">
        <div class="fach-kopf">
          <%- fachNameElement(f, f.name.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'), false, laufzeit.halbjahre.map(function(h, i) { return i + 1; })) %>
          <span class="hint fach-hj"><%= f.hjNummern.length === laufzeit.anzahlHalbjahre ? 'alle Halbjahre' : hjBereiche(f.hjNummern) + '. Hj.' %></span>
        </div>
        <%# Ein einziges Symbol: ⚙ -- dort stehen Name, Halbjahre, Lehrkräfte, Unterfächer, Teilnehmer und Löschen (Reiter). %>
        <div class="fach-aktionen" role="group" aria-label="Aktionen für <%= f.name %>">
          <span class="aktion-platz">
            <% if (darfVerwalten) { %>
              <a class="icon-knopf" href="/teacher/faecher/<%= f.id %>/<%= f.spa_fach_key ? 'spa-schema' : 'einstellungen' %>" title="Fach einstellen: Name, Halbjahre, Lehrkräfte, Unterfächer, Teilnehmer, Löschen" aria-label="Fach einstellen: <%= f.name %>">⚙</a>
            <% } else if (istKlassenlehrer) { %>
              <a class="icon-knopf" href="/teacher/faecher/<%= f.id %>/lehrkraefte" title="Lehrkräfte des Fachs zuordnen" aria-label="Fach einstellen: <%= f.name %>">⚙</a>
            <% } %>
          </span>
        </div>
      </div>
      <% zeigeLehrkraefte(f.id, eintrag.freieHj); %>
      <% if ((freiProFach[f.id] || []).length) { %>
        <form method="post" action="/teacher/faecher/<%= f.id %>/selbst-eintragen" class="inline">
          <button type="submit" title="Für die Halbjahre ohne Lehrkraft (<%= freiProFach[f.id].map(function(n) { return n + '.'; }).join(', ') %> Hj.) eintragen">🎓 Für dieses Fach eintragen</button>
        </form>
      <% } %>
      <% if (eintrag.kinder.length) { %>
        <ul class="unterfaecher-liste">
          <% eintrag.kinder.forEach(function(u) { %>
            <li class="fach-eintrag unterfach">
              <div class="fach-zeile">
                <div class="fach-kopf">
                  <span class="hint">📖</span>
                  <%- fachNameElement(u, (u.kurzname || u.name).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'), true, f.hjNummern) %>
                  <% if (u.komponenteInfo && !(u.komponenteInfo.schaltbar && istKlassenlehrer)) { %>
                    <span class="hint" title="<%= u.komponenteInfo.schaltbar ? 'Zusammensetzung nur durch die Klassenleitung änderbar' : 'Festes Gewicht, nicht abschaltbar' %>"><%= u.hjNummern.length ? hjBereiche(u.hjNummern) + '. Hj.' : 'abgeschaltet' %><%= u.komponenteInfo.schaltbar ? '' : ' · fest' %></span>
                  <% } else { %>
                    <span class="hint fach-hj"><%= (!u.hjNummern.length ? 'abgeschaltet' : (u.hjNummern.length === (u.komponenteInfo ? u.komponenteInfo.alle.length : laufzeit.anzahlHalbjahre) ? 'alle Halbjahre' : hjBereiche(u.hjNummern) + '. Hj.')) %></span>
                  <% } %>
                </div>
              </div>
              <% zeigeLehrkraefte(u.id, u.hjNummern); %>
              <% if ((freiProFach[u.id] || []).length) { %>
                <form method="post" action="/teacher/faecher/<%= u.id %>/selbst-eintragen" class="inline">
                  <button type="submit" title="Für die Halbjahre ohne Lehrkraft eintragen">🎓 Eintragen</button>
                </form>
              <% } %>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </li>
  <% }); %>
  <% if (!liste.length) { %><li class="hint"><%= leerText %></li><% } %>
</ul>
<% } %>

<%
  // Wer nicht Klassenleitung ist, sieht die eigenen Fächer immer; die übrigen klappt "Weitere Fächer" darunter auf.
  // Die Klassenleitung hat diesen Knopf nicht: sie sieht alle Fächer immer.
  function istMeinFach(id) { return (zuweisungenProFach[id] || []).some(function(z) { return z.user_id === user.id; }); }
  var eigeneBaum = baum.filter(function(e) { return istMeinFach(e.fach.id) || e.kinder.some(function(u) { return istMeinFach(u.id); }); });
  var weitereBaum = baum.filter(function(e) { return eigeneBaum.indexOf(e) === -1; });
  var mitReitern = !istKlassenlehrer && weitereBaum.length > 0;
%>
<% if (mitReitern) { %>
  <% zeigeFaecherBaum(eigeneBaum, 'Du bist in dieser Klasse noch in keinem Fach eingetragen -- unter „Weitere Fächer“ kannst du dich bei freien Fächern eintragen.'); %>
  <details class="weitere-aufklappbar" id="weitere-faecher" data-key="klasse-weitere-faecher-<%= klasse.id %>"<%= eigeneBaum.length ? '' : ' open' %>>
    <summary>Weitere Fächer (<%= weitereBaum.length %>)</summary>
    <% zeigeFaecherBaum(weitereBaum, ''); %>
  </details>
  <script>
    // Aufgeklappt = alle Fächer der Klasse, zugeklappt = nur die eigenen; die Wahl wird im Browser gemerkt.
    (function() {
      var d = document.getElementById('weitere-faecher');
      try {
        var v = localStorage.getItem(d.dataset.key);
        if (v === '1') d.open = true; else if (v === '0') d.open = false;
      } catch (e) { /* ohne Speicher */ }
      d.addEventListener('toggle', function() { try { localStorage.setItem(d.dataset.key, d.open ? '1' : '0'); } catch (e) { /* ohne Speicher */ } });
    })();
  </script>
<% } else { %>
  <% zeigeFaecherBaum(baum, 'Noch keine Fächer.'); %>
<% } %>

<p class="knopf-leiste">
  <button type="button" id="fach-neu-knopf">+ Neues Fach anlegen</button>
  <button type="button" id="vorlage-import-knopf">📥 Fächer aus Vorlage importieren</button>
  <% if (speicherbareFaecher.length) { %><button type="button" id="vorlage-speichern-knopf">💾 Fächer als Vorlage speichern</button><% } %>
</p>

<% if (klasse.notenschluessel === 'SPA' && istKlassenlehrer) { %>
  <details class="card" id="spa-vorlage-laden">
    <summary>📥 SPA-Fächervorgabe laden</summary>
    <p class="hint">
      Legt die Fächer einer Vorlage an, die es in dieser Klasse noch nicht gibt (vorhandene Fächer bleiben unverändert).
      Das Bewertungsschema jedes Fachs lässt sich danach mit ⚙ einzeln anpassen.
    </p>
    <form method="post" action="/teacher/klassen/<%= klasse.id %>/spa-vorlage/laden">
      <label>Fächervorgabe
        <select name="quelle">
          <option value="standard">Standard-Vorgabe des Bildungsgangs</option>
          <% spaVorlagen.forEach(function(v) { %><option value="<%= v.id %>">Vorlage „<%= v.name %>“ (<%= v.bildungsgang === 'SPA_PIA' ? 'PiA' : 'regulär' %>)</option><% }); %>
        </select>
      </label>
      <button type="submit">Fächer laden</button>
      <a href="/teacher/spa-vorlagen">SPA-Vorlagen bearbeiten oder neu erstellen</a>
    </form>
    <form method="post" action="/teacher/klassen/<%= klasse.id %>/spa-vorlage/speichern" class="inline">
      <label>Fächer dieser Klasse als Vorlage ablegen
        <input type="text" name="name" maxlength="100" placeholder="Name der Vorlage" required>
      </label>
      <button type="submit">💾 Als Vorlage speichern</button>
    </form>
  </details>
<% } %>

<dialog id="vorlage-import-dialog" class="notiz-dialog">
  <h2>Fächer aus Vorlage importieren</h2>
  <% if (!vorlagen.length) { %>
    <p class="hint">Es gibt noch keine Vorlage für den Notenschlüssel <%= klasse.notenschluessel %>. Lege Fächer an und speichere sie mit „Fächer als Vorlage speichern".</p>
  <% } else { %>
    <p class="hint">
      Importiert die Fächer (mit Unterfächern, Halbjahren und Gewichten) der gewählten Vorlage in diese Klasse.
      Bereits vorhandene Fächer bleiben unverändert. Die Lehrkraftzuordnung ist nicht Teil der Vorlage –
      die importierten Fächer starten ohne Lehrkraft und werden danach neu zugeordnet.
    </p>
    <% if (vorlagen.length > 1) { %>
      <label class="vorlage-filter">Vorlagen filtern
        <input type="search" id="vorlage-filter" placeholder="Name oder Fach, z. B. Informatik" autocomplete="off">
      </label>
      <p class="hint" id="vorlage-filter-leer" hidden>Keine passende Vorlage.</p>
    <% } %>
    <% vorlagen.forEach(function(v) { %>
      <div class="vorlage-eintrag" data-suche="<%= (v.name + ' ' + v.faecher.map(function(f) { return f.name + ' ' + f.unterfaecher.join(' '); }).join(' ')).toLowerCase() %>">
        <form method="post" action="/teacher/klassen/<%= klasse.id %>/vorlagen/importieren">
          <input type="hidden" name="vorlage_id" value="<%= v.id %>">
          <strong><%= v.name %></strong>
          <div class="hint"><%= v.faecher.map(function(f) { return f.name + (f.unterfaecher.length ? ' (' + f.unterfaecher.join(', ') + ')' : ''); }).join(' · ') %></div>
          <button type="submit">Importieren</button>
        </form>
        <form method="post" action="/teacher/vorlagen/<%= v.id %>/loeschen" class="inline" onsubmit="return confirm('Vorlage „<%= v.name.replace(/'/g, '') %>“ löschen?')">
          <input type="hidden" name="klasse_id" value="<%= klasse.id %>">
          <button type="submit" class="icon-knopf danger" title="Vorlage löschen" aria-label="Vorlage <%= v.name %> löschen">🗑</button>
        </form>
      </div>
    <% }); %>
  <% } %>
  <div class="form-actions"><button type="button" data-vorlage-zu>Schließen</button></div>
</dialog>

<% if (speicherbareFaecher.length) { %>
<dialog id="vorlage-speichern-dialog" class="notiz-dialog">
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/vorlagen/speichern">
    <h2>Fächer als Vorlage speichern</h2>
    <p class="hint">Speichert Fächer, Unterfächer, Halbjahre, Gewichte und Verrechnung – ohne Lehrkräfte. Eine Vorlage mit gleichem Namen wird ersetzt.</p>
    <label>Name der Vorlage
      <input type="text" name="name" maxlength="100" placeholder="z. B. Fachinformatiker 3 Jahre" required>
    </label>
    <fieldset class="hj-auswahl"><legend>Fächer</legend>
      <% speicherbareFaecher.forEach(function(f) { %>
        <label class="hj-check"><input type="checkbox" name="fach_ids" value="<%= f.id %>" checked> <%= f.name %></label>
      <% }); %>
    </fieldset>
    <div class="form-actions">
      <button type="submit">Als Vorlage speichern</button>
      <button type="button" data-vorlage-zu>Abbrechen</button>
    </div>
  </form>
</dialog>
<% } %>
<script>
  (function() {
    function oeffne(knopfId, dialogId) {
      var k = document.getElementById(knopfId), d = document.getElementById(dialogId);
      if (k && d) k.addEventListener('click', function() { d.showModal(); });
    }
    oeffne('vorlage-import-knopf', 'vorlage-import-dialog');
    oeffne('vorlage-speichern-knopf', 'vorlage-speichern-dialog');
    var filter = document.getElementById('vorlage-filter');
    if (filter) {
      var hinweis = document.getElementById('vorlage-filter-leer');
      filter.addEventListener('input', function() {
        var begriffe = filter.value.toLowerCase().split(/\s+/).filter(Boolean);
        var treffer = 0;
        document.querySelectorAll('.vorlage-eintrag').forEach(function(e) {
          var passt = begriffe.every(function(b) { return (e.dataset.suche || '').indexOf(b) !== -1; });
          e.hidden = !passt;
          if (passt) treffer++;
        });
        hinweis.hidden = treffer > 0;
      });
      document.getElementById('vorlage-import-knopf').addEventListener('click', function() { setTimeout(function() { filter.focus(); }, 0); });
    }
    document.querySelectorAll('[data-vorlage-zu]').forEach(function(b) {
      b.addEventListener('click', function() { b.closest('dialog').close(); });
    });
  })();
</script>

<dialog id="fach-neu-dialog" class="notiz-dialog">
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/faecher/neu">
    <h2>Neues Fach anlegen</h2>
    <label>Name des Fachs
      <input type="text" name="name" placeholder="z. B. Mathematik" maxlength="100" required>
    </label>
    <fieldset class="hj-auswahl">
      <legend>Gilt in diesen Halbjahren</legend>
      <% laufzeit.halbjahre.forEach(function(h, i) { %>
        <label class="hj-check"><input type="checkbox" name="halbjahre" value="<%= i + 1 %>" <%= vorbelegungHj.indexOf(i + 1) !== -1 ? 'checked' : '' %>>
          <%= i + 1 %>. Halbjahr <small>(<%= laufzeit.schuljahre[Math.floor(i / 2)].bezeichnung %>)</small></label>
      <% }); %>
    </fieldset>
    <% if (istKlassenlehrer && laufzeit.anzahlHalbjahre >= 2) { %>
      <input type="hidden" name="verrechnung_gesetzt" value="1">
      <%- vrFelder(klassenVerrechnung) %>
    <% } %>
    <div class="form-actions">
      <button type="submit">+ Fach anlegen</button>
      <button type="button" id="fach-neu-zu">Abbrechen</button>
    </div>
  </form>
</dialog>
<script>
  (function() {
    var dialog = document.getElementById('fach-neu-dialog');
    document.getElementById('fach-neu-knopf').addEventListener('click', function() {
      dialog.showModal();
      var feld = dialog.querySelector('input[name="name"]');
      if (feld) feld.focus();
    });
    document.getElementById('fach-neu-zu').addEventListener('click', function() { dialog.close(); });
  })();
</script>

<% } %>

<script>
  // Register (Einzeln/Mehrere auf einmal/CSV-Import) umschalten, gewählter
  // Reiter bleibt über localStorage auch nach einem vollen Reload erhalten
  // (z. B. nach dem Anlegen eines Schülers oder einem CSV-Upload).
  document.querySelectorAll('.reiter').forEach(function(gruppe) {
    var buttons = Array.from(gruppe.querySelectorAll(':scope > button'));
    var storageKey = gruppe.dataset.storageKey;
    function setzeReiter(targetId) {
      buttons.forEach(function(b) {
        b.classList.toggle('active', b.dataset.target === targetId);
        var panel = document.getElementById(b.dataset.target);
        if (panel) panel.classList.toggle('active', b.dataset.target === targetId);
      });
    }
    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        setzeReiter(btn.dataset.target);
        if (storageKey) {
          try { localStorage.setItem(storageKey, btn.dataset.target); } catch (e) { /* z. B. privater Modus */ }
        }
      });
    });
    if (storageKey) {
      try {
        var gemerkterReiter = localStorage.getItem(storageKey);
        if (gemerkterReiter && document.getElementById(gemerkterReiter)) setzeReiter(gemerkterReiter);
      } catch (e) { /* z. B. privater Modus */ }
    }
  });
</script>

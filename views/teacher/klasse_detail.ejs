<h1><%= klasse.name %> <small>(<%= klasse.schuljahr_bezeichnung %>)</small></h1>
<p class="kopf-aktionen">
  <a class="btn" href="/teacher/klassen">← Meine Klassen</a>
  <% if (!klasse.ist_ablage) { %><a class="btn" href="/teacher#klasse-<%= klasse.id %>">📝 Noteneingabe</a><% } %>
  <% if (!klasse.ist_ablage) { %><a class="btn" href="/teacher/klassen/<%= klasse.id %>/sitzplan">🪑 Sitzplan</a><% } %>
  <% if (klasse.notenschluessel === 'SPA' && istKlassenlehrer) { %>
    <a class="btn" href="/teacher/klassen/<%= klasse.id %>/zeugnis">📋 Zeugnisübersicht</a>
  <% } %>
  <% if (kannExportieren) { %>
    <a class="btn" href="/export/klasse/<%= klasse.id %>.csv">📥 CSV-Export</a>
  <% } %>
  <% if (istKlassenlehrer) { %>
    <a class="btn" href="/klassenlehrer/klasse/<%= klasse.id %>">🎓 Klassenleitung</a>
  <% } %>
  <% if (darfVerwalten) { %>
    <form method="post" action="/teacher/klassen/<%= klasse.id %>/loeschen" class="inline" onsubmit="return confirm('<% if (klasse.ist_ablage) { %>Sammelklasse löschen? Die enthaltenen Schüler/innen gehen dabei verloren.<% } else { %>Klasse löschen? Fächer, Klausuren und Noten dieser Klasse gehen verloren. Die Schüler/innen (nur Name) bleiben in der Sammelklasse „Ohne Klasse“ erhalten und können von dort in andere Klassen versetzt werden.<% } %>')">
      <button type="submit" class="danger">🗑 Klasse löschen</button>
    </form>
  <% } %>
</p>

<% if (istKlassenlehrer) { %>
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/offen-fuer-beitritt" class="inline" id="offen-beitritt-form">
    <input type="hidden" name="offen" id="offen-beitritt-wert" value="<%= klasse.offen_fuer_beitritt ? '1' : '0' %>">
    <label>
      <input type="checkbox" id="offen-beitritt-checkbox" <%= klasse.offen_fuer_beitritt ? 'checked' : '' %>>
      Automatisch für andere Lehrkräfte freigeben (wer ein Fach mit demselben Klassennamen anlegt, bekommt sofort Zugriff, ohne Rückfrage)
    </label>
  </form>
  <script>
    (function() {
      var cb = document.getElementById('offen-beitritt-checkbox');
      var hidden = document.getElementById('offen-beitritt-wert');
      var form = document.getElementById('offen-beitritt-form');
      cb.addEventListener('change', function() {
        hidden.value = cb.checked ? '1' : '0';
        form.submit();
      });
    })();
  </script>

  <details class="card" id="einschulungsjahr-festlegen">
    <summary>Einschulungsjahr festlegen <small class="hint">(aktuell <%= laufzeit.schuljahre[0].bezeichnung %>, <%= laufzeit.jahre %> Jahre bis <%= laufzeit.schuljahre[laufzeit.schuljahre.length - 1].bezeichnung %>)</small></summary>
    <p class="hint">
      Eine Klasse läuft über mehrere Schuljahre; die Halbjahre werden ab dem Einschulungsjahr durchgezählt
      (<%= laufzeit.anzahlHalbjahre %> Halbjahre). Lege fest, in welchem Schuljahr die Klasse an die Schule
      gekommen ist und wie viele Jahre sie dort bleibt (z. B. 2 oder 3). Ohne Angabe gilt die Standarddauer
      (SPA 2, BG/IHK 3 Jahre).
    </p>
    <% var optionenJahre = jahresOptionen.map(function(j) { return j.jahr; });
       var alleJahre = jahresOptionen.slice();
       if (optionenJahre.indexOf(laufzeit.einschulungJahr) === -1) { alleJahre.push({ jahr: laufzeit.einschulungJahr, bezeichnung: laufzeit.schuljahre[0].bezeichnung }); }
       alleJahre.sort(function(a, b) { return a.jahr - b.jahr; }); %>
    <form method="post" action="/teacher/klassen/<%= klasse.id %>/laufzeit">
      <input type="hidden" name="zurueck" value="klasse">
      <label>Einschulungsjahr
        <select name="einschulung_jahr">
          <% alleJahre.forEach(function(j) { %><option value="<%= j.jahr %>" <%= j.jahr === laufzeit.einschulungJahr ? 'selected' : '' %>><%= j.bezeichnung %></option><% }); %>
        </select>
      </label>
      <label>Anzahl Jahre an der Schule
        <select name="anzahl_jahre">
          <option value="" <%= laufzeit.abschlussIstStandard ? 'selected' : '' %>>Standard (<%= klasse.notenschluessel === 'SPA' ? 2 : 3 %> Jahre)</option>
          <% for (var aj = 1; aj <= 6; aj++) { %><option value="<%= aj %>" <%= (!laufzeit.abschlussIstStandard && laufzeit.jahre === aj) ? 'selected' : '' %>><%= aj %> <%= aj === 1 ? 'Jahr' : 'Jahre' %></option><% } %>
        </select>
      </label>
      <button type="submit">Speichern</button>
    </form>
  </details>
<% } else if (kannSelbstAlsKlassenlehrerEintragen) { %>
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/klassenlehrer/eintragen" class="inline">
    <button type="submit">Als Klassenleitung eintragen (alle Noten der Klasse sehen, Fächer zuordnen)</button>
  </form>
<% } %>

<h2>Schüler/innen (<%= schueler.length %>)</h2>
<% if (!klasse.ist_ablage || darfVerwalten) { %>
<div class="reiter unter-reiter" data-storage-key="klasse-<%= klasse.id %>-schueler-hinzufuegen">
  <button type="button" class="active" data-target="schueler-einzeln">Einzeln</button>
  <button type="button" data-target="schueler-mehrere">Mehrere auf einmal</button>
  <button type="button" data-target="schueler-csv">CSV-Import</button>
  <% if (ablagePersonen.length) { %>
    <button type="button" data-target="schueler-ablage">Aus „Ohne Klasse“ übernehmen (<%= ablagePersonen.length %>)</button>
  <% } %>
</div>

<div id="schueler-einzeln" class="reiter-panel unter-panel card active">
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/schueler/neu" class="inline">
    <input type="text" name="nachname" placeholder="Nachname" required>
    <input type="text" name="vorname" placeholder="Vorname" required>
    <button type="submit">+ Hinzufügen</button>
  </form>
</div>

<div id="schueler-mehrere" class="reiter-panel unter-panel card">
  <p class="hint">Eine Zeile je Person, Format: <code>Nachname, Vorname</code></p>
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/schueler/bulk">
    <textarea name="text" rows="6" placeholder="Müller, Anna
Schmidt, Bernd
Meier, Carla"></textarea>
    <button type="submit">Alle anlegen</button>
  </form>
</div>

<div id="schueler-csv" class="reiter-panel unter-panel card">
  <p class="hint">
    Erwartet eine Spalte für Nachname und eine für Vorname — mit Kopfzeile
    (z. B. „Nachname"/„Vorname" oder englisch „Name"/„Forename") oder
    ohne (dann werden die ersten beiden Spalten verwendet). Semikolon,
    Komma oder Tab als Trennzeichen werden automatisch erkannt (z. B. für
    eine von Hand aus Untis oder einer anderen Schulverwaltungssoftware
    exportierte Liste).
  </p>
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/schueler/csv" enctype="multipart/form-data">
    <input type="file" name="datei" accept=".csv,text/csv" required>
    <button type="submit">Datei importieren</button>
  </form>
</div>

<% if (ablagePersonen.length) { %>
<div id="schueler-ablage" class="reiter-panel unter-panel card">
  <p class="hint">
    Personen aus der Sammelklasse „Ohne Klasse“ (z. B. nach dem Löschen einer Klasse oder bei
    Wiederholern) auswählen und in diese Klasse übernehmen. Alle bisherigen Noten der Personen bleiben erhalten.
  </p>
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/schueler/aus-ablage">
    <label class="feld">Suche
      <input type="text" id="ablage-suche" placeholder="Name eingeben …" autocomplete="off">
    </label>
    <ul class="klasse-liste" id="ablage-liste">
      <% ablagePersonen.forEach(function(p) { %>
        <li data-name="<%= (p.nachname + ' ' + p.vorname).toLowerCase() %>">
          <label>
            <input type="checkbox" name="schueler_id" value="<%= p.id %>">
            <%= p.nachname %>, <%= p.vorname %> <small class="hint">(<%= p.schuljahr_bezeichnung %><%= p.status === 'abgang' ? ', Abgang' : '' %>)</small>
          </label>
        </li>
      <% }); %>
    </ul>
    <button type="submit">+ Ausgewählte übernehmen</button>
  </form>
  <script>
    (function() {
      var suche = document.getElementById('ablage-suche');
      var eintraege = document.querySelectorAll('#ablage-liste li');
      suche.addEventListener('input', function() {
        var q = suche.value.trim().toLowerCase();
        eintraege.forEach(function(li) { li.hidden = q !== '' && li.dataset.name.indexOf(q) === -1; });
      });
    })();
  </script>
</div>
<% } %>
<% } %>

<% var schuelerAktiv = schueler.filter(function(s) { return s.status !== 'abgang'; });
   var schuelerAbgang = schueler.filter(function(s) { return s.status === 'abgang'; }); %>
<table class="data">
  <thead><tr><th>Nachname</th><th>Vorname</th><% if (darfVerwalten || darfVersetzen) { %><th>Aktion</th><% } %></tr></thead>
  <tbody>
    <% schuelerAktiv.forEach(function(s) { %>
      <tr>
        <td><%= s.nachname %></td>
        <td><%= s.vorname %></td>
        <% if (darfVerwalten || darfVersetzen) { %>
        <td class="aktionen-zelle">
          <button type="button" class="aktionen-knopf" aria-haspopup="true" aria-expanded="false" aria-label="Aktionen für <%= s.vorname %> <%= s.nachname %>" title="Aktionen">
            <span class="drei-balken" aria-hidden="true"><span></span><span></span><span></span></span>
          </button>
          <div class="aktionen-inhalt" hidden>
            <% if (versetzZiele.length) { %>
              <button type="button" class="menue-eintrag" data-versetzen data-sid="<%= s.id %>" data-name="<%= s.vorname %> <%= s.nachname %>" title="In eine andere Klasse versetzen (Noten bleiben erhalten)">↔ Versetzen …</button>
            <% } %>
            <% if (darfVerwalten) { %>
              <form method="post" action="/teacher/schueler/<%= s.id %>/abgang" onsubmit="return confirm('Abgang aus der Klasse eintragen? Die Person zählt danach nicht mehr als aktuelle/r Schüler/in, alle bisherigen Noten bleiben aber erhalten.')">
                <button type="submit" class="menue-eintrag" name="zeugnis" value="0" title="Abgang aus der Klasse (Noten bleiben erhalten)">🚪 Abgang</button>
                <button type="submit" class="menue-eintrag" name="zeugnis" value="1" title="Abgang eintragen und direkt das Abgangszeugnis mit allen Noten erstellen">🚪🎓 Abgang + Abgangszeugnis</button>
              </form>
              <form method="post" action="/teacher/schueler/<%= s.id %>/loeschen" onsubmit="return confirm('Schüler/in komplett löschen? ALLE Noten gehen dabei unwiderruflich verloren. Für einen normalen Abgang stattdessen den Eintrag „🚪 Abgang“ nutzen.')">
                <button type="submit" class="menue-eintrag danger" title="Komplett löschen (Noten gehen verloren)">🗑 Löschen</button>
              </form>
            <% } %>
          </div>
        </td>
        <% } %>
      </tr>
    <% }); %>
  </tbody>
</table>

<% if (schuelerAbgang.length) { %>
  <details class="card">
    <summary>Ehemalige Schüler/innen (Abgang, <%= schuelerAbgang.length %>)</summary>
    <table class="data">
      <thead><tr><th>Nachname</th><th>Vorname</th><th>Abgang am</th><% if (darfVerwalten) { %><th>Aktion</th><% } %></tr></thead>
      <tbody>
        <% schuelerAbgang.forEach(function(s) { %>
          <tr>
            <td><%= s.nachname %></td>
            <td><%= s.vorname %></td>
            <td><%= s.abgang_am ? formatZeitLokal(s.abgang_am) : '–' %></td>
            <% if (darfVerwalten) { %>
            <td class="aktionen-zelle">
              <button type="button" class="aktionen-knopf" aria-haspopup="true" aria-expanded="false" aria-label="Aktionen für <%= s.vorname %> <%= s.nachname %>" title="Aktionen">
                <span class="drei-balken" aria-hidden="true"><span></span><span></span><span></span></span>
              </button>
              <div class="aktionen-inhalt" hidden>
                <a class="menue-eintrag" href="/teacher/schueler/<%= s.id %>/abgangszeugnis">🎓 Abgangszeugnis</a>
                <form method="post" action="/teacher/schueler/<%= s.id %>/reaktivieren">
                  <button type="submit" class="menue-eintrag" title="Abgang rückgängig machen">↩ Reaktivieren</button>
                </form>
                <form method="post" action="/teacher/schueler/<%= s.id %>/loeschen" onsubmit="return confirm('Schüler/in komplett löschen? ALLE Noten gehen dabei unwiderruflich verloren.')">
                  <button type="submit" class="menue-eintrag danger" title="Komplett löschen (Noten gehen verloren)">🗑 Löschen</button>
                </form>
              </div>
            </td>
            <% } %>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </details>
<% } %>

<div id="aktionen-popover" class="aktionen-popover" role="menu" hidden></div>

<% if (versetzZiele.length) { %>
<dialog id="versetzen-dialog" class="notiz-dialog">
  <form method="post" id="versetzen-form" action="">
    <h2>Versetzen: <span id="versetzen-name"></span></h2>
    <p class="hint">Alle bisherigen Noten bleiben der Person erhalten.</p>
    <label>Zielklasse
      <select name="ziel_klasse_id" required>
        <option value="">— Klasse wählen —</option>
        <% if (!klasse.ist_ablage) { %><option value="ohne-klasse">Ohne Klasse</option><% } %>
        <% versetzZiele.filter(function(z) { return !z.ist_ablage; }).forEach(function(z) { %>
          <option value="<%= z.id %>"><%= z.name %> (<%= z.schuljahr_bezeichnung %>)</option>
        <% }); %>
        <% versetzZiele.filter(function(z) { return z.ist_ablage; }).forEach(function(z) { %>
          <option value="<%= z.id %>"><%= z.name %> (<%= z.schuljahr_bezeichnung %>)</option>
        <% }); %>
      </select>
    </label>
    <div class="form-actions">
      <button type="submit">↔ Versetzen</button>
      <button type="button" id="versetzen-abbrechen">Abbrechen</button>
    </div>
  </form>
</dialog>
<% } %>

<script>
  // Aktionen je Person hinter den "drei Balken": ein gemeinsames Menü am Seitenende (wird
  // nicht von der scrollbaren Tabelle abgeschnitten); "Versetzen" öffnet einen Dialog.
  (function() {
    var pop = document.getElementById('aktionen-popover');
    var offen = null;
    function schliessen() {
      if (offen) { offen.setAttribute('aria-expanded', 'false'); offen = null; }
      pop.hidden = true; pop.textContent = '';
    }
    document.querySelectorAll('.aktionen-knopf').forEach(function(knopf) {
      knopf.addEventListener('click', function(e) {
        e.stopPropagation();
        if (offen === knopf) { schliessen(); return; }
        schliessen();
        var inhalt = knopf.parentElement.querySelector('.aktionen-inhalt');
        Array.from(inhalt.children).forEach(function(kind) { pop.appendChild(kind.cloneNode(true)); });
        pop.hidden = false;
        var r = knopf.getBoundingClientRect();
        var breite = pop.offsetWidth;
        pop.style.top = (window.scrollY + r.bottom + 4) + 'px';
        pop.style.left = Math.max(8, window.scrollX + Math.min(r.right - breite, document.documentElement.clientWidth - breite - 8)) + 'px';
        knopf.setAttribute('aria-expanded', 'true');
        offen = knopf;
        var erster = pop.querySelector('button, a'); if (erster) erster.focus();
      });
    });
    document.addEventListener('click', function(e) {
      var ziel = e.target.closest('[data-versetzen]');
      if (ziel) {
        var dlg = document.getElementById('versetzen-dialog');
        document.getElementById('versetzen-form').action = '/teacher/schueler/' + ziel.dataset.sid + '/versetzen';
        document.getElementById('versetzen-name').textContent = ziel.dataset.name;
        schliessen();
        dlg.showModal();
        return;
      }
      if (offen && !pop.contains(e.target)) schliessen();
    });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') schliessen(); });
    window.addEventListener('resize', schliessen);
    var abbrechen = document.getElementById('versetzen-abbrechen');
    if (abbrechen) abbrechen.addEventListener('click', function() { document.getElementById('versetzen-dialog').close(); });
  })();
</script>

<% if (!klasse.ist_ablage) { %>
<h2>Fächer</h2>
<p><small>Ein neu angelegtes Fach wird dir automatisch zugewiesen.
  <% if (istKlassenlehrer) { %>Als Klassenleitung kannst du unten weitere Lehrkräfte den Fächern zuordnen.
  <% } else { %>Weitere Lehrkräfte kann die Klassenleitung oder der Admin zuordnen.<% } %></small></p>
<% function hjBereiche(nummern) {
     var teile = []; var start = null; var vor = null;
     nummern.forEach(function(n) {
       if (start === null) { start = n; vor = n; }
       else if (n === vor + 1) { vor = n; }
       else { teile.push(start === vor ? start + '' : start + '–' + vor); start = n; vor = n; }
     });
     if (start !== null) teile.push(start === vor ? start + '' : start + '–' + vor);
     return teile.join(', ');
   } %>
<form method="post" action="/teacher/klassen/<%= klasse.id %>/faecher/neu" class="card">
  <label>Name des Fachs
    <input type="text" name="name" placeholder="z. B. Mathematik" required>
  </label>
  <fieldset class="hj-auswahl">
    <legend>Gilt in diesen Halbjahren</legend>
    <% laufzeit.halbjahre.forEach(function(h, i) { %>
      <label class="hj-check"><input type="checkbox" name="halbjahre" value="<%= i + 1 %>" <%= vorbelegungHj.indexOf(i + 1) !== -1 ? 'checked' : '' %>>
        <%= i + 1 %>. Halbjahr <small>(<%= laufzeit.schuljahre[Math.floor(i / 2)].bezeichnung %>)</small></label>
    <% }); %>
  </fieldset>
  <button type="submit">+ Fach anlegen</button>
</form>
<table class="data">
  <thead><tr><th>Name</th><th>Halbjahre</th><th>Lehrkräfte</th><% if (darfVerwalten) { %><th>Aktion</th><% } %></tr></thead>
  <tbody>
    <% faecher.forEach(function(f) { %>
      <tr>
        <td><a href="/teacher/fach/<%= f.id %>"><%= f.name %></a></td>
        <td>
          <details class="hj-bearbeiten">
            <summary><%= f.hjNummern.length === laufzeit.anzahlHalbjahre ? 'alle' : hjBereiche(f.hjNummern) %></summary>
            <form method="post" action="/teacher/faecher/<%= f.id %>/halbjahre">
              <input type="hidden" name="zurueck" value="klasse">
              <% laufzeit.halbjahre.forEach(function(h, i) { %>
                <label class="hj-check"><input type="checkbox" name="halbjahre" value="<%= i + 1 %>" <%= f.hjNummern.indexOf(i + 1) !== -1 ? 'checked' : '' %>> <%= i + 1 %></label>
              <% }); %>
              <button type="submit">Speichern</button>
            </form>
          </details>
        </td>
        <td><%= f.lehrer_liste || '—' %></td>
        <% if (darfVerwalten) { %>
        <td>
          <form method="post" action="/teacher/faecher/<%= f.id %>/loeschen" class="inline" onsubmit="return confirm('Fach löschen? Alle Noten dieses Fachs gehen dabei verloren.')">
            <button type="submit" class="danger">🗑</button>
          </form>
        </td>
        <% } %>
      </tr>
    <% }); %>
  </tbody>
</table>
<% } %>

<% if (istKlassenlehrer) { %>
  <h2>Lehrkräfte zuordnen</h2>
  <form method="post" action="/teacher/klassen/<%= klasse.id %>/zuweisungen/neu" class="card">
    <label>Lehrkraft
      <select name="user_id" required>
        <option value="">— wählen —</option>
        <% zuweisbareLehrkraefte.forEach(function(u) { %>
          <option value="<%= u.id %>"><%= u.display_name || u.username %></option>
        <% }); %>
      </select>
    </label>
    <label>Fach
      <select name="fach_id" required>
        <option value="">— wählen —</option>
        <% faecher.forEach(function(f) { %>
          <option value="<%= f.id %>"><%= f.name %></option>
        <% }); %>
      </select>
    </label>
    <button type="submit">+ Zuweisen</button>
  </form>
  <table class="data">
    <thead><tr><th>Lehrkraft</th><th>Fach</th><th>Aktion</th></tr></thead>
    <tbody>
      <% zuweisungen.forEach(function(z) { %>
        <tr>
          <td><%= z.display_name || z.username %></td>
          <td><%= z.fach_name %></td>
          <td>
            <form method="post" action="/teacher/zuweisungen/<%= z.id %>/loeschen" class="inline" onsubmit="return confirm('Zuweisung entfernen?')">
              <button type="submit" class="danger">🗑</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<script>
  // Register (Einzeln/Mehrere auf einmal/CSV-Import) umschalten, gewählter
  // Reiter bleibt über localStorage auch nach einem vollen Reload erhalten
  // (z. B. nach dem Anlegen eines Schülers oder einem CSV-Upload).
  document.querySelectorAll('.reiter').forEach(function(gruppe) {
    var buttons = Array.from(gruppe.querySelectorAll(':scope > button'));
    var storageKey = gruppe.dataset.storageKey;
    function setzeReiter(targetId) {
      buttons.forEach(function(b) {
        b.classList.toggle('active', b.dataset.target === targetId);
        var panel = document.getElementById(b.dataset.target);
        if (panel) panel.classList.toggle('active', b.dataset.target === targetId);
      });
    }
    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        setzeReiter(btn.dataset.target);
        if (storageKey) {
          try { localStorage.setItem(storageKey, btn.dataset.target); } catch (e) { /* z. B. privater Modus */ }
        }
      });
    });
    if (storageKey) {
      try {
        var gemerkterReiter = localStorage.getItem(storageKey);
        if (gemerkterReiter && document.getElementById(gemerkterReiter)) setzeReiter(gemerkterReiter);
      } catch (e) { /* z. B. privater Modus */ }
    }
  });
</script>
